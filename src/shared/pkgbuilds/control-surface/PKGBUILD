# Maintainer: smplOS <https://github.com/smpl-os>
# Device-triggered keypad and Razer mouse remappers; see KEYPAD.md
# and UPDATING.md.
#
# Source, CI and releases live in smpl-os/smpl-apps (control-surface/). Every
# smpl-apps release publishes control-surface-<version>-x86_64.tar.gz, a usr/
# tree built and tested (ctest) there. Update OS and ISO builds resolve the
# latest release AND its published SHA256 together using
# smplos-control-surface.sh. Values below are an offline bootstrap snapshot,
# not an OTA version pin. Never rewrite pkgver without its matching digest.
#
# smplOS ships the user unit and udev rules itself
# (src/shared/configs/systemd/user/control-surface.service,
#  src/shared/system/udev/70-smplos-keypads.rules and 70-smplos-mice.rules);
# the release's own copies
# stay in /usr/share/control-surface/examples.

pkgname=control-surface
pkgver=0.8.37
pkgrel=1
pkgdesc='CH552 keypad and Razer mouse remappers: per-app profiles, shared actions, Kdenlive API and guided mouse setup'
arch=(x86_64)
url='https://github.com/smpl-os/smpl-apps/tree/main/control-surface'
license=('GPL-2.0-or-later' 'CC-BY-SA-3.0')
depends=(gcc-libs glibc qt6-base systemd-libs)
optdepends=(
  'wchisp: flash open firmware from Settings > Keypad'
  'kdenlive: Kdenlive API plugin (enable its control-surface interface)'
)
options=(!strip !debug)
source=("https://github.com/smpl-os/smpl-apps/releases/download/v${pkgver}/control-surface-${pkgver}-x86_64.tar.gz")
sha256sums=('a25410ab6ca2e84f85020c51fbd0cdf6635d1e033961bccd0a96545c936a316b')

check() {
  # Verify the release's real runtime ABI before pacman can install it.
  local daemon home="$srcdir/input-runtime-home"
  mkdir -p "$home"
  for daemon in control-surfaced mouse-remapperd; do
    env HOME="$home" XDG_CONFIG_HOME="$home/config" XDG_STATE_HOME="$home/state" \
      XDG_CACHE_HOME="$home/cache" "$srcdir/usr/bin/$daemon" features --json >/dev/null || return
  done
  rmdir "$home"
}

package() {
  [[ -x "$srcdir/usr/bin/mouse-remapperd" ]] ||
    { echo "mouse-remapperd is missing from the native release" >&2; return 1; }
  # smplOS's control-surface.service passes --eww-window/--eww-config
  # (cheatsheet push); refuse a daemon without them (Qt keeps it as UTF-16).
  LC_ALL=C grep -aqP 'e\x00w\x00w\x00-\x00w\x00i\x00n\x00d\x00o\x00w\x00' "$srcdir/usr/bin/control-surfaced" ||
    { echo "control-surfaced is too old for smplOS's unit (needs --eww-window)" >&2; return 1; }
  cp -a --no-preserve=ownership "$srcdir/usr" "$pkgdir/"
}

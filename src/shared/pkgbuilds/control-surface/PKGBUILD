# Maintainer: smplOS <https://github.com/smpl-os>
# The keypad app (control-surfaced) for supported macro keypads; see KEYPAD.md
# and src/shared/keypads/registry.json.
#
# Source, CI and releases live in smpl-os/smpl-apps (control-surface/). Every
# smpl-apps release publishes control-surface-<version>-x86_64.tar.gz, a usr/
# tree built and tested (ctest) there. This package installs one pinned
# release: to update, set pkgver to a newer smpl-apps release, update
# sha256sums, and add a migration that reruns the keypad migration's package
# step. No _gh_owner/_gh_repo on purpose: build-iso.sh would move pkgver to
# the latest release, which the pinned checksum would not match.
#
# smplOS ships the user unit and udev rules itself
# (src/shared/configs/systemd/user/control-surface.service,
#  src/shared/system/udev/70-smplos-keypads.rules); the release's own copies
# stay in /usr/share/control-surface/examples.

pkgname=control-surface
pkgver=0.8.27
pkgrel=1
pkgdesc='Keypad app for CH552 macro keypads: per-app profiles, cheatsheet, Kdenlive API plugin, open firmware images'
arch=(x86_64)
url='https://github.com/smpl-os/smpl-apps/tree/main/control-surface'
license=('GPL-2.0-or-later' 'CC-BY-SA-3.0')
depends=(gcc-libs glibc qt6-base systemd-libs)
optdepends=(
  'wchisp: flash open firmware from Settings > Keypad'
  'kdenlive: Kdenlive API plugin (enable its control-surface interface)'
)
options=(!strip !debug)
source=("https://github.com/smpl-os/smpl-apps/releases/download/v${pkgver}/control-surface-${pkgver}-x86_64.tar.gz")
sha256sums=('7e2858801bd132430ac3957c3969e083a19f4e43688187aef713e8a7890ab675')

package() {
  # smplOS's control-surface.service passes --eww-window/--eww-config
  # (cheatsheet push); refuse a daemon without them (Qt keeps it as UTF-16).
  LC_ALL=C grep -aqP 'e\x00w\x00w\x00-\x00w\x00i\x00n\x00d\x00o\x00w\x00' "$srcdir/usr/bin/control-surfaced" ||
    { echo "control-surfaced is too old for smplOS's unit (needs --eww-window)" >&2; return 1; }
  cp -a --no-preserve=ownership "$srcdir/usr" "$pkgdir/"
}

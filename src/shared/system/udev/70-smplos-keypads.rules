# Generated by src/shared/keypads/gen.py from registry.json: do not edit. See KEYPAD.md.
#
# Supported keypads (a working backend):
# - uaccess: the seated user's backend reads the keypad (usb, hidraw, evdev)
#   without the input group; Settings > Keypad reads it too.
# - TAG+="systemd" + SYSTEMD_ALIAS: the user manager tracks "a supported keypad
#   is present" as smplos-keypad.device (systemd-escape --path --suffix=device /smplos/keypad).
# - SYSTEMD_USER_WANTS: plug-in starts the backend's user service; its
#   BindsTo= on that device unit stops it on unplug. Nothing runs without one.
# Planned keypads (no backend yet) get nothing: no access, no service, no icon.
# Matches these VID:PIDs only; other keyboards are never touched.

# CH552 macro keypads (ch552-macropad): control-surface
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1189", ATTR{idProduct}=="8890", TAG+="uaccess", TAG+="systemd", ENV{SYSTEMD_ALIAS}="/smplos/keypad", ENV{SYSTEMD_USER_WANTS}+="control-surface.service"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1189", ATTRS{idProduct}=="8890", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="1189", ATTRS{idProduct}=="8890", TAG+="uaccess"

# The backend types mapped shortcuts through one virtual keyboard (uinput),
# the grant the Steam and xr-workspace rules use.
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"

# Planned, no backend yet: Elgato Stream Deck (0fd9:0060, 0fd9:006d, 0fd9:0080, 0fd9:0063, 0fd9:0090, 0fd9:006c, 0fd9:008f, 0fd9:0084, 0fd9:009a, 0fd9:0086).

# Firmware update mode (ROM bootloaders): the seated user may flash a keypad
# with wchisp. keypad-ctl only ever runs `wchisp info` and `wchisp flash`.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="4348", ATTR{idProduct}=="55e0", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1a86", ATTR{idProduct}=="55e0", TAG+="uaccess"

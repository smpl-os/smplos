#!/bin/bash
# smplos-os-update — Update smplOS system files via git
#
# Pulls the latest smplOS repo, syncs scripts to /usr/local/bin/,
# and runs pending migrations.
#
# The smplOS repo is cloned to ~/.local/share/smplos/ during installation.
# This script pulls updates and deploys them.
#
# Usage: smplos-os-update [options]
#   --check     Only report whether an update is available
#   --quiet     Suppress per-file output
#   --scripts   Only sync scripts (skip migrations)
#   --migrate   Only run migrations (skip git pull + script sync)
#   --deploy    Deploy the already-bootstrapped checkout without pulling again

set -euo pipefail
SMPLOS_UPDATE_PROTOCOL=1

# ── Restore invoker context if running under pkexec/sudo ─────────────────────
# Under pkexec, $HOME is /root and every $HOME-relative path (SMPLOS_PATH,
# migration markers, ~/.config/hypr, ~/.local/share/smplos/repo) points at
# an empty dir — the git pull silently no-ops and the whole update evaporates.
# Restore invoker context so paths resolve to the actual user's home.
# The wrapper (smplos-update) sets SMPLOS_INVOKER_* for us; when this script
# is invoked directly under sudo/pkexec, we derive them here as a fallback.
if [[ $EUID -eq 0 && -z "${SMPLOS_INVOKER_HOME:-}" ]]; then
    _invoker_uid="${PKEXEC_UID:-${SUDO_UID:-}}"
    if [[ -n "${_invoker_uid:-}" && "$_invoker_uid" != "0" ]]; then
        _invoker_ent="$(getent passwd "$_invoker_uid" 2>/dev/null || true)"
        if [[ -n "$_invoker_ent" ]]; then
            export SMPLOS_INVOKER_UID="$_invoker_uid"
            export SMPLOS_INVOKER_USER="$(cut -d: -f1 <<<"$_invoker_ent")"
            export SMPLOS_INVOKER_HOME="$(cut -d: -f6 <<<"$_invoker_ent")"
            export HOME="$SMPLOS_INVOKER_HOME"
            export USER="$SMPLOS_INVOKER_USER"
            export LOGNAME="$SMPLOS_INVOKER_USER"
        fi
    fi
    unset _invoker_uid _invoker_ent
fi

SMPLOS_PATH="${SMPLOS_PATH:-$HOME/.local/share/smplos}"
SMPLOS_REPO="$SMPLOS_PATH/repo"
SMPLOS_REPO_URL="https://github.com/smpl-os/smplos.git"

# ── Session env helper ───────────────────────────────────────────────────────
# We run as root under pkexec, which strips XDG_RUNTIME_DIR, WAYLAND_DISPLAY
# and HYPRLAND_INSTANCE_SIGNATURE. Anything that talks to the user's live
# session (hyprctl, eww, systemctl --user) must be routed back into it.
# Prefer the repo copy — it is always at least as new as the installed one.
for _cand in "$SMPLOS_REPO/src/shared/lib/smplos-session-env.sh" \
             "/usr/local/lib/smplos/smplos-session-env.sh"; do
    if [[ -r "$_cand" ]]; then
        # shellcheck source=../lib/smplos-session-env.sh
        source "$_cand"
        break
    fi
done
unset _cand
if ! declare -F smplos_have_hyprland >/dev/null 2>&1; then
    smplos_have_session()  { return 1; }
    smplos_have_hyprland() { return 1; }
    smplos_have_user_bus() { return 1; }
    smplos_run_as_user()   { return 1; }
fi

# ── Run a command as the invoking user when we're root ───────────────────────
# git operations against the user-owned smplOS repo must NOT run as root:
# (a) git 2.35.2+ rejects with "unsafe repository" for cross-uid access, and
# (b) any file git writes as root breaks the user's future `git pull` attempts.
# smplos-migrate similarly writes marker files under $HOME/.local/state/smplos
# that must stay user-owned so the user can clear them without sudo.
# Use runuser (util-linux, always present on Arch) which cleanly drops privs
# without a password prompt.
as_invoker() {
    if [[ $EUID -eq 0 && -n "${SMPLOS_INVOKER_USER:-}" ]]; then
        runuser -u "$SMPLOS_INVOKER_USER" -- "$@"
    else
        "$@"
    fi
}

# Resolve our own path so we can re-exec into the freshly-installed copy after
# sync_scripts, breaking the bootstrap chicken-and-egg where a run started
# from the OLD /usr/local/bin/smplos-os-update would keep executing the old
# in-memory code even after installing its own replacement. Without this,
# users always needed to run smplos-os-update TWICE to actually benefit from
# any fix to smplos-os-update itself — a chronic source of "the fix does not
# take" reports.
SELF_PATH="$(readlink -f "$0" 2>/dev/null || echo "$0")"
SELF_CANONICAL="/usr/local/bin/smplos-os-update"

# ── Argument parsing ──────────────────────────────────────────────────────────
CHECK_ONLY=0; QUIET=0; SCRIPTS_ONLY=0; MIGRATE_ONLY=0; DEPLOY_ONLY=0; FINALIZE_ONLY=0
CORE_ONLY=0; OPTIONAL_ONLY=0
# Internal flag: set by self-reexec to prevent infinite loops if the newly
# installed script somehow still detects itself as outdated.
SELF_UPDATED="${SMPLOS_OS_UPDATE_RESUMED:-0}"
case "$SELF_UPDATED:${SMPLOS_OS_HAD_UPDATES:-0}" in
    0:0|0:1|1:0|1:1) ;;
    *) echo "ERROR: invalid updater resume flags" >&2; exit 1 ;;
esac
while [[ $# -gt 0 ]]; do
    case "$1" in
        --check)     CHECK_ONLY=1 ;;
        --quiet)     QUIET=1 ;;
        --scripts)   SCRIPTS_ONLY=1 ;;
        --migrate)   MIGRATE_ONLY=1 ;;
        --deploy)    DEPLOY_ONLY=1 ;;
        --core)      CORE_ONLY=1 ;;
        --optional)  OPTIONAL_ONLY=1 ;;
        --finalize)  FINALIZE_ONLY=1 ;;
        -h|--help)
            echo "Usage: smplos-os-update [--check | --quiet | --scripts | --migrate | --deploy [--core] | --optional]"
            exit 0 ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
    shift
done

# ── Helpers ───────────────────────────────────────────────────────────────────
log()    { [[ $QUIET -eq 0 ]] && echo "  $*" || true; }
ok()     { [[ $QUIET -eq 0 ]] && echo "  ✓ $*" || true; }
warn()   { echo "  ⚠ $*" >&2; }
header() { [[ $QUIET -eq 0 ]] && echo "$*" || true; }
die()    { echo "ERROR: $*" >&2; exit 1; }

# ── Ensure repo exists ───────────────────────────────────────────────────────
ensure_repo() {
    if [[ ! -d "$SMPLOS_REPO/.git" ]]; then
        log "First run: cloning smplOS repo..."
        # Clone as the invoker so the repo stays user-owned (see as_invoker).
        as_invoker mkdir -p "$(dirname "$SMPLOS_REPO")"
        as_invoker git clone --depth=1 "$SMPLOS_REPO_URL" "$SMPLOS_REPO" 2>/dev/null \
            || die "Failed to clone smplOS repo"
        ok "Repo cloned to $SMPLOS_REPO"
    fi
}

# ── Git pull ──────────────────────────────────────────────────────────────────
# Never discard local work to make an update appear successful.
pull_updates() {
    header "── smplOS System Files ──"

    ensure_repo

    local repo="$SMPLOS_REPO"
    local before after remote_head branch

    before=$(as_invoker git -C "$repo" rev-parse HEAD 2>/dev/null || echo "unknown")

    # 1) Refuse to run against a repo that isn't ours. Prevents a misconfigured
    #    SMPLOS_REPO from pulling arbitrary upstream code onto the system.
    local remote_url
    remote_url=$(as_invoker git -C "$repo" remote get-url origin 2>/dev/null || echo "")
    case "$remote_url" in
        https://github.com/smpl-os/smplos|https://github.com/smpl-os/smplos.git|git@github.com:smpl-os/smplos.git) ;;
        *) die "Unexpected smplOS origin: $remote_url" ;;
    esac

    if [[ -d "$repo/.git/rebase-merge" || -d "$repo/.git/rebase-apply" ]]; then
        die "Unfinished rebase in $repo; resolve or back it up before updating."
    fi
    branch=$(as_invoker git -C "$repo" symbolic-ref --short HEAD 2>/dev/null || echo "")
    if [[ "$branch" != "main" ]]; then
        die "Repo is on '${branch:-detached HEAD}', not main; preserve local work and select main before updating."
    fi
    [[ -z "$(as_invoker git -C "$repo" status --porcelain)" ]] \
        || die "Local changes in $repo; back them up or commit them before updating."

    # 3) Fetch. Any network/auth error here MUST surface — this is the single
    #    most common silent-failure point that leaves us stuck on a stale HEAD.
    log "Fetching origin/main..."
    if ! as_invoker git -C "$repo" fetch --prune origin main 2>&1 | while read -r l; do log "  $l"; done; then
        die "git fetch failed for $repo (network? auth? disk?)"
    fi

    remote_head=$(as_invoker git -C "$repo" rev-parse origin/main 2>/dev/null || echo "")
    [[ -n "$remote_head" ]] || die "origin/main missing in $repo after fetch"

    # 4) Already at tip? Great, done.
    if [[ "$before" == "$remote_head" ]]; then
        ok "Already up to date ($(as_invoker git -C "$repo" describe --tags --always 2>/dev/null || echo "$before"))"
        return 1
    fi

    log "Local: $(as_invoker git -C "$repo" rev-parse --short HEAD)  Remote: $(as_invoker git -C "$repo" rev-parse --short origin/main)"
    if ! as_invoker git -C "$repo" merge --ff-only "$remote_head" 2>&1 | while read -r l; do log "  $l"; done; then
        die "Cannot fast-forward $repo; local commits were preserved. Resolve divergence before updating."
    fi

    after=$(as_invoker git -C "$repo" rev-parse HEAD 2>/dev/null || echo "unknown")

    # 7) Final invariant check: HEAD MUST equal origin/main. If not, refuse
    #    to continue — deploying from a still-stale checkout is exactly the
    #    "update did nothing" bug we're trying to eliminate.
    if [[ "$after" != "$remote_head" ]]; then
        die "Post-pull HEAD ($after) != origin/main ($remote_head) — refusing to deploy stale checkout"
    fi

    local n_changes
    n_changes=$(as_invoker git -C "$repo" diff --stat "$before" "$after" 2>/dev/null | tail -1 || echo "")
    [[ -n "$n_changes" ]] && log "$n_changes"
    ok "Advanced $before → $after"
    return 0
}

# ── Check only ────────────────────────────────────────────────────────────────
check_updates() {
    ensure_repo

    # Same discipline as pull_updates: don't swallow errors, and ensure we
    # compare against the actual current origin/main rather than a stale
    # remote-tracking ref that hasn't been fetched since last week.
    if ! as_invoker git -C "$SMPLOS_REPO" fetch --prune origin main 2>&1 | while read -r l; do log "  $l"; done; then
        warn "Cannot reach GitHub"; exit 1
    fi

    local local_head remote_head
    local_head=$(as_invoker git -C "$SMPLOS_REPO" rev-parse HEAD)
    remote_head=$(as_invoker git -C "$SMPLOS_REPO" rev-parse origin/main 2>/dev/null || echo "")

    if [[ -z "$remote_head" || "$local_head" == "$remote_head" ]]; then
        echo "  smplOS is up to date"
        exit 1
    else
        local behind
        behind=$(as_invoker git -C "$SMPLOS_REPO" rev-list --count "HEAD..origin/main" 2>/dev/null || echo "?")
        echo "  smplOS update available ($behind new commits)"
        exit 0
    fi
}

# ── Sync scripts to /usr/local/bin/ ───────────────────────────────────────────
sync_scripts() {
    local bin_dir="$SMPLOS_REPO/src/shared/bin"
    [[ -d "$bin_dir" ]] || die "No scripts directory found at $bin_dir"

    header ""
    header "── Syncing scripts ──"

    local smplos_bin="$HOME/.local/share/smplos/bin"
    mkdir -p "$smplos_bin"

    local n_updated=0 n_total=0
    for script in "$bin_dir"/*; do
        [[ -f "$script" ]] || continue
        local name dest
        name=$(basename "$script")
        dest="/usr/local/bin/$name"

        ((n_total++)) || true

        # Only copy if changed (compare against the system copy)
        if [[ -x "$dest" ]] && cmp -s "$script" "$dest"; then
            continue
        fi

        if install_system_file "$script" "$dest" 755; then
            ((n_updated++)) || true
        else
            die "Failed to install $name"
        fi
        # Single-copy invariant: do NOT mirror into ~/.local/share/smplos/bin.
        # Historically we did — the intent was "user-local wins on PATH so a
        # broken sudo path still updates" — but the effect was to seed the
        # exact shadow-copy mess this script now spends its life cleaning up.
        # Any pre-existing shadow gets scrubbed by cleanup_shadow_bins() below.
    done

    if [[ $n_updated -gt 0 ]]; then
        ok "$n_updated of $n_total scripts updated"
    else
        ok "All $n_total scripts are current"
    fi

    sync_libs
}

# ── Sync sourceable shell libraries to /usr/local/lib/smplos/ ─────────────────
# These are libraries, not commands: they must NOT land in /usr/local/bin (they
# are not executable and cleanup_shadow_bins reasons about bin/ entries).
sync_libs() {
    local lib_dir="$SMPLOS_REPO/src/shared/lib"
    [[ -d "$lib_dir" ]] || die "No shared library directory found at $lib_dir"

    local dest_dir="/usr/local/lib/smplos"
    sudo install -d -m755 -- "$dest_dir" || die "Could not prepare readable library directory $dest_dir"

    local lib name n_updated=0
    for lib in "$lib_dir"/*.sh "$lib_dir"/*.py; do
        [[ -f "$lib" ]] || continue
        name=$(basename "$lib")
        if [[ -f "$dest_dir/$name" ]] && cmp -s "$lib" "$dest_dir/$name"; then
            continue
        fi
        if install_system_file "$lib" "$dest_dir/$name" 644; then
            ((n_updated++)) || true
        else
            die "Failed to install lib $name"
        fi
    done

    [[ $n_updated -gt 0 ]] && ok "$n_updated shell librar(ies) updated"
    return 0
}

install_system_file() {
    local source="$1" destination="$2" mode="$3" temporary status operation=install
    temporary=$(sudo mktemp "${destination}.XXXXXX") || {
        status=$?
        printf 'ERROR: temporary-file creation failed for %s (exit %s)\n' "$destination" "$status" >&2
        return "$status"
    }
    if sudo install -m"$mode" "$source" "$temporary" &&
        operation=publish &&
        sudo mv -f -- "$temporary" "$destination" &&
        operation=verify &&
        cmp -- "$source" "$destination"; then
        return 0
    else
        status=$?
    fi
    printf 'ERROR: %s failed for %s (source %s, exit %s)\n' \
        "$operation" "$destination" "$source" "$status" >&2
    sudo rm -f -- "$temporary" ||
        printf 'ERROR: could not remove failed-install temporary file %s\n' "$temporary" >&2
    return "$status"
}

# ── Sync config files to ~/.config/ ───────────────────────────────────────────
copy_user_config() {
    local source="$1" destination="$2" temporary
    temporary=$(as_invoker mktemp "${destination}.XXXXXX")
    if as_invoker install -m644 "$source" "$temporary" \
        && as_invoker mv -f "$temporary" "$destination"; then
        return 0
    fi
    as_invoker rm -f -- "$temporary"
    die "Could not update config: $destination"
}

sync_configs() {
    header ""
    header "── Syncing configs ──"

    local n_updated=0

    # EWW configs (eww.yuck, eww.scss, scripts/)
    local eww_src="$SMPLOS_REPO/src/shared/eww"
    local eww_dst="$HOME/.config/eww"
    if [[ -d "$eww_src" ]]; then
        as_invoker mkdir -p "$eww_dst"
        as_invoker touch "$eww_dst/.smplos-reload.lock"
        exec 8<"$eww_dst/.smplos-reload.lock" || die "Cannot open EWW publication lock"
        flock 8 || die "Cannot lock EWW publication"
        # Publish included fragments before the entry point so live reloads
        # never see an include that has not reached disk yet.
        local source f
        for source in "$eww_src"/*.yuck "$eww_src"/*.scss; do
            f="${source##*/}"
            case "$f" in eww.yuck|eww.scss|theme-colors.*) continue ;; esac
            if [[ -f "$eww_src/$f" ]] && ! cmp -s "$eww_src/$f" "$eww_dst/$f" 2>/dev/null; then
                copy_user_config "$eww_src/$f" "$eww_dst/$f"
                ((n_updated++)) || true
            fi
        done
        # Sync scripts directory
        if [[ -d "$eww_src/scripts" ]]; then
            as_invoker mkdir -p "$eww_dst/scripts"
            for script in "$eww_src/scripts/"*; do
                [[ -f "$script" ]] || continue
                local name
                name=$(basename "$script")
                if [[ ! -x "$eww_dst/scripts/$name" ]] || ! cmp -s "$script" "$eww_dst/scripts/$name" 2>/dev/null; then
                    copy_user_config "$script" "$eww_dst/scripts/$name"
                    as_invoker chmod +x "$eww_dst/scripts/$name"
                    ((n_updated++)) || true
                fi
            done
        fi
        for f in eww.scss eww.yuck; do
            if ! cmp -s "$eww_src/$f" "$eww_dst/$f"; then
                copy_user_config "$eww_src/$f" "$eww_dst/$f"
                ((n_updated++)) || true
            fi
        done
        flock -u 8 || die "Cannot unlock EWW publication"
        exec 8<&-
    fi

    # smplOS fonts (keypad cheatsheet icons; EWW draws them by family name)
    local fonts_src="$SMPLOS_REPO/src/shared/fonts" fonts_dst="$HOME/.local/share/fonts/smplos"
    local font fonts_changed=0
    for font in "$fonts_src/"*.ttf "$fonts_src/keypad-icons/LICENSE-tabler-icons.txt"; do
        [[ -f "$font" ]] || continue
        if ! cmp -s "$font" "$fonts_dst/$(basename "$font")" 2>/dev/null; then
            as_invoker mkdir -p "$fonts_dst"
            copy_user_config "$font" "$fonts_dst/$(basename "$font")"
            fonts_changed=1
            ((n_updated++)) || true
        fi
    done
    if [[ $fonts_changed -eq 1 ]]; then
        as_invoker fc-cache -f "$fonts_dst" >/dev/null 2>&1 || true
    fi

    sync_config_defaults core
    [[ ${CORE_ONLY:-0} -eq 1 ]] || sync_config_defaults optional

    if [[ $n_updated -gt 0 ]]; then
        ok "$n_updated config file(s) updated"
    else
        ok "All configs are current"
    fi
}

sync_config_defaults() {
    local phase="$1" configs_src="$SMPLOS_REPO/src/shared/configs"
    local src_file rel_path priority destination
    [[ -d "$configs_src" ]] || return 0
    while IFS= read -r -d '' src_file; do
        rel_path="${src_file#$configs_src/}"
        [[ "$rel_path" != smplos/* ]] || continue
        priority=core
        case "$rel_path" in
            Code/*|Code-OSS/*|VSCodium/*|Cursor/*|nvim/*|btop/*|foot/*|brave*|chromium*) priority=optional ;;
        esac
        [[ "$priority" == "$phase" ]] || continue
        destination="$HOME/.config/$rel_path"
        [[ ! -e "$destination" && ! -L "$destination" ]] || continue
        as_invoker mkdir -p "$(dirname "$destination")" &&
            as_invoker install -m644 "$src_file" "$destination" || {
                warn "Could not install $phase config default: $destination"
                return 1
            }
    done < <(find "$configs_src" -type f -print0)
}

# ── Sync themes to ~/.local/share/smplos/themes/ ─────────────────────────────
# Stock theme files (colors.toml, nemo.css, eww-colors.scss, etc.) are read by
# theme-set from $STOCK_THEMES_PATH ($HOME/.local/share/smplos/themes). They are
# stamped into the installed system from the ISO and otherwise never updated,
# which means CSS fixes (e.g. nemo submenu rendering) shipped via the repo never
# reach existing installs. Matching personal overrides are reset after verified
# backups; custom-only theme names are never touched.
replace_theme_tree() {
    local source="$1" destination="$2" name="$3"
    local parent="${destination%/*}" stage previous backup=""
    stage=$(mktemp -d "$parent/.$name.update.XXXXXX") || die "Cannot stage theme $name"
    previous="$stage.previous"
    if ! cp -a -- "$source/." "$stage/" ||
        ! diff -rq --no-dereference -- "$source" "$stage"; then
        die "Cannot verify staged theme $name; existing theme is unchanged; staging: $stage"
    fi
    if [[ -e "$destination" || -L "$destination" ]]; then
        local backup_root="${XDG_STATE_HOME:-$HOME/.local/state}/smplos/theme-backups"
        mkdir -p "$backup_root" || die "Cannot create theme backup directory"
        backup=$(mktemp -d "$backup_root/$name.XXXXXX") || die "Cannot back up theme $name"
        if ! cp -a -- "$destination" "$backup/original" ||
            ! diff -rq --no-dereference -- "$destination" "$backup/original"; then
            die "Cannot verify theme backup $backup; existing theme is unchanged"
        fi
        printf '%s\n' "$destination" > "$backup/path" || die "Cannot record theme backup path"
        mv -T -- "$destination" "$previous" || die "Cannot move old theme $destination"
    fi
    if ! mv -T -- "$stage" "$destination"; then
        if [[ -e "$previous" || -L "$previous" ]]; then
            mv -T -- "$previous" "$destination" ||
                die "Cannot restore theme $destination; old theme: $previous; backup: $backup"
        fi
        die "Cannot publish theme $name; previous theme restored"
    fi
    if [[ -e "$previous" || -L "$previous" ]]; then
        if ! rm -rf -- "$previous"; then
            warn "Theme replaced; protected old files retained at $previous; verified backup: $backup"
        fi
        ok "Theme backup: $backup"
    fi
}

sync_themes() {
    local themes_src="$SMPLOS_REPO/src/shared/themes"
    local themes_dst="$HOME/.local/share/smplos/themes"
    local user_themes="$HOME/.config/smplos/themes"
    [[ -d "$themes_src" ]] || die "No themes directory found at $themes_src"

    header ""
    header "── Syncing themes ──"

    mkdir -p "$themes_dst" "$HOME/.config/smplos/current" || die "Cannot create theme directories"
    local theme_lock
    exec {theme_lock}>"$HOME/.config/smplos/current/.theme-set.lock" || die "Cannot open theme lock"
    flock "$theme_lock" || die "Cannot lock theme state"

    local n_updated=0 n_total=0
    for theme_dir in "$themes_src"/*/; do
        [[ -d "$theme_dir" ]] || continue
        local theme_name
        theme_name=$(basename "$theme_dir")
        # Skip _templates and any other private dirs starting with _
        [[ "$theme_name" == _* ]] && continue
        ((n_total++)) || true

        local dst changed=0 targets=("$themes_dst/$theme_name")
        if [[ -e "$user_themes/$theme_name" || -L "$user_themes/$theme_name" ]]; then
            targets+=("$user_themes/$theme_name")
        fi
        for dst in "${targets[@]}"; do
            if [[ -L "$dst" || ! -d "$dst" ]] ||
                ! diff -rq --no-dereference -- "$theme_dir" "$dst" >/dev/null; then
                replace_theme_tree "${theme_dir%/}" "$dst" "$theme_name"
                changed=1
            fi
        done
        ((n_updated+=changed)) || true
    done
    flock -u "$theme_lock" || die "Cannot unlock theme state"
    exec {theme_lock}>&-

    if [[ $n_updated -gt 0 ]]; then
        ok "$n_updated of $n_total themes updated"
        THEMES_CHANGED=1
    else
        ok "All $n_total themes are current"
    fi
}

# ── Fetch + install latest binaries from every smpl-os org repo ──────────────
sync_apps() {
    local fetch_script="$SMPLOS_REPO/src/fetch-org.sh"
    [[ -f "$fetch_script" ]] || { warn "fetch-org.sh not found"; return; }

    header ""
    header "── Updating smpl-os apps ──"

    source "$SMPLOS_REPO/src/shared/lib/smplos-app-bundle.sh"
    bash "$fetch_script"

    local stage="$SMPLOS_REPO/.cache/org-binaries"
    local n_bin=0
    # Report which applications need reopening without closing user work.
    UPDATED_APP_BINS=()

    # Executables → /usr/local/bin/
    if [[ -d "$stage/bin" ]]; then
        local src dest name
        for src in "$stage"/bin/*; do
            [[ -f "$src" ]] || continue
            name="$(basename "$src")"
            [[ "$name" != smpl-calendar-alertd.service ]] || continue
            dest="/usr/local/bin/$name"
            if [[ ! -f "$dest" ]] || ! cmp -s "$src" "$dest"; then
                if smplos_install_app_binary "$src" "$dest"; then
                    ((n_bin++)) || true
                    UPDATED_APP_BINS+=("$name")
                else
                    die "Failed to install $name; retry Update OS"
                fi
            fi

            # ── Single-copy invariant ────────────────────────────────────
            # Guarantee ONE canonical binary on the system: /usr/local/bin/$name.
            # Any file at a PATH location that comes BEFORE /usr/local/bin on
            # the effective shell PATH will silently override it — Eww, tray
            # buttons, keybindings, and toggle-scripts using bare `$name` all
            # then launch the OLD binary and the "I updated but nothing changed"
            # trap fires again.
            #
            # We MUST also scrub ~/.local/share/smplos/bin/, even though that
            # dir is normally meant to hold sync_scripts output (bash scripts).
            # Eww inherits its PATH from smplos-start-session, which prepends
            # ~/.local/share/smplos/bin, so any binary that landed there via a
            # historical `deploy-local.sh` cp (or manual copy) silently takes
            # priority over every sync_apps install to /usr/local/bin. This is
            # exactly how ~/.local/share/smplos/bin/smpl-calendar ended up
            # stuck at v0.7.4 while /usr/local/bin was at v0.8.11 — Eww
            # launched the March binary and users saw "the fix did not take".
            #
            # Policy: if a shadow exists and differs, delete it. If it exists
            # and is identical, leave it alone. Non-destructive for devs:
            # deploy-local.sh should install to /usr/local/bin (via sudo)
            # rather than dropping into user-writable PATH dirs.
            local shadow
            for shadow in \
                "$HOME/.local/share/smplos/bin/$name" \
                "$HOME/.local/bin/$name" \
                "$HOME/bin/$name"
            do
                [[ -e "$shadow" || -L "$shadow" ]] || continue
                if [[ -L "$shadow" ]]; then
                    local target
                    target=$(readlink -f "$shadow" 2>/dev/null || echo "")
                    if [[ "$target" == "$dest" ]]; then
                        continue
                    fi
                    rm -f "$shadow" 2>/dev/null && \
                        warn "  removed stale symlink shadow: $shadow -> $target"
                elif cmp -s "$shadow" "$dest" 2>/dev/null; then
                    continue
                else
                    rm -f "$shadow" 2>/dev/null && \
                        warn "  removed stale shadow binary: $shadow (was overriding $dest on \$PATH)"
                fi
            done
        done
        if [[ -f "$stage/bin/smpl-calendar-alertd.service" ]]; then
            smplos_install_calendar_service "$stage/bin/smpl-calendar-alertd.service" \
                || die "Failed to install calendar reminder service; retry Update OS"
        fi
    fi

    # NOTE: compositor plugins (*.so) are intentionally NOT downloaded here.
    # They are ABI-locked to the exact hyprland build, so sync_plugins compiles
    # them locally against the Hyprland that is installed on this machine.

    if [[ $n_bin -gt 0 ]]; then
        ok "$n_bin app binary/binaries updated"
        # App releases move independently of OS commits.
        APPS_CHANGED=1
    else
        ok "smpl-os apps already current"
    fi
}

# ── Sync compositor plugins ───────────────────────────────────────────────────
# A Hyprland plugin only loads into the exact Hyprland build it was compiled
# against. It is therefore compiled HERE against the Hyprland installed right
# now rather than downloaded: a binary built elsewhere could never be
# guaranteed to match this machine's hyprland package. smplos-plugins keeps
# the build for the running compositor until it restarts; if a build fails,
# windows simply keep their stock borders until the next successful update.
sync_plugins() {
    local src="$SMPLOS_REPO/src/compositors/hyprland/plugins"
    local tool="$SMPLOS_REPO/src/shared/bin/smplos-plugins"
    [[ -d "$src" && -f "$tool" ]] || return 0
    command -v hyprctl >/dev/null 2>&1 || return 0

    header ""
    header "── Syncing compositor plugins ──"

    local run=(bash "$tool" sync --src "$src")
    if [[ $EUID -ne 0 ]]; then
        # Swap a rebuilt plugin into the running compositor, reaching the
        # desktop session even from a bare tty. An elevated legacy run has no
        # session of its own; post_deploy loads the plugin for it instead.
        run+=(--reload)
        if smplos_have_hyprland; then
            run=(smplos_run_as_user "${run[@]}")
        fi
    fi

    local status=0
    if [[ $QUIET -eq 1 ]]; then
        "${run[@]}" >/dev/null || status=$?
    else
        "${run[@]}" || status=$?
    fi
    if [[ $status -eq 0 ]]; then
        ok "Compositor plugins are current"
    else
        warn "Compositor plugins could not be built; windows keep their stock borders. Run Update OS again to retry."
    fi
    return 0
}

# ── Run migrations ────────────────────────────────────────────────────────────
run_migrations() {
    if command -v smplos-migrate &>/dev/null; then
        header ""
        header "── Migrations ──"
        # Run as the invoker so:
        #  (a) migration marker files under ~/.local/state/smplos/migrations/
        #      stay user-owned (else the user can never clear them without sudo),
        #  (b) migrations touching ~/.config/*, WAYLAND_DISPLAY-scoped tools
        #      (hyprctl, systemctl --user), and other user-context work run
        #      in the right context.
        # Migrations that legitimately need root should `sudo` internally.
        if [[ $EUID -eq 0 && -n "${SMPLOS_INVOKER_USER:-}" ]]; then
            runuser -u "$SMPLOS_INVOKER_USER" -- env SMPLOS_PATH="$SMPLOS_PATH" smplos-migrate --phase "${1:-all}"
        else
            SMPLOS_PATH="$SMPLOS_PATH" smplos-migrate --phase "${1:-all}"
        fi
    fi
}

# ── Sync smplOS version ───────────────────────────────────────────────────────
sync_version() {
    local version_file="$SMPLOS_REPO/src/VERSION"
    local template="$SMPLOS_REPO/src/shared/system/os-release"
    [[ -s "$version_file" && -f "$template" ]] || {
        warn "Missing OS version or os-release template"; return 1;
    }
    local new_ver current_ver destination temporary status=0
    new_ver=$(tr -d '[:space:]' < "$version_file") || return 1
    [[ -n "$new_ver" ]] || { warn "OS version is empty"; return 1; }
    current_ver=$(sed -n 's/^VERSION_ID=//p' /etc/os-release | tr -d '"') || return 1
    [[ "$current_ver" != "$new_ver" ]] || return 0
    # Preserve the distribution's os-release symlink, replacing its target.
    destination=$(readlink -f /etc/os-release) || return 1
    temporary=$(mktemp) || return 1
    if ! sed "s/@BUILD_VERSION@/${new_ver}/g" "$template" > "$temporary" ||
        ! install_system_file "$temporary" "$destination" 644; then
        warn "Failed to update /etc/os-release"
        status=1
    else
        ok "smplOS version: $current_ver -> $new_ver"
    fi
    rm -f -- "$temporary"
    return "$status"
}

# ── Sync Hyprland compositor configs ─────────────────────────────────────────
# Syncs every .conf and .lua file from the repo's hypr directory into
# ~/.config/hypr, skipping files that are user-generated or tool-written.
# This automatically picks up new files added to the repo without needing
# a hardcoded list — same model as sync_scripts.
sync_hypr_configs() {
    local hypr_repo="$SMPLOS_REPO/src/compositors/hyprland/hypr"
    local hypr_dst="$HOME/.config/hypr"
    [[ -d "$hypr_repo" ]] || return 0

    header ""
    header "── Syncing Hyprland configs ──"

    # Files owned by the user or generated by smplOS tools at runtime.
    # These hold per-machine state; hypridle is bootstrapped only when absent.
    local protected=(
        monitors.conf           # written by Settings → Display
        pointer.conf            # written by Settings → Mouse
        hypridle.conf           # written by Settings → Power / user
        bindings.conf           # written by Settings → Keyboard / user
        messenger-bindings.conf # generated by generate-messenger-bindings
        theme.conf              # generated by theme-set (colors)
        hyprlock-theme.conf     # generated by theme-set
    )

    _is_protected() {
        local name="$1"
        for p in "${protected[@]}"; do
            [[ "$name" == "$p" ]] && return 0
        done
        return 1
    }

    as_invoker mkdir -p "$hypr_dst"
    local n_updated=0 n_new=0 n_total=0

    _sync_hypr_file() {
        local src="$1" dst="$2" protect="${3:-true}" name
        [[ -f "$src" ]] || return 0
        name=$(basename "$src")
        if [[ "$protect" == true ]] && _is_protected "$name"; then
            if [[ "$name" != hypridle.conf || -e "$dst" || -L "$dst" ]]; then
                return 0
            fi
            command -v smplos-hypr-dpms &>/dev/null \
                || die "Cannot bootstrap idle config: smplos-hypr-dpms was not installed."
            # Record before publication so an interrupted update retries the
            # daemon restart, rather than assuming Hyprland reload applies it.
            as_invoker mkdir -p "$HOME/.local/state/smplos"
            as_invoker touch "$HOME/.local/state/smplos/hypridle-apply-pending"
        fi
        ((n_total++)) || true
        if [[ ! -f "$dst" ]]; then
            copy_user_config "$src" "$dst"
            ((n_new++)) || true
            log "  + $name (new)"
        elif ! cmp -s "$src" "$dst"; then
            copy_user_config "$src" "$dst"
            ((n_updated++)) || true
        fi
    }

    # Modules must exist before a new entry point can require them.
    local entrypoints=()
    for src in "$hypr_repo"/*.conf "$hypr_repo"/*.lua; do
        case "${src##*/}" in
            hyprland.conf|hyprland.lua) entrypoints+=("$src") ;;
            *) _sync_hypr_file "$src" "$hypr_dst/${src##*/}" ;;
        esac
    done

    # apps/ subdirectory — all files, none protected
    if [[ -d "$hypr_repo/apps" ]]; then
        as_invoker mkdir -p "$hypr_dst/apps"
        for src in "$hypr_repo/apps"/*; do
            _sync_hypr_file "$src" "$hypr_dst/apps/${src##*/}" false
        done
    fi
    for src in "${entrypoints[@]}"; do
        _sync_hypr_file "$src" "$hypr_dst/${src##*/}"
    done

    if [[ $((n_new + n_updated)) -gt 0 ]]; then
        ok "$n_updated config(s) updated, $n_new new config(s) synced ($n_total total)"
        # Signal to main() that Hyprland must be reloaded even if the git pull
        # was a no-op (e.g. previous run pulled but crashed before reload, or
        # ~/.config/hypr drifted from repo and this sync restored it).
        HYPR_CONFIGS_CHANGED=1
    else
        ok "All $n_total Hyprland configs are current"
    fi
}

# ── Sync OS-owned systemd user units ────────────────────────────────────────
# smplos-session.target activates graphical-session.target, which the
# session's services (hypridle power timers, dictation, XR watcher) are
# WantedBy. Without it they only ran after something restarted them and
# stopped after every reboot. Installed on every update so existing machines
# get it, then started in a running Hyprland session right away; at login
# smplos-session-services starts it.
sync_user_units() {
    local unit_src="$SMPLOS_REPO/src/shared/configs/systemd/user"
    local unit_dst="$HOME/.config/systemd/user"
    local units=(smplos-session.target) unit changed=0
    [[ -d "$unit_src" ]] || return 0

    as_invoker mkdir -p "$unit_dst"
    for unit in "${units[@]}"; do
        [[ -f "$unit_src/$unit" ]] || continue
        if ! cmp -s "$unit_src/$unit" "$unit_dst/$unit" 2>/dev/null; then
            copy_user_config "$unit_src/$unit" "$unit_dst/$unit"
            changed=1
        fi
    done
    [[ $changed -eq 1 ]] && log "  + session services target installed"

    if smplos_have_hyprland; then
        if [[ $changed -eq 1 ]]; then
            smplos_run_as_user systemctl --user daemon-reload || return 1
        fi
        if smplos_run_as_user systemctl --user start smplos-session.target; then
            # Stops and reports services that cannot run instead of letting
            # them restart-loop until the next login.
            smplos_run_as_user smplos-session-services --verify \
                || { warn "Some session services are not running; see ~/.cache/smplos/session-services.log"; return 1; }
        else
            warn "Could not start session services now; they start at the next login."
            return 1
        fi
    fi
}

sync_keypad_support() {
    local migration="$SMPLOS_REPO/migrations/20261009-010000-keypad-login-recovery.sh"
    if as_invoker bash "$migration"; then
        return 0
    else
        warn "Keypad integration is incomplete; resolve the reported error and retry Update OS."
        return 1
    fi
}

# Run even without new commits: older Settings releases can reintroduce direct
# dispatcher syntax after a one-shot migration has already completed.
sync_hypridle_config() {
    local migration="$SMPLOS_REPO/migrations/20260930-120000-preserve-idle-preferences.sh"
    if as_invoker bash "$migration"; then
        return 0
    else
        local status=$?
        if [[ $status -eq 75 ]]; then
            warn "Idle configuration application remains pending; retry Update OS in a managed Hyprland session."
            return 0
        fi
        die "Idle configuration application failed; resolve the error above and retry Update OS."
    fi
}

# ── Cleanup shadow binaries on PATH ───────────────────────────────────────────
# Delegates to the standalone smplos-check-shadows script so exactly one
# enforcement implementation lives in the tree — deploy-local.sh, this
# update pass, and any future install path all invoke the same audit +
# clean logic.
cleanup_shadow_bins() {
    header ""
    header "── Scrubbing shadow \$PATH binaries ──"

    if command -v smplos-check-shadows &>/dev/null; then
        # --clean removes duplicates; the subsequent --audit exits non-zero
        # if anything slipped past cleanup (permission denied, race, etc.)
        # so the update cannot claim success while launching stale code.
        if ! smplos-check-shadows --clean; then
            warn "Shadow cleanup failed; inspect smplos-check-shadows"
            return 1
        fi
        if ! smplos-check-shadows --audit --quiet; then
            warn "Shadow duplicates persist after clean — check manually with smplos-check-shadows"
            return 1
        fi
    else
        warn "smplos-check-shadows not installed; cannot verify launched code"
        return 1
    fi
}

# ── Post-deploy hooks ─────────────────────────────────────────────────────────

# Kill any running instance of a smpl-os app whose binary we just replaced,
# so the user's NEXT interaction (tray click, keybinding) respawns from the
# fresh binary. Without this, popup apps that were already running when the
# update installed a new binary keep serving stale UI/logic from the resident
# copy in memory — the "I updated but the fix didn't take" trap that's bitten
# us on every release. SIGTERM is safe: these are ephemeral popups; if the
# binary was launched from a stale shadow path (e.g. ~/.local/bin) we surface
# that too so the user knows why the update wouldn't stick.
restart_updated_apps() {
    [[ ${#UPDATED_APP_BINS[@]} -eq 0 ]] && return 0

    local name canonical shadow shadow_paths=("$HOME/.local/bin" "$HOME/bin")
    local killed=0 shadowed=()

    for name in "${UPDATED_APP_BINS[@]}"; do
        canonical="/usr/local/bin/$name"

        # Warn about shadow copies BEFORE killing — restarting a shadowed app
        # would just relaunch the stale binary and the user would still not
        # see the fix. This is the dev-machine "deploy-local.sh installed to
        # ~/.local/bin and now $PATH prefers it forever" trap.
        for sp in "${shadow_paths[@]}"; do
            shadow="$sp/$name"
            if [[ -f "$shadow" ]] && ! cmp -s "$canonical" "$shadow" 2>/dev/null; then
                shadowed+=("$shadow")
            fi
        done

        # Match the exact resolved binary path, not just process name — a
        # random script called "smpl-calendar" shouldn't get killed. -f/-a
        # matches the full command line; we scope it to /usr/local/bin/NAME
        # and any known shadow paths so we catch every instance of the app
        # that we actually shipped.
        local pids
        pids=$(pgrep -f "(/usr/local/bin/${name}|/\.local/bin/${name}|/home/[^ /]+/bin/${name})( |$)" 2>/dev/null || true)
        if [[ -n "$pids" ]]; then
            # shellcheck disable=SC2086
            kill -TERM $pids 2>/dev/null || true
            ((killed++)) || true
            log "  restarted: $name (pid $(echo "$pids" | tr '\n' ' '))"
        fi
    done

    if [[ $killed -gt 0 ]]; then
        ok "$killed running app(s) sent SIGTERM — next launch uses the new binary"
    fi

    if [[ ${#shadowed[@]} -gt 0 ]]; then
        warn "Shadow binaries detected (these override /usr/local/bin on \$PATH):"
        for shadow in "${shadowed[@]}"; do
            warn "  $shadow  <- will keep serving OLD code until you delete or refresh it"
        done
        warn "  Fix: rm the shadow copies, or run deploy-local.sh to rebuild them from source."
    fi
}

post_deploy() {
    local failed=0
    if [[ "${SMPLOS_UPDATE_APP_OWNER:-0}" != 1 ]]; then
        sync_version || failed=1
    fi

    local current_theme
    current_theme=$(theme-current 2>/dev/null || echo "catppuccin")
    local theme_args=()
    [[ ${CORE_ONLY:-0} -ne 1 ]] || theme_args+=(--core)
    log "Reapplying theme ($current_theme)..."
    # Running theme-set as root leaves current/theme undeletable by the user,
    # so later switches update only theme.name and keep deploying the old colors.
    if smplos_have_session; then
        smplos_run_as_user theme-set "${theme_args[@]}" "$current_theme" || failed=1
        smplos_run_as_user bar-ctl ensure || failed=1
    else
        as_invoker theme-set "${theme_args[@]}" "$current_theme" || failed=1
        log "No graphical session; bar verification deferred until login."
    fi

    if [[ ${#UPDATED_APP_BINS[@]} -gt 0 ]]; then
        warn "Updated binaries: ${UPDATED_APP_BINS[*]}"
        warn "Close and reopen affected apps to use the new code. Log out/in for background daemons; running apps were not stopped."
    fi

    if hyprctl version &>/dev/null 2>&1; then
        log "Reloading Hyprland config..."
        hyprctl reload || failed=1
    elif smplos_have_hyprland; then
        # We're root under pkexec with a stripped environment, so the bare
        # `hyprctl version` probe above always failed with
        # "HYPRLAND_INSTANCE_SIGNATURE not set!" and this reload never ran.
        # Route it back into the invoker's session instead.
        log "Reloading Hyprland config..."
        smplos_run_as_user hyprctl reload || failed=1
    fi

    # Plugins normally load from the session's autostart. A session that began
    # before the plugin existed gets it now (a no-op when it is already loaded).
    # A missing plugin only costs the HUD frames, so this never fails the update.
    local plugins_tool="$SMPLOS_REPO/src/shared/bin/smplos-plugins"
    if [[ -f "$plugins_tool" ]]; then
        if hyprctl version &>/dev/null; then
            bash "$plugins_tool" load || warn "Compositor plugin did not load; see: smplos-plugins status"
        elif smplos_have_hyprland; then
            smplos_run_as_user bash "$plugins_tool" load || warn "Compositor plugin did not load; see: smplos-plugins status"
        fi
    fi
    return "$failed"
}

# ── Main ──────────────────────────────────────────────────────────────────────
if [[ -r "$SMPLOS_REPO/src/shared/lib/smplos-update-entry.sh" ]]; then
    source "$SMPLOS_REPO/src/shared/lib/smplos-update-entry.sh"
    smplos_update_entry_guard "$SMPLOS_REPO"
fi
if [[ $CHECK_ONLY -eq 1 ]]; then
    check_updates
    exit $?
fi

if [[ $MIGRATE_ONLY -eq 1 ]]; then
    run_migrations
    exit 0
fi
if [[ $FINALIZE_ONLY -eq 1 ]]; then
    sync_version
    exit $?
fi
if [[ ${OPTIONAL_ONLY:-0} -eq 1 ]]; then
    [[ -d "$SMPLOS_REPO/.git" ]] || die "No bootstrapped checkout at $SMPLOS_REPO"
    optional_failed=0
    sync_config_defaults optional || optional_failed=1
    run_migrations optional || optional_failed=1
    as_invoker theme-set --apps || optional_failed=1
    as_invoker rebuild-app-cache || optional_failed=1
    [[ $optional_failed -eq 0 ]] || die "Optional app configuration/migrations remain pending; see errors above."
    exit 0
fi

had_updates="${SMPLOS_OS_HAD_UPDATES:-0}"
HYPR_CONFIGS_CHANGED=0
THEMES_CHANGED=0
APPS_CHANGED=0
# Populated by sync_apps with the basename of every binary it just replaced,
# reported by post_deploy. Declared here so nounset
# doesn't trip when sync_apps is skipped (e.g. --scripts) or is a no-op.
UPDATED_APP_BINS=()
if [[ $DEPLOY_ONLY -eq 1 ]]; then
    [[ -d "$SMPLOS_REPO/.git" ]] || die "No bootstrapped checkout at $SMPLOS_REPO"
    had_updates=1
elif pull_updates; then
    had_updates=1
fi

# Snapshot the canonical smplos-os-update BEFORE sync_scripts overwrites it.
# We compare hashes after the sync to decide whether to re-exec into the
# fresh copy. The previous cmp-based check compared SELF_PATH to
# SELF_CANONICAL directly, which is broken when the script is invoked as
# /usr/local/bin/smplos-os-update — both paths point at the same file, so
# `cmp` always returned equal and the re-exec NEVER fired for the common
# case. Hash-before-vs-after is the only way to detect an in-place replace.
_pre_sync_hash=""
[[ -f "$SELF_CANONICAL" ]] && \
    _pre_sync_hash=$(sha256sum "$SELF_CANONICAL" 2>/dev/null | cut -d' ' -f1)

if [[ $SCRIPTS_ONLY -eq 0 ]]; then
    [[ $DEPLOY_ONLY -eq 1 ]] || sync_scripts

    # ── Self-reexec if this script just got updated ──────────────────────
    # If we were launched from the old /usr/local/bin/smplos-os-update and
    # sync_scripts just installed a newer copy on top, keep running the OLD
    # in-memory logic would defeat the point — every subsequent sync_apps,
    # sync_hypr_configs, cleanup_shadow_bins improvement would only take
    # effect on the NEXT invocation, and this is exactly how buggy older
    # code (e.g. a cleanup pass that used to nuke user symlinks
    # unconditionally) kept running against a supposedly-updated system.
    # We use a hash-before/after check because when SELF_PATH ==
    # SELF_CANONICAL (script invoked via the canonical path), cmp on the
    # same path is always trivially equal.
    _post_sync_hash=""
    [[ -f "$SELF_CANONICAL" ]] && \
        _post_sync_hash=$(sha256sum "$SELF_CANONICAL" 2>/dev/null | cut -d' ' -f1)

    if [[ "$SELF_UPDATED" != "1" ]] && [[ -x "$SELF_CANONICAL" ]] \
        && [[ -n "$_pre_sync_hash" && -n "$_post_sync_hash" ]] \
        && [[ "$_pre_sync_hash" != "$_post_sync_hash" ]]; then
        header ""
        warn "smplos-os-update itself was refreshed — re-executing to pick up new logic"
        # Preserve --quiet/--scripts intent so behavior is identical to the
        # original invocation. --scripts already returned above so we only
        # forward --quiet here.
        reexec_args=()
        [[ $QUIET -eq 1 ]] && reexec_args+=(--quiet)
        export SMPLOS_OS_UPDATE_RESUMED=1
        export SMPLOS_OS_HAD_UPDATES="$had_updates"
        exec "$SELF_CANONICAL" "${reexec_args[@]}"
    fi

    sync_configs
    sync_themes
    if [[ "${SMPLOS_UPDATE_APP_OWNER:-0}" != 1 ]]; then
        sync_apps
    fi
    sync_hypr_configs
    sync_plugins
    migrations_failed=0
    migration_phase=all
    [[ ${CORE_ONLY:-0} -ne 1 ]] || migration_phase=core
    run_migrations "$migration_phase" || migrations_failed=1
    # Reconcile even when migrations were already marked done. Verify only
    # after units and the published keypad package have been delivered.
    sync_keypad_support || migrations_failed=1
    sync_user_units || migrations_failed=1
    sync_hypridle_config || migrations_failed=1

    # Unconditional shadow-binary sweep. Runs AFTER sync_apps so we've already
    # deposited the fresh canonical /usr/local/bin/<foo> before deciding whether
    # its shadow is stale. Costs a few hundred stat calls; the payoff is that
    # dev-machine deploy-local.sh drops, hand-copied binaries, and any prior
    # broken update-apps runs all get healed on every OS update.
    cleanup_shadow_bins || migrations_failed=1

    # A failed finalization must retry even if its files were already copied.
    header ""
    header "── Post-deploy ──"
    post_deploy || migrations_failed=1
    [[ $migrations_failed -eq 0 ]] || die "Some deployment steps failed; desktop reconciliation was attempted. Resolve the reported errors and retry Update OS."
fi

if [[ $SCRIPTS_ONLY -eq 1 ]]; then
    sync_scripts
fi

# Script-only updates can change index semantics without any new app binaries.
rebuild-app-cache || die "App cache refresh failed"
ok "App cache rebuilt"

header ""
ok "smplOS system update complete"

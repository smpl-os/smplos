#!/bin/bash
# Expose GTK3's bundled dark variant under its desktop-settings theme name.
set -euo pipefail

die() { echo "smplos-gtk-theme-compat: $*" >&2; exit 1; }

data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
[[ "$data_home" == /* ]] || die "XDG_DATA_HOME must be absolute"
roots=("$data_home/themes" "$HOME/.themes")
IFS=: read -ra data_dirs <<< "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
for directory in "${data_dirs[@]}"; do
  [[ "$directory" == /* ]] && roots+=("$directory/themes")
done
for directory in "${roots[@]}"; do
  existing="$directory/Adwaita-dark/gtk-3.0/gtk.css"
  if [[ -e "$existing" || -L "$existing" ]]; then
    [[ -r "$existing" ]] || die "Existing dark theme is unreadable: $existing"
    exit 0
  fi
done

resource=/org/gtk/libgtk/theme/Adwaita/gtk-dark.css
gresource list /usr/lib/libgtk-3.so.0 | grep -Fx "$resource" >/dev/null \
  || die "GTK3's bundled Adwaita dark stylesheet is unavailable"
destination="$data_home/themes/Adwaita-dark/gtk-3.0/gtk.css"
mkdir -p -- "${destination%/*}"
temporary=$(mktemp "$destination.XXXXXX")
trap 'rm -f -- "$temporary"' EXIT
printf '@import url("resource://%s");\n' "$resource" > "$temporary"
chmod 644 "$temporary"
ln -- "$temporary" "$destination" || die "Cannot publish dark theme without overwriting an existing file"

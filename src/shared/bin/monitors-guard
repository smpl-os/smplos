#!/bin/bash
# smplOS Monitors Config Sanity Guard
#
# Runs from Hyprland autostart BEFORE the compositor picks up
# monitors.conf. Prevents boot-to-black-screen when the file has been
# corrupted (every `monitor = NAME, ...` line replaced with
# `monitor = NAME, disable`).
#
# HOW WE GOT HERE:
#   An older revision of screen-recover had a "step 4" that intentionally
#   wrote a disabled version of monitors.conf, reloaded, then restored
#   the original. That approach had two failure modes that could leave
#   monitors.conf permanently disabled:
#     * concurrent invocations racing on the file
#     * script interruption (kill, session end, reboot) between
#       "write disabled" and "restore original"
#   Both bit the user on 2026-07-24/25 — boot straight into black
#   screen, only recoverable by dropping to TTY and hand-editing.
#
#   screen-recover no longer does that (Hyprland 0.56.0 shipped the
#   upstream fix so it isn't needed), but the corrupted file might
#   still be around from an older run — and this guard is cheap
#   insurance against any future bug that could produce the same state.
#
# WHAT IT DOES:
#   1. If monitors.conf doesn't exist -> exit 0 (Hyprland will pick
#      preferred defaults, safe).
#   2. Rules are read with hyprlang's rules: `#` starts a comment, `##` is a
#      literal `#`, `disable` and `disabled` both disable, and the last
#      definition of a selector wins. Standalone `transform`/`addreserved`
#      lines modify a rule and are not rules themselves.
#   3. If at least one rule enables a display -> exit 0, everything's fine.
#   4. If EVERY rule disables a display, the file is corrupt only when no
#      connected display (from /sys/class/drm) would still light up through
#      the enabled catch-all. Disabling just the laptop panel while an
#      external display stays connected is an intentional choice and is
#      kept. Disabling via `desc:` or the catch-all cannot be checked before
#      Hyprland starts, so those all-disabled files are treated as corrupt.
#      Roll back a corrupt file:
#        a. Look for the most recent monitors.conf.bak-* backup.
#        b. If found, restore it and log.
#        c. If not found, delete monitors.conf entirely so Hyprland
#           falls back to preferred defaults. Better a shuffled layout
#           than a black screen.
#      Log everything to ~/.cache/smplos/monitors-guard.log for
#      post-mortem.
#
# Idempotent, always exits 0 so autostart isn't blocked.

set +e

CONF="$HOME/.config/hypr/monitors.conf"
LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/smplos"
mkdir -p "$LOG_DIR" 2>/dev/null
LOG="$LOG_DIR/monitors-guard.log"
log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S.%3N')" "$*" >> "$LOG"; }

# Cap log at 100KB
if [[ -f "$LOG" ]] && [[ $(stat -c%s "$LOG" 2>/dev/null || echo 0) -gt 102400 ]]; then
    tail -c 51200 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi

# Tests point this at a fake connector tree.
DRM_SYSFS="${SMPLOS_DRM_SYSFS:-/sys/class/drm}"

# Prints "<rules> <disabled> <unverifiable> <connector disabled by name>..."
analyze() {
    awk '
    function trim(s) { gsub(/^[ \t\r]+|[ \t\r]+$/, "", s); return s }
    # hyprlang: "#" starts a comment, "##" is a literal "#", and the search
    # resumes two characters after an escape.
    function strip_comment(s,    pos, resume, rest) {
        s = trim(s)
        if (substr(s, 1, 1) == "#") return ""
        pos = index(s, "#")
        while (pos > 0) {
            if (substr(s, pos + 1, 1) == "#") {
                resume = pos + 2
                s = substr(s, 1, pos) substr(s, pos + 2)
                rest = substr(s, resume)
                pos = index(rest, "#")
                if (pos > 0) pos += resume - 1
            } else {
                s = substr(s, 1, pos - 1)
                break
            }
        }
        return trim(s)
    }
    {
        line = strip_comment($0)
        if (line !~ /^monitor[ \t]*=/) next
        sub(/^monitor[ \t]*=/, "", line)
        n = split(line, f, ",")
        sel = trim(f[1])
        action = n >= 2 ? trim(f[2]) : ""
        if (action == "transform" || action == "addreserved") next
        if (!(sel in state)) order[++count] = sel
        state[sel] = (action == "disable" || action == "disabled") ? "off" : "on"
    }
    END {
        off = 0; unverifiable = 0; names = ""
        for (i = 1; i <= count; i++) {
            sel = order[i]
            if (state[sel] != "off") continue
            off++
            if (sel == "" || sel ~ /^desc:/) unverifiable = 1
            else names = names " " sel
        }
        printf "%d %d %d%s\n", count, off, unverifiable, names
    }' "$1" 2>/dev/null
}

connected_connectors() {
    local status name
    for status in "$DRM_SYSFS"/card*-*/status; do
        [[ -r "$status" && "$(<"$status")" == connected ]] || continue
        name=${status%/status}
        name=${name##*/}
        printf '%s\n' "${name#card*-}"
    done
}

# Succeeds when the file would leave no connected display enabled.
all_disabled() {
    local total disabled unverifiable names name
    read -r total disabled unverifiable names <<<"$(analyze "$1")"
    [[ "${total:-0}" -gt 0 && "${total:-0}" -eq "${disabled:-0}" ]] || return 1
    [[ "${unverifiable:-0}" -eq 0 ]] || return 0
    local -A off=()
    for name in $names; do off[$name]=1; done
    while IFS= read -r name; do
        [[ -n "$name" && -z "${off[$name]:-}" ]] && return 1
    done < <(connected_connectors)
    return 0
}

[[ -f "$CONF" ]] || { log "no monitors.conf — Hyprland will use preferred defaults"; exit 0; }

read -r total disabled _ <<<"$(analyze "$CONF")"
total=${total:-0}
disabled=${disabled:-0}

if [[ "$total" -eq 0 ]]; then
    log "monitors.conf has zero monitor rules — nothing to check"
    exit 0
fi

if all_disabled "$CONF"; then
    log "CORRUPT monitors.conf detected: $total/$total rules disable a display and no connected display stays on"
    log "  file dump:"
    sed 's/^/    /' "$CONF" >> "$LOG"

    # Try the most recent user-side backup first, then our own
    # last-known-good snapshot.
    for cand in \
        $(ls -1t "$HOME/.config/hypr/monitors.conf.bak-"* 2>/dev/null) \
        "$HOME/.config/hypr/monitors.conf.last-known-good"; do
        [[ -n "$cand" && -f "$cand" ]] || continue
        # Sanity: don't restore an also-corrupt backup.
        read -r bak_total _ <<<"$(analyze "$cand")"
        if [[ "${bak_total:-0}" -gt 0 ]] && ! all_disabled "$cand"; then
            cp "$cand" "$CONF" && log "  restored from backup: $cand"
            exit 0
        else
            log "  candidate $cand is also unusable, skipping"
        fi
    done

    # No usable backup. Move the corrupt file out of the way and let
    # Hyprland use preferred defaults. Preserves the corrupt file for
    # forensics but doesn't let it break the login.
    mv "$CONF" "$CONF.corrupt-$(date +%s)" 2>/dev/null \
        && log "  no usable backup; moved corrupt file aside so Hyprland uses preferred defaults" \
        || log "  no usable backup and could not move file — Hyprland will still boot to black"
    exit 0
fi

# All good — some/all monitors are real entries.
if [[ "$disabled" -gt 0 ]]; then
    log "OK: $((total - disabled))/$total rules enable a display ($disabled disabled)"
else
    log "OK: all $total rules enable a display"
fi

# Snapshot this valid state as last-known-good so the next boot after a
# corruption has something to restore from. Atomic write via temp+mv.
LKG="$HOME/.config/hypr/monitors.conf.last-known-good"
if cp "$CONF" "$LKG.tmp" 2>/dev/null && mv "$LKG.tmp" "$LKG" 2>/dev/null; then
    log "  snapshotted -> $LKG"
fi
exit 0

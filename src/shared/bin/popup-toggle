#!/bin/bash
# smplOS Popup Toggle -- opens one bar popup, closes all others
# Usage: popup-toggle <window-name>    Open/toggle a popup
#        popup-toggle --close          Close all popups
#
# Features:
#   - Mutual exclusion: only one popup visible at a time
#   - Works on both Wayland and X11 (no compositor-specific code)

BAR_CTL="${BAR_CTL:-bar-ctl}"

# All known popup windows (add new popups here)
POPUPS=(calendar-popup notification-hub usb-popup workspace-overview)

compact_calendar_running() {
  local binary
  binary=$(command -v smpl-calendar 2>/dev/null || true)
  [[ -n "$binary" ]] && pgrep -f "^${binary}$" >/dev/null 2>&1
}

notification_center_running() {
  pgrep -x notif-center >/dev/null 2>&1
}

close_start_menu() {
  toggle-start-menu --hide
}

close_resident_popups() {
  local except="${1:-}"
  if [[ "$except" != calendar-popup ]] && compact_calendar_running; then
    toggle-calendar
  fi
  if [[ "$except" != notification-hub ]] && notification_center_running; then
    toggle-notif-center
  fi
  if [[ "$except" != start-menu ]]; then
    close_start_menu
  fi
}

close_native_all() {
  rm -f -- "${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/smplos/native-popup.active"
  "$BAR_CTL" close-popups
  if compact_calendar_running; then
    toggle-calendar
  fi
  if notification_center_running; then
    toggle-notif-center
  fi
}

native_popup() {
  local target="${1:-}"
  local state_dir="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/smplos"
  local state="$state_dir/native-popup.active"
  if [[ "$target" == "--close" ]]; then
    close_native_all
    return
  fi
  case "$target" in
    quick-settings)
      native_open_or_close "$target" quick-settings "$state"
      ;;
    usb-popup)
      native_open_or_close "$target" usb "$state"
      ;;
    workspace-overview)
      native_open_or_close "$target" workspace-overview "$state"
      ;;
    start-menu)
      rm -f -- "$state"
      "$BAR_CTL" close-popups
      close_resident_popups start-menu
      toggle-start-menu
      ;;
    notification-hub)
      rm -f -- "$state"
      "$BAR_CTL" close-popups
      close_resident_popups notification-hub
      toggle-notif-center
      ;;
    calendar-popup)
      rm -f -- "$state"
      "$BAR_CTL" close-popups
      close_resident_popups calendar-popup
      toggle-calendar
      ;;
    *)
      echo "popup-toggle: unsupported popup '$target'" >&2
      return 1
      ;;
  esac
}

native_open_or_close() {
  local target="$1" command="$2" state="$3" current=""
  [[ ! -f "$state" ]] || current=$(<"$state")
  if [[ "$current" == "$target" ]]; then
    "$BAR_CTL" close-popups
    rm -f -- "$state"
  else
    close_resident_popups "$target"
    "$BAR_CTL" close-popups
    "$BAR_CTL" popup "$command" || return
    mkdir -p "${state%/*}" || return
    printf '%s\n' "$target" > "$state"
  fi
}

# Every visible popup is native or an external resident smpl-app.
native_popup "${1:-}"

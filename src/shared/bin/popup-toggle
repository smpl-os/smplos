#!/bin/bash
# smplOS Popup Toggle -- opens one EWW popup, closes all others
# Usage: popup-toggle <window-name>    Open/toggle a popup
#        popup-toggle --close          Close all popups
#
# Features:
#   - Mutual exclusion: only one popup visible at a time
#   - Works on both Wayland and X11 (no compositor-specific code)

EWW="eww --config $HOME/.config/eww"

# All known popup windows (add new popups here)
POPUPS=(calendar-popup quick-settings notification-hub usb-popup workspace-overview)

# After closing a layer-shell surface, Hyprland/Wayland doesn't synthesise a
# fresh wl_pointer.enter for surfaces below until the cursor physically moves.
# Warping to the current position (no visible change) forces the re-enter.
_reenter() {
  sleep 0.1
  local p x y; p=$(hyprctl cursorpos 2>/dev/null) || return 0
  x=${p%,*}; y=${p#*, }
  x=${x//[[:space:]]/}; y=${y//[[:space:]]/}
  [[ -n $x && -n $y ]] || return 0
  hyprctl dispatch "hl.dsp.cursor.move({x=$((x + 1)), y=$y})" >/dev/null 2>&1 || true
  hyprctl dispatch "hl.dsp.cursor.move({x=$x, y=$y})" >/dev/null 2>&1 || true
}

# eww active-windows outputs "id: name" per line
is_window_open() {
  $EWW active-windows 2>/dev/null | grep -q "^${1}"
}

close_all() {
  for p in "${POPUPS[@]}"; do
    is_window_open "$p" && $EWW close "$p" 2>/dev/null
  done
}

# Open on the primary monitor (where the bar is) when it is known and
# addressable; otherwise let EWW pick its default monitor. The primary is
# resolved in the background (primary_fd) while the other popups close; a
# stuck lookup delays the popup by at most 2 seconds.
open_popup() {
  local primary=""
  read -r -t 2 -u "$primary_fd" primary || true
  exec {primary_fd}<&-
  if [[ -n $primary ]] && $EWW open "$@" --screen "$primary" 2>/dev/null; then
    return 0
  fi
  $EWW open "$@"
}

# --close: just close everything
if [[ "${1:-}" == "--close" ]]; then
  close_all
  _reenter &
  exit 0
fi

WINDOW="${1:?Usage: popup-toggle <window-name> | --close}"

# Toggle: if open, close; if closed, close others and open
if is_window_open "$WINDOW"; then
  $EWW close "$WINDOW" 2>/dev/null
  _reenter &
else
  exec {primary_fd}< <(workspace-ctl primary 2>/dev/null)
  close_all
  if [[ "$WINDOW" == workspace-overview ]]; then
    # Window properties can read arguments, not EWW's listener variables.
    if ! overview_state=$($EWW get workspace-state) || [[ -z "$overview_state" ]]; then
      echo "popup-toggle: Cannot read workspace overview state; reload the bar and retry" >&2
      exit 1
    fi
    open_popup "$WINDOW" --arg "overview-state=$overview_state"
  else
    open_popup "$WINDOW" 2>/dev/null
  fi
fi

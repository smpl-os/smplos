#!/bin/bash
# smplOS Popup Toggle -- opens one bar popup, closes all others
# Usage: popup-toggle <window-name>    Open/toggle a popup
#        popup-toggle --close          Close all popups
#
# Features:
#   - Mutual exclusion: only one popup visible at a time
#   - Works on both Wayland and X11 (no compositor-specific code)

EWW="eww --config $HOME/.config/eww"
BAR_CTL="${BAR_CTL:-bar-ctl}"

# All known popup windows (add new popups here)
POPUPS=(calendar-popup notification-hub usb-popup workspace-overview)

# After closing a layer-shell surface, Hyprland/Wayland doesn't synthesise a
# fresh wl_pointer.enter for surfaces below until the cursor physically moves.
# Warping to the current position (no visible change) forces the re-enter.
_reenter() {
  sleep 0.1
  local p x y; p=$(hyprctl cursorpos 2>/dev/null) || return 0
  x=${p%,*}; y=${p#*, }
  x=${x//[[:space:]]/}; y=${y//[[:space:]]/}
  [[ -n $x && -n $y ]] || return 0
  hyprctl dispatch "hl.dsp.cursor.move({x=$((x + 1)), y=$y})" >/dev/null 2>&1 || true
  hyprctl dispatch "hl.dsp.cursor.move({x=$x, y=$y})" >/dev/null 2>&1 || true
}

# eww active-windows outputs "id: name" per line
is_window_open() {
  $EWW active-windows 2>/dev/null | grep -q "^${1}"
}

close_all() {
  for p in "${POPUPS[@]}"; do
    is_window_open "$p" && $EWW close "$p" 2>/dev/null
  done
}

compact_calendar_running() {
  local binary
  binary=$(command -v smpl-calendar 2>/dev/null || true)
  [[ -n "$binary" ]] && pgrep -f "^${binary}$" >/dev/null 2>&1
}

notification_center_running() {
  pgrep -x notif-center >/dev/null 2>&1
}

close_start_menu() {
  toggle-start-menu --hide
}

close_resident_popups() {
  local except="${1:-}"
  if [[ "$except" != calendar-popup ]] && compact_calendar_running; then
    toggle-calendar
  fi
  if [[ "$except" != notification-hub ]] && notification_center_running; then
    toggle-notif-center
  fi
  if [[ "$except" != start-menu ]]; then
    close_start_menu
  fi
}

close_native_all() {
  rm -f -- "${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/smplos/native-popup.active"
  "$BAR_CTL" close-popups
  if compact_calendar_running; then
    toggle-calendar
  fi
  if notification_center_running; then
    toggle-notif-center
  fi
}

native_popup() {
  local target="${1:-}"
  local state_dir="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/smplos"
  local state="$state_dir/native-popup.active"
  if [[ "$target" == "--close" ]]; then
    close_native_all
    return
  fi
  case "$target" in
    quick-settings)
      native_open_or_close "$target" quick-settings "$state"
      ;;
    usb-popup)
      native_open_or_close "$target" usb "$state"
      ;;
    workspace-overview)
      native_open_or_close "$target" workspace-overview "$state"
      ;;
    start-menu)
      rm -f -- "$state"
      "$BAR_CTL" close-popups
      close_resident_popups start-menu
      toggle-start-menu
      ;;
    notification-hub)
      rm -f -- "$state"
      "$BAR_CTL" close-popups
      close_resident_popups notification-hub
      toggle-notif-center
      ;;
    calendar-popup)
      rm -f -- "$state"
      "$BAR_CTL" close-popups
      close_resident_popups calendar-popup
      toggle-calendar
      ;;
    *)
      echo "popup-toggle: unsupported popup '$target'" >&2
      return 1
      ;;
  esac
}

native_open_or_close() {
  local target="$1" command="$2" state="$3" current=""
  [[ ! -f "$state" ]] || current=$(<"$state")
  if [[ "$current" == "$target" ]]; then
    "$BAR_CTL" close-popups
    rm -f -- "$state"
  else
    close_resident_popups "$target"
    "$BAR_CTL" close-popups
    "$BAR_CTL" popup "$command" || return
    mkdir -p "${state%/*}" || return
    printf '%s\n' "$target" > "$state"
  fi
}

# Open on the primary monitor (where the bar is) when it is known and
# addressable; otherwise let EWW pick its default monitor. The primary is
# resolved in the background (primary_fd) while the other popups close; a
# stuck lookup delays the popup by at most 2 seconds.
open_popup() {
  local primary=""
  read -r -t 2 -u "$primary_fd" primary || true
  exec {primary_fd}<&-
  if [[ -n $primary ]] && $EWW open "$@" --screen "$primary" 2>/dev/null; then
    return 0
  fi
  $EWW open "$@"
}

# Native IPC owns quick settings, USB and workspace overview. Calendar and
# notifications deliberately use their resident app toggles from the same
# action surface rather than inventing unsupported IPC command names.
backend=$("$BAR_CTL" backend 2>/dev/null) || backend=eww
if [[ "$backend" == smpl-bar ]]; then
  native_popup "${1:-}"
  exit $?
fi
if [[ "${1:-}" == quick-settings ]]; then
  echo "popup-toggle: quick settings requires the native smpl-bar backend" >&2
  exit 1
fi

# --close: just close everything
if [[ "${1:-}" == "--close" ]]; then
  close_all
  _reenter &
  exit 0
fi

WINDOW="${1:?Usage: popup-toggle <window-name> | --close}"

if [[ "$WINDOW" == start-menu ]]; then
  close_all
  close_resident_popups start-menu
  toggle-start-menu
  exit $?
fi

# Toggle: if open, close; if closed, close others and open
if is_window_open "$WINDOW"; then
  $EWW close "$WINDOW" 2>/dev/null
  _reenter &
else
  exec {primary_fd}< <(workspace-ctl primary 2>/dev/null)
  close_all
  if [[ "$WINDOW" == workspace-overview ]]; then
    # Window properties can read arguments, not EWW's listener variables.
    if ! overview_state=$($EWW get workspace-state) || [[ -z "$overview_state" ]]; then
      echo "popup-toggle: Cannot read workspace overview state; reload the bar and retry" >&2
      exit 1
    fi
    open_popup "$WINDOW" --arg "overview-state=$overview_state"
  else
    open_popup "$WINDOW" 2>/dev/null
  fi
fi

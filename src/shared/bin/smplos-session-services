#!/bin/bash
# smplOS: start the graphical session's user services and verify them.
#
# hypridle (screen-off, suspend and lock timers), voxtype (dictation) and the
# XR glasses watcher are WantedBy=graphical-session.target. Hyprland is
# launched without a session manager, so nothing activated that target: the
# services ran only after Settings or an update happened to restart them and
# silently stopped after every reboot. This runs once from Hyprland autostart
# (both config trees), starts smplos-session.target (bound to
# graphical-session.target) and reports any enabled service that is not
# running instead of failing silently. A service that still fails after a
# retry is stopped so its Restart= policy cannot loop for the whole session.
#
# Usage: smplos-session-services            at login
#        smplos-session-services --verify   only check (after an update started
#                                           the target in a running session)

set -uo pipefail

MODE="${1:-login}"

TARGET=smplos-session.target
LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/smplos"
LOG="$LOG_DIR/session-services.log"
# Failing units are announced when the set changes; power timers every login.
FAILED_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/smplos/session-services.failed"
ALWAYS_REPORT=(hypridle.service)
mkdir -p "$LOG_DIR" "${FAILED_FILE%/*}" 2>/dev/null
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; }
sc() { systemctl --user "$@"; }
prop() { sc show "$1" -p "$2" --value 2>/dev/null; }

enabled_session_units() {
    local dir
    for dir in "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user" "${SMPLOS_SYSTEM_USER_UNITS:-/etc/systemd/user}"; do
        [[ -d "$dir/graphical-session.target.wants" ]] || continue
        ls -1 "$dir/graphical-session.target.wants"
    done | sort -u
}

# Not started because a unit condition failed on purpose (for example the
# XR watcher's binary is not installed) - not an error.
condition_skipped() {
    [[ "$(prop "$1" ConditionResult)" == no && -n "$(prop "$1" ConditionTimestamp)" ]]
}

unit_ready() {
    # Unplugging during verification is not a startup failure.
    if [[ "$1" == control-surface.service ]] && ! sc is-active --quiet smplos-keypad.device; then
        return 0
    fi
    local state
    state=$(prop "$1" ActiveState)
    [[ "$state" == active ]] && return 0
    # A completed oneshot need not use RemainAfterExit to have succeeded.
    [[ "$state" == inactive && "$(prop "$1" Type)" == oneshot \
        && "$(prop "$1" Result)" == success && "$(prop "$1" ExecMainStatus)" == 0 \
        && "$(prop "$1" ExecMainExitTimestampMonotonic)" =~ ^[1-9][0-9]*$ ]]
}

failure_reason() {
    if [[ "$1" == control-surface.service ]] && condition_skipped "$1"; then
        echo "keypad app unavailable; retry Update OS and check the unit's executable path"
    else
        printf '%s (exit status %s)' "$(prop "$1" Result)" "$(prop "$1" ExecMainStatus)"
    fi
}

describe() {
    case "$1" in
        hypridle.service) echo "Power timers (screen off, suspend, lock)" ;;
        voxtype.service) echo "Dictation" ;;
        xr-glasses.service) echo "XR glasses watcher" ;;
        control-surface.service) echo "Macro keypad app" ;;
        *) prop "$1" Description ;;
    esac
}

mapfile -t units < <(enabled_session_units)

if [[ "$MODE" != --verify ]]; then
    # Services need WAYLAND_DISPLAY (hypridle checks it), portals the rest.
    sc import-environment 2>/dev/null

    # A target left active by the previous login still binds its services to
    # that session's Wayland display; stop it so they start for this one.
    if sc is-active --quiet graphical-session.target; then
        log "stopping graphical-session.target left over from the previous session"
        sc stop graphical-session.target
    fi

    # A service that crashed when the previous session ended may have hit its
    # start limit.
    [[ ${#units[@]} -gt 0 ]] && sc reset-failed "${units[@]}" 2>/dev/null

    if ! sc start "$TARGET" 2>>"$LOG"; then
        # The unit may have been installed after this user manager started.
        sc daemon-reload
        sc start "$TARGET" 2>>"$LOG" || log "could not start $TARGET"
    fi

    # Coldplug may have been missed, or started the app before environment
    # import. Rebind it once after the target starts, only with a keypad.
    if sc is-active --quiet smplos-keypad.device 2>/dev/null; then
        sc reset-failed control-surface.service 2>>"$LOG"
        sc restart control-surface.service 2>>"$LOG" || log "could not restart control-surface.service"
    fi
fi

# This device-triggered service has no enablement link, but must be verified
# when hardware is present. --verify does not restart an already-running app.
if sc is-active --quiet smplos-keypad.device 2>/dev/null \
    && [[ " ${units[*]} " != *" control-surface.service "* ]]; then
    units+=(control-surface.service)
fi

sleep "${SMPLOS_SESSION_SETTLE:-5}"
failed=()
declare -A failure_reasons=()
for unit in "${units[@]}"; do
    unit_ready "$unit" && continue
    if [[ "$unit" != control-surface.service ]] && condition_skipped "$unit"; then
        continue
    fi
    log "$unit is $(prop "$unit" ActiveState); restarting"
    sc restart "$unit" 2>>"$LOG"
    sleep "${SMPLOS_SESSION_RETRY:-2}"
    if unit_ready "$unit"; then
        log "$unit recovered"
    else
        failed+=("$unit")
        failure_reasons["$unit"]=$(failure_reason "$unit")
        log "$unit failed: ${failure_reasons[$unit]}; stopped"
        sc stop "$unit" 2>>"$LOG"
    fi
done

previous=$(cat "$FAILED_FILE" 2>/dev/null)
current=$(printf '%s\n' "${failed[@]}" | sed '/^$/d')
if [[ -n "$current" ]]; then
    printf '%s\n' "$current" > "$FAILED_FILE"
    always=0
    for unit in "${ALWAYS_REPORT[@]}"; do
        [[ " ${failed[*]} " == *" $unit "* ]] && always=1
    done
    if [[ "$current" != "$previous" || $always -eq 1 ]]; then
        names=$(for unit in "${failed[@]}"; do describe "$unit"; done | paste -sd ',' - | sed 's/,/, /g')
        reasons=$(for unit in "${failed[@]}"; do printf '%s: %s\n' "$unit" "${failure_reasons[$unit]}"; done)
        notify-send -u critical "Some settings are not active" \
            "$names did not start. $reasons. Details: journalctl --user -u ${failed[0]}" 2>/dev/null || true
    fi
    exit 1
fi
rm -f "$FAILED_FILE"
log "session services running: ${units[*]:-none}"

#!/bin/bash
# smplOS settings dispatcher -- opens the appropriate settings tool
# Called by the launcher cache entries (smplos-settings <category>)
# Detects compositor and available tools at runtime.

die() { notify-send "smplOS Settings" "$1"; exit 1; }

term() { exec terminal -e "$@"; }

case "${1:-}" in
  appearance)
    command -v theme-picker &>/dev/null && exec theme-picker
    die "Theme picker not found"
    ;;

  display)
    command -v settings &>/dev/null && exec settings --tab display
    if [[ -n "$WAYLAND_DISPLAY" ]]; then
      command -v wdisplays &>/dev/null && exec wdisplays
      command -v nwg-displays &>/dev/null && exec nwg-displays
      command -v wlr-randr &>/dev/null && term wlr-randr
      die "No display tool found (install wdisplays)"
    else
      command -v arandr &>/dev/null && exec arandr
      command -v lxrandr &>/dev/null && exec lxrandr
      die "No display tool found (install arandr)"
    fi
    ;;

  network)
    command -v nm-connection-editor &>/dev/null && exec nm-connection-editor
    command -v nmtui &>/dev/null && term nmtui
    die "No network manager UI found"
    ;;

  connections)
    command -v settings &>/dev/null && exec settings --tab connections
    die "Settings app not found (Connections needs smpl-apps with the Connections tab)"
    ;;

  # Wi-Fi and Bluetooth are sections of the Connections tab; these two names
  # open the matching section and keep older shortcuts working.
  wifi)
    command -v settings &>/dev/null && exec settings --tab wifi
    die "Settings app not found"
    ;;

  bluetooth)
    command -v settings &>/dev/null && exec settings --tab bluetooth
    command -v blueman-manager &>/dev/null && exec blueman-manager
    command -v bluetuith &>/dev/null && term bluetuith
    die "No bluetooth manager found (install blueman)"
    ;;

  audio)
    for mixer in pavucontrol pwvucontrol pavucontrol-qt qasmixer alsamixergui; do
      command -v "$mixer" &>/dev/null && exec "$mixer"
    done
    # ALSA controls hardware gain; PipeWire/PulseAudio mixers also expose streams.
    for mixer in wiremix pulsemixer ncpamixer pamix alsamixer; do
      command -v "$mixer" &>/dev/null || continue
      command -v terminal &>/dev/null || {
        echo "smplos-settings: terminal launcher is missing (needed for $mixer)" >&2
        die "Terminal launcher not found (needed for $mixer)"
      }
      term "$mixer"
    done
    echo "smplos-settings: no supported audio mixer found" >&2
    die "No audio mixer found (install pavucontrol, pwvucontrol, pulsemixer or alsa-utils)"
    ;;

  keyboard)
    command -v settings &>/dev/null && exec settings --tab keyboard
    die "Settings app not found"
    ;;

  keypad)
    command -v settings &>/dev/null && exec settings --tab keypad
    die "Settings app not found (Keypad needs smpl-apps with the Keypad tab)"
    ;;

  mouse)
    command -v settings &>/dev/null && exec settings --tab mouse
    die "Settings app not found (Mouse needs smpl-apps with the Mouse tab)"
    ;;

  printing|printers)
    command -v settings &>/dev/null && exec settings --tab printing
    die "Settings app not found (Printing needs a compatible smpl-apps release)"
    ;;

  dictation)
    command -v settings &>/dev/null && exec settings --tab dictation
    # Fall back to standalone script if settings unavailable
    exec dictation-settings
    ;;

  power)
    command -v settings &>/dev/null && exec settings --tab power
    powermenu
    ;;

  about)
    command -v settings &>/dev/null && exec settings --tab about
    local_ver=""
    if [[ -f /etc/os-release ]]; then
      local_ver=$(grep '^VERSION_ID=' /etc/os-release | head -1 | cut -d'=' -f2 | tr -d '"')
      [[ -n "$local_ver" ]] && local_ver="v${local_ver}"
    fi
    notify-send "smplOS" "Version: ${local_ver:-dev}\nKernel: $(uname -r)\nUptime: $(uptime -p | sed 's/up //')"
    ;;

  keybindings)
    command -v settings &>/dev/null && exec settings --tab keybindings
    die "Settings app not found"
    ;;

  taskbar)
    command -v settings &>/dev/null && exec settings --tab taskbar
    die "Settings app not found"
    ;;

  *)
    echo "Usage: smplos-settings {appearance|display|keyboard|keypad|mouse|printing|network|connections|wifi|bluetooth|audio|dictation|power|about|keybindings|taskbar}" >&2
    exit 1
    ;;
esac

#!/bin/bash
# smplos-update-apps — Update smplOS custom apps from GitHub releases
#
# Downloads the latest versions of forked/custom apps:
#   - smpl-apps (start-menu, notif-center, settings, app-center, webapp-center, etc.)
#     plus the bundled XR glasses module (xr-workspace, xrctl, xr-game,
#     xr-glasses-hotplugd) which CI folds into the smpl-apps release tarball.
#   - st-smpl (st-wl terminal)
#   - nemo-smpl (file manager)
#   - micro-smpl (text editor with dynamic config reloading)
#   - control-surface (keypad and mouse remapping daemons)
#
# Each app is only downloaded if a newer version exists on GitHub.
# Version state is tracked in ~/.local/state/smplos/app-versions/
#
# Usage: smplos-update-apps [--check | --quiet] [--report PATH]

set -euo pipefail

STATE_DIR="$HOME/.local/state/smplos/app-versions"
SMPLOS_BIN="$HOME/.local/share/smplos/bin"
SMPLOS_PATH="${SMPLOS_PATH:-$HOME/.local/share/smplos}"
for _lib in "$SMPLOS_PATH/repo/src/shared/lib/smplos-app-bundle.sh" \
            "$(dirname "${BASH_SOURCE[0]}")/../lib/smplos-app-bundle.sh" \
            /usr/local/lib/smplos/smplos-app-bundle.sh; do
    if [[ -r "$_lib" ]]; then
        source "$_lib"
        source "$(dirname "$_lib")/smplos-release-package.sh"
        source "$(dirname "$_lib")/smplos-pkgbuild.sh"
        source "$(dirname "$_lib")/smplos-keypad-units.sh"
        source "$(dirname "$_lib")/smplos-control-surface.sh"
        break
    fi
done
unset _lib
if ! declare -F smplos_app_bundle_valid >/dev/null; then
    echo "ERROR: smplos-app-bundle.sh not found; run smplos-os-update first" >&2
    exit 1
fi
mkdir -p "$STATE_DIR" "$SMPLOS_BIN"

CHECK_ONLY=0; QUIET=0; REPORT_FILE=""; GROUP=all
while [[ $# -gt 0 ]]; do
    case "$1" in
        --check) CHECK_ONLY=1 ;;
        --quiet) QUIET=1 ;;
        --group)
            case "${2:-}" in
                all|core|optional) GROUP="$2"; shift ;;
                *) echo "ERROR: --group requires all, core or optional" >&2; exit 1 ;;
            esac ;;
        --report)
            [[ -n "${2:-}" ]] || { echo "ERROR: --report needs a path" >&2; exit 1; }
            REPORT_FILE="$2"; shift ;;
        -h|--help)
            echo "Usage: smplos-update-apps [--check | --quiet] [--group all|core|optional] [--report PATH]"
            exit 0 ;;
        *) echo "ERROR: unknown option: $1" >&2; exit 1 ;;
    esac
    shift
done
REPORT_FILE="${REPORT_FILE:-$HOME/.local/state/smplos/update/apps-$(date +%Y%m%d-%H%M%S)-$$.json}"
REPORT_WORK=$(mktemp -d /tmp/smplos-app-results.XXXXXX)
_SUDO_PID=""
cleanup_app_update() {
    if [[ -n "$_SUDO_PID" ]]; then
        kill "$_SUDO_PID" 2>/dev/null || true
        wait "$_SUDO_PID" 2>/dev/null || true
    fi
    rm -rf -- "$REPORT_WORK"
}
trap cleanup_app_update EXIT

# ── Ensure sudo is ready ─────────────────────────────────────────────────────
# When called from smplos-update, SMPLOS_SUDO_READY is set and credentials are
# already cached. When run standalone, authenticate once and start a keepalive.
if [[ "$GROUP" != optional && "${SMPLOS_SUDO_READY:-0}" != "1" && $CHECK_ONLY -eq 0 ]]; then
    sudo -v || { echo "ERROR: sudo authentication failed" >&2; exit 1; }
    (
        trap - EXIT INT HUP
        sleeper=""
        trap '[[ -z "$sleeper" ]] || kill "$sleeper" 2>/dev/null; exit' TERM
        while true; do
            sleep 30 & sleeper=$!
            wait "$sleeper" || exit
            command sudo -n -v || exit
        done
    ) >/dev/null 2>&1 &
    _SUDO_PID=$!
fi
if [[ $CHECK_ONLY -eq 0 ]]; then
    if ! declare -F sudo >/dev/null; then
        sudo() { command sudo -n "$@"; }
    fi
    export -f sudo
fi

# ── Helpers ───────────────────────────────────────────────────────────────────
log()  { [[ $QUIET -eq 0 ]] && echo "  $*" || true; }
ok()   { [[ $QUIET -eq 0 ]] && echo "  \u2713 $*" || true; }
warn() { echo "  \u26a0 $*" >&2; }

_version_gt() {
    local a="${1#v}" b="${2#v}"
    [[ "$a" == "$b" ]] && return 1
    local highest
    highest=$(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -1)
    [[ "$highest" == "$a" ]]
}

_gh_api() {
    local url="$1"
    _gh_json=""
    _gh_json=$(curl -fsSL --connect-timeout 15 --max-time 30 "$url" 2>/dev/null) || return 1
    [[ -n "$_gh_json" ]] || return 1
    if [[ -n "${SMPLOS_APP_RESULT_FILE:-}" ]]; then
        printf '%s\n' "$_gh_json" > "$SMPLOS_APP_RESULT_FILE" || return 1
    fi
}

_cached_ver() {
    local name="$1"
    [[ -f "$STATE_DIR/$name" ]] && cat "$STATE_DIR/$name" || echo ""
}

component_files_current() {
    local component="$1" receipt="$STATE_DIR/$1.sha256" receipts=()
    shift
    [[ -s "$receipt" && $# -gt 0 ]] || return 1
    receipts+=("$receipt")
    if [[ "$component" == smpl-apps && -s "$STATE_DIR/smpl-apps-retained.sha256" ]]; then
        receipts+=("$STATE_DIR/smpl-apps-retained.sha256")
    fi
    local file
    for file in "$@"; do
        [[ -x "$file" ]] || return 1
        [[ "$(grep -hFx "$(sha256sum "$file")" "${receipts[@]}" | wc -l)" == 1 ]] || return 1
    done
    sha256sum --check --status "${receipts[@]}"
}

repair_release_allowed() {
    if [[ -n "$2" ]] && _version_gt "$2" "$3"; then
        warn "$1: installed release $2 needs repair but GitHub latest is older ($3); refusing a downgrade"
        return 1
    fi
}

record_component_files() {
    local component="$1" temporary
    shift
    temporary=$(mktemp "$STATE_DIR/.receipt.XXXXXX") || return 1
    if { (( $# == 0 )) || sha256sum "$@"; } > "$temporary" &&
        mv -f -- "$temporary" "$STATE_DIR/$component.sha256"; then
        return 0
    fi
    rm -f -- "$temporary"
    warn "$component: could not record installed release checksums"
    return 1
}

installed_component_version() {
    local version package=""
    case "$1" in nemo-smpl|control-surface) package="$1" ;; esac
    if [[ -n "$package" ]]; then
        version=$(pacman -Q "$package" 2>/dev/null) || version=""
        printf '%s\n' "${version#* }"
    else
        _cached_ver "$1"
    fi
}

record_app_result() {
    python3 - "$REPORT_FILE" "$REPORT_WORK" "$@" <<'PY'
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import sys
import tempfile

path, work = map(Path, sys.argv[1:3])
component, before, after, status = sys.argv[3:]
report = {"schema": 1, "components": {}}
if component:
    report = json.loads(path.read_text())
    metadata = work / (component + ".json")
    target = None
    if metadata.exists():
        try:
            target = json.loads(metadata.read_text()).get("tag_name")
        except (ValueError, AttributeError):
            print(f"{component}: invalid release metadata", file=sys.stderr)
    if not target and status not in ("failed", "pinned"):
        status = "failed"
    report["components"][component] = {
        "before": before or None, "after": after or None, "target": target, "status": status,
    }
    package_target = work / (component + ".json.package-target")
    if package_target.exists():
        report["components"][component]["package_target"] = package_target.read_text().strip()
report["time"] = datetime.now(timezone.utc).isoformat()
path.parent.mkdir(parents=True, exist_ok=True)
fd, temporary = tempfile.mkstemp(prefix=".app-results-", dir=path.parent)
try:
    with os.fdopen(fd, "w") as stream:
        json.dump(report, stream, indent=2, sort_keys=True)
        stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, path)
    directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
sys.exit(status == "failed")
PY
}

n_updated=0

# ── smpl-apps ─────────────────────────────────────────────────────────────────
update_smpl_apps() {
    local cached_ver remote_ver
    local app xrbin receipt installed=() retained=() retain_xr=0
    for app in "${SMPLOS_APP_BINS[@]}"; do installed+=("/usr/local/bin/$app"); done
    for xrbin in xr-workspace xrctl xr-game xr-glasses-hotplugd; do
        if [[ -e "/usr/local/bin/$xrbin" || -L "/usr/local/bin/$xrbin" ]]; then
            installed+=("/usr/local/bin/$xrbin")
            continue
        fi
        for receipt in "$STATE_DIR/smpl-apps.sha256" "$STATE_DIR/smpl-apps-retained.sha256"; do
            if [[ -f "$receipt" ]] &&
                grep -qFx "/usr/local/bin/$xrbin" <(cut -c67- "$receipt"); then
                installed+=("/usr/local/bin/$xrbin")
                break
            fi
        done
    done
    cached_ver=$(_cached_ver smpl-apps)

    if ! _gh_api "https://api.github.com/repos/smpl-os/smpl-apps/releases/latest"; then
        warn "smpl-apps: GitHub unreachable"
        return 1
    fi

    remote_ver=$(echo "$_gh_json" | grep -oP '"tag_name"\s*:\s*"\K[^"]+' || true)
    [[ -z "$remote_ver" ]] && { warn "smpl-apps: could not parse version"; return 1; }

    if [[ -n "$cached_ver" ]] && ! _version_gt "$remote_ver" "$cached_ver" \
        && smplos_app_binaries_valid /usr/local/bin \
        && component_files_current smpl-apps "${installed[@]}" \
        && [[ -f "${XDG_STATE_HOME:-$HOME/.local/state}/smplos/calendar-service/last-installed.service" ]]; then
        ok "smpl-apps: up to date ($cached_ver)"
        if [[ -s "$STATE_DIR/smpl-apps-retained.sha256" ]]; then
            log "XR module: optional binaries retained from an earlier release, not upgraded by $cached_ver"
        fi
        return
    fi
    repair_release_allowed smpl-apps "$cached_ver" "$remote_ver" || return 1

    if [[ $CHECK_ONLY -eq 1 ]]; then
        log "smpl-apps: update available ${cached_ver:-none} -> $remote_ver"
        return
    fi

    local tarball_url
    tarball_url=$(echo "$_gh_json" \
        | grep -oP '"browser_download_url"\s*:\s*"\K[^"]*smpl-apps-[^"]*x86_64\.tar\.gz' \
        | head -1 || true)

    if [[ -z "$tarball_url" ]]; then
        warn "smpl-apps: no tarball asset in release $remote_ver"
        return 1
    fi

    log "smpl-apps: updating ${cached_ver:-none} -> $remote_ver"

    local tmpdir
    tmpdir=$(mktemp -d /tmp/smplos-apps.XXXXXX)
    trap "rm -rf '$tmpdir'" RETURN

    if ! smplos_download_app_bundle "$tarball_url" "$tmpdir"; then
        warn "smpl-apps: incomplete or failed download; version not recorded"
        return 1
    fi

    # Check the entire bundle against this machine before replacing any app.
    for app in "${SMPLOS_APP_BINS[@]}"; do
        smplos_app_linkage_valid "$tmpdir/$app" || return 1
    done
    for xrbin in xr-workspace xrctl xr-game xr-glasses-hotplugd; do
        if [[ " ${installed[*]} " == *" /usr/local/bin/$xrbin "* && ! -f "$tmpdir/$xrbin" ]]; then
            retain_xr=1
        fi
    done
    # Keep the installed XR module together rather than mixing old/new peers.
    for xrbin in xr-workspace xrctl xr-game xr-glasses-hotplugd; do
        if (( retain_xr )); then
            [[ " ${installed[*]} " == *" /usr/local/bin/$xrbin "* ]] || continue
            if [[ ! -x "/usr/local/bin/$xrbin" ]] ||
                ! smplos_xr_file_valid "/usr/local/bin/$xrbin"; then
                warn "smpl-apps: cannot safely retain optional binary $xrbin omitted by $remote_ver"
                return 1
            fi
            for receipt in "$STATE_DIR/smpl-apps.sha256" "$STATE_DIR/smpl-apps-retained.sha256"; do
                if [[ -f "$receipt" ]] &&
                    grep -qFx "/usr/local/bin/$xrbin" <(cut -c67- "$receipt") &&
                    ! grep -qxF "$(sha256sum "/usr/local/bin/$xrbin")" "$receipt"; then
                    warn "smpl-apps: optional binary $xrbin differs from its checksum receipt and cannot be repaired by $remote_ver"
                    return 1
                fi
            done
            retained+=("/usr/local/bin/$xrbin")
            warn "smpl-apps: $remote_ver omits part of the installed optional XR module; retaining verified $xrbin (not upgraded)"
            continue
        fi
        [[ ! -f "$tmpdir/$xrbin" ]] || smplos_xr_file_valid "$tmpdir/$xrbin" || return 1
    done

    # Atomic rename preserves already-running mappings; never kill user work.
    for app in "${SMPLOS_APP_BINS[@]}"; do
        local src="$tmpdir/$app"
        [[ -f "$src" ]] || continue

        smplos_install_app_binary "$src" "/usr/local/bin/$app" || return 1

        # ── Shadow scrub (single-copy invariant) ─────────────────────────
        # Previously this script also `install -m755` d the binary into
        # ~/.local/share/smplos/bin/, on the theory that dir sits earlier
        # on PATH than /usr/local/bin (envs.conf prepends it) and mirroring
        # the binary there would prevent stale user-local copies from
        # shadowing the canonical install. In practice the mirror IS the
        # shadow — every partial failure (sudo denied, disk full during
        # the second install -m755, script interrupted between the two)
        # left the two copies out of sync, and the ~/.local/share copy
        # silently kept serving old code because it comes first on PATH.
        # This is exactly how ~/.local/share/smplos/bin/smpl-calendar got
        # pinned at v0.7.4 while /usr/local/bin ran v0.8.11 — Eww resolved
        # by bare name, hit the shadow, users saw "the fix did not take".
        # We now DELETE any shadow left behind by previous runs (or by
        # deploy-local.sh) so the /usr/local/bin copy is the only one
        # anything on PATH can find.
        local shadow
        for shadow in \
            "$HOME/.local/share/smplos/bin/$app" \
            "$HOME/.local/bin/$app" \
            "$HOME/bin/$app"
        do
            [[ -e "$shadow" || -L "$shadow" ]] || continue
            rm -f "$shadow" 2>/dev/null || true
        done

    done

    smplos_install_calendar_service "$tmpdir/smpl-calendar-alertd.service" || return 1

    # XR glasses module — same story as apps above: canonical install goes to
    # /usr/local/bin only, then scrub the shadow dirs so PATH lookup can't
    # possibly resolve to a stale copy.
    installed=()
    for app in "${SMPLOS_APP_BINS[@]}"; do installed+=("/usr/local/bin/$app"); done
    local xr_installed=0
    for xrbin in xr-workspace xrctl xr-game xr-glasses-hotplugd; do
        (( retain_xr == 0 )) || break
        [[ -f "$tmpdir/$xrbin" ]] || continue
        smplos_install_app_binary "$tmpdir/$xrbin" "/usr/local/bin/$xrbin" smplos_xr_file_valid || return 1
        installed+=("/usr/local/bin/$xrbin")
        for shadow in \
            "$HOME/.local/share/smplos/bin/$xrbin" \
            "$HOME/.local/bin/$xrbin" \
            "$HOME/bin/$xrbin"
        do
            [[ -e "$shadow" || -L "$shadow" ]] && rm -f "$shadow" 2>/dev/null || true
        done
        xr_installed=1
    done
    if [[ $xr_installed -eq 1 ]]; then
        log "XR module: binaries updated"
        log "XR module: log out/in to load changed background binaries; the current session was not stopped."
    fi

    record_component_files smpl-apps-retained "${retained[@]}" || return 1
    record_component_files smpl-apps "${installed[@]}" || return 1
    echo "$remote_ver" > "$STATE_DIR/smpl-apps"
    ok "smpl-apps: updated to $remote_ver"
    log "Close and reopen apps for the new code; log out/in for background daemons. Running native apps were not stopped."
    ((n_updated++)) || true
}

# ── st-smpl ───────────────────────────────────────────────────────────────────
update_st_smpl() {
    local cached_ver remote_ver
    cached_ver=$(_cached_ver st-smpl)

    if ! _gh_api "https://api.github.com/repos/smpl-os/st-smpl/releases/latest"; then
        warn "st-smpl: GitHub unreachable"
        return 1
    fi

    remote_ver=$(echo "$_gh_json" | grep -oP '"tag_name"\s*:\s*"\K[^"]+' || true)
    [[ -z "$remote_ver" ]] && { warn "st-smpl: could not parse version"; return 1; }

    if [[ -n "$cached_ver" ]] && ! _version_gt "$remote_ver" "$cached_ver" \
        && [[ -x /usr/local/bin/st-wl ]] && component_files_current st-smpl /usr/local/bin/st-wl; then
        ok "st-smpl: up to date ($cached_ver)"
        return
    fi
    repair_release_allowed st-smpl "$cached_ver" "$remote_ver" || return 1

    if [[ $CHECK_ONLY -eq 1 ]]; then
        log "st-smpl: update available ${cached_ver:-none} -> $remote_ver"
        return
    fi

    local asset_url
    asset_url=$(echo "$_gh_json" \
        | grep -oP '"browser_download_url"\s*:\s*"\K[^"]*st[^"]*x86_64[^"]*' \
        | head -1 || true)

    if [[ -z "$asset_url" ]]; then
        warn "st-smpl: no binary asset in release $remote_ver"
        return 1
    fi

    log "st-smpl: updating ${cached_ver:-none} -> $remote_ver"

    local tmpfile
    tmpfile=$(mktemp /tmp/st-wl.XXXXXX)
    trap "rm -f '$tmpfile'" RETURN

    if curl -fSL --connect-timeout 30 --retry 3 --progress-bar \
            "$asset_url" -o "$tmpfile"; then
        smplos_install_app_binary "$tmpfile" "/usr/local/bin/st-wl" || return 1
        # Single-copy invariant: scrub the shadow instead of mirroring the
        # binary into it. See the apps loop above for the full rationale.
        local st_shadow
        for st_shadow in \
            "$HOME/.local/share/smplos/bin/st-wl" \
            "$HOME/.local/bin/st-wl" \
            "$HOME/bin/st-wl"
        do
            [[ -e "$st_shadow" || -L "$st_shadow" ]] && rm -f "$st_shadow" 2>/dev/null || true
        done

        # Also install the matching terminfo so key sequences work correctly.
        # Download from the same release if available; fall back to repo copy.
        local info_url
        info_url=$(echo "$_gh_json" \
            | grep -oP '"browser_download_url"\s*:\s*"\K[^"]*st-wl\.info' \
            | head -1 || true)
        if [[ -n "$info_url" ]]; then
            local tmpinfo
            tmpinfo=$(mktemp /tmp/st-wl-info.XXXXXX)
            if curl -fsSL --connect-timeout 15 "$info_url" -o "$tmpinfo" 2>/dev/null; then
                sudo tic -sx "$tmpinfo" || return 1
                tic -sx "$tmpinfo" || return 1
                rm -f "$tmpinfo"
                log "  terminfo updated"
            else
                rm -f "$tmpinfo"
                warn "st-smpl: matching terminfo download failed"
                return 1
            fi
        fi

        record_component_files st-smpl /usr/local/bin/st-wl || return 1
        echo "$remote_ver" > "$STATE_DIR/st-smpl"
        ok "st-smpl: updated to $remote_ver"
        ((n_updated++)) || true
    else
        warn "st-smpl: download failed"
        return 1
    fi
}

# ── nemo-smpl ─────────────────────────────────────────────────────────────────
update_nemo_smpl() {
    local cached_ver remote_ver
    cached_ver=$(_cached_ver nemo-smpl)

    if ! _gh_api "https://api.github.com/repos/smpl-os/nemo-smpl/releases/latest"; then
        warn "nemo-smpl: GitHub unreachable"
        return 1
    fi

    remote_ver=$(echo "$_gh_json" | grep -oP '"tag_name"\s*:\s*"\K[^"]+' || true)
    [[ -z "$remote_ver" ]] && { warn "nemo-smpl: could not parse version"; return 1; }

    local pkg_url package_target
    pkg_url=$(echo "$_gh_json" \
        | grep -oP '"browser_download_url"\s*:\s*"\K[^"]*nemo-smpl-[^"]*x86_64\.pkg\.tar\.zst' \
        | head -1 || true)
    if [[ "${pkg_url##*/}" =~ ^nemo-smpl-([0-9]+(\.[0-9]+)*-[0-9]+)-x86_64\.pkg\.tar\.zst$ ]]; then
        package_target="${BASH_REMATCH[1]}"
        [[ "${package_target%-*}" == "${remote_ver#v}" ]] || {
            warn "nemo-smpl: package version differs from release $remote_ver"
            return 1
        }
    else
        warn "nemo-smpl: no versioned .pkg.tar.zst in release $remote_ver"
        return 1
    fi
    if [[ -n "${SMPLOS_APP_RESULT_FILE:-}" ]]; then
        printf '%s\n' "$package_target" > "$SMPLOS_APP_RESULT_FILE.package-target"
    fi

    if smplos_package_current nemo-smpl "$remote_ver" "$package_target"; then
        ok "nemo-smpl: installed package is current or newer than $remote_ver"
        return 0
    elif [[ $? -eq 2 ]]; then
        return 1
    fi

    if [[ $CHECK_ONLY -eq 1 ]]; then
        log "nemo-smpl: update available ${cached_ver:-none} -> $remote_ver"
        return
    fi

    log "nemo-smpl: updating ${cached_ver:-none} -> $remote_ver"

    local tmpfile
    tmpfile=$(mktemp /tmp/nemo-smpl.XXXXXX.pkg.tar.zst)
    trap "rm -f '$tmpfile'" RETURN

    if curl -fSL --connect-timeout 30 --retry 3 --progress-bar \
            "$pkg_url" -o "$tmpfile"; then
        smplos_verify_release_checksum "$tmpfile" "$pkg_url" "$_gh_json" || {
            warn "nemo-smpl: checksum verification failed; retry the release download"
            return 1
        }
        smplos_nemo_package_valid "$tmpfile" "$remote_ver" || {
            warn "nemo-smpl: invalid release package; not installed or recorded"
            return 1
        }

        if sudo pacman -U --noconfirm "$tmpfile"; then
            smplos_package_current nemo-smpl "$remote_ver" "$package_target" || {
                warn "nemo-smpl: installation did not reach intact package $package_target; not recorded"
                return 1
            }
            echo "$remote_ver" > "$STATE_DIR/nemo-smpl"
            ok "nemo-smpl: updated to $remote_ver"
            ((n_updated++)) || true

            log "Close and reopen Nemo when file operations finish to load the new binary. No running windows were stopped."
        else
            warn "nemo-smpl: pacman -U failed"
            return 1
        fi
    else
        warn "nemo-smpl: download failed"
        return 1
    fi
}

# ── micro-smpl ────────────────────────────────────────────────────────────────
update_micro_smpl() {
    local cached_ver remote_ver
    cached_ver=$(_cached_ver micro-smpl)

    if ! _gh_api "https://api.github.com/repos/smpl-os/micro/releases/latest"; then
        warn "micro-smpl: GitHub unreachable"
        return 1
    fi

    remote_ver=$(echo "$_gh_json" | grep -oP '"tag_name"\s*:\s*"\K[^"]+' || true)
    [[ -z "$remote_ver" ]] && { warn "micro-smpl: could not parse version"; return 1; }

    if [[ -n "$cached_ver" ]] && ! _version_gt "$remote_ver" "$cached_ver" \
        && [[ -x /usr/local/bin/micro ]] && component_files_current micro-smpl /usr/local/bin/micro; then
        ok "micro-smpl: up to date ($cached_ver)"
        return
    fi
    repair_release_allowed micro-smpl "$cached_ver" "$remote_ver" || return 1

    if [[ $CHECK_ONLY -eq 1 ]]; then
        log "micro-smpl: update available ${cached_ver:-none} -> $remote_ver"
        return
    fi

    local asset_url
    asset_url=$(echo "$_gh_json" \
        | grep -oP '"browser_download_url"\s*:\s*"\K[^"]*micro[^"]*linux64[^"]*\.tar\.gz' \
        | head -1 || true)

    if [[ -z "$asset_url" ]]; then
        warn "micro-smpl: no linux64 tarball in release $remote_ver"
        return 1
    fi

    log "micro-smpl: updating ${cached_ver:-none} -> $remote_ver"

    local tmpdir
    tmpdir=$(mktemp -d /tmp/micro-smpl.XXXXXX)
    trap "rm -rf '$tmpdir'" RETURN

    if curl -fSL --connect-timeout 30 --retry 3 --progress-bar \
            "$asset_url" | tar -xz -C "$tmpdir"; then
        # The tarball extracts to micro-VERSION/micro
        local micro_bin
        micro_bin=$(find "$tmpdir" -name micro -type f | head -1)
        if [[ -n "$micro_bin" ]]; then
            smplos_install_app_binary "$micro_bin" "/usr/local/bin/micro" || return 1
            # Single-copy invariant: scrub shadows rather than mirror.
            local m_shadow
            for m_shadow in \
                "$HOME/.local/share/smplos/bin/micro" \
                "$HOME/.local/bin/micro" \
                "$HOME/bin/micro"
            do
                [[ -e "$m_shadow" || -L "$m_shadow" ]] && rm -f "$m_shadow" 2>/dev/null || true
            done
            record_component_files micro-smpl /usr/local/bin/micro || return 1
            echo "$remote_ver" > "$STATE_DIR/micro-smpl"
            ok "micro-smpl: updated to $remote_ver"
            ((n_updated++)) || true
        else
            warn "micro-smpl: binary not found in tarball"
            return 1
        fi
    else
        warn "micro-smpl: download failed"
        return 1
    fi
}

update_control_surface() {
    local tmpdir target
    tmpdir=$(mktemp -d /tmp/smplos-control-surface.XXXXXX)
    trap "rm -rf '$tmpdir'" RETURN
    # Share the exact smpl-apps release snapshot, even if latest moves mid-update.
    if [[ -s "$REPORT_WORK/smpl-apps.json" ]]; then
        cp "$REPORT_WORK/smpl-apps.json" "$SMPLOS_APP_RESULT_FILE"
    else
        _gh_api "https://api.github.com/repos/smpl-os/smpl-apps/releases/latest" || {
            warn "control-surface: GitHub unreachable"
            return 1
        }
    fi
    smplos_control_surface_prepare "$SMPLOS_PATH/repo/src/shared/pkgbuilds/control-surface" \
        "$SMPLOS_APP_RESULT_FILE" "$tmpdir/recipe" || return 1
    target=$(smplos_pkgbuild_version "$tmpdir/recipe") || return 1
    printf '%s\n' "$target" > "$SMPLOS_APP_RESULT_FILE.package-target"
    if smplos_control_surface_current "$target"; then
        ok "control-surface: installed package is current or newer than $target"
        return 0
    elif [[ $? -eq 2 ]]; then
        return 1
    fi
    log "control-surface: update/repair $(smplos_pkg_version control-surface) -> $target"
    [[ $CHECK_ONLY -eq 0 ]] || return 0
    smplos_control_surface_install "$tmpdir/recipe" || return 1
    ok "control-surface: updated to $target"
    log "Mouse/keypad mappings are unchanged. Log out/in when ready to load the new daemons; no running services were stopped."
    ((n_updated++)) || true
}

# ── Main ─────────────────────────────────────────────────────────────
[[ $QUIET -eq 0 ]] && echo "── smplOS App Updates ──"

failed=0
record_app_result "" "" "" "" || { warn "Cannot initialize app update report"; exit 1; }
# Retain the old optional selector as an empty report for installed callers.
for component in smpl-apps st-smpl nemo-smpl micro-smpl control-surface; do
    [[ "${GROUP:-all}" != optional ]] || continue
    before=$(installed_component_version "$component")
    if [[ "$component" == nemo-smpl || "$component" == control-surface ]] &&
        [[ ",${SMPLOS_UPDATE_PIN_IGNORE:-}," == *",$component,"* ]]; then
        log "$component: deliberately held at $before, not upgraded; security updates may be deferred."
        record_app_result "$component" "$before" "$before" pinned || exit 1
        continue
    fi
    status=current
    function_name="update_${component//-/_}"
    # A separate shell retains errexit inside each component; independent apps
    # still run after a failure, and no failed install gets a version stamp.
    if ! SMPLOS_APP_RESULT_FILE="$REPORT_WORK/$component.json" \
        bash -e -o pipefail -c "$(declare -f); $(declare -p STATE_DIR SMPLOS_PATH CHECK_ONLY QUIET SMPLOS_APP_BINS REPORT_WORK); n_updated=0; $function_name; printf '%s\n' \"\$n_updated\" > \"\$SMPLOS_APP_RESULT_FILE.installed\""; then
        status=failed
        failed=1
    fi
    after=$(installed_component_version "$component")
    if [[ "$status" != failed ]] &&
        { [[ "$before" != "$after" ]] || [[ "$(< "$REPORT_WORK/$component.json.installed")" != 0 ]]; }; then
        status=updated
        log "Testing needed: $component changed ${before:-none} -> ${after:-unknown}; test it on this machine after reopening the app or logging in again."
    fi
    if [[ $CHECK_ONLY -eq 1 && "$status" != failed ]]; then status=checked; fi
    record_app_result "$component" "$before" "$after" "$status" || {
        warn "$component: release check/install or result recording failed"
        failed=1
    }
done
[[ "${GROUP:-all}" != optional ]] || log "No OS-managed optional native apps."
log "App release results: $REPORT_FILE"

if [[ $CHECK_ONLY -eq 0 && "${GROUP:-all}" != optional ]]; then
    rebuild-app-cache || { warn "App cache refresh failed"; exit 1; }
fi

[[ $failed -eq 0 ]] || { warn "Some app updates are incomplete; resolve the errors above and retry."; exit 1; }

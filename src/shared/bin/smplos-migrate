#!/bin/bash
# smplos-migrate — Run pending system migrations
#
# Migrations are timestamped shell scripts in $SMPLOS_PATH/migrations/.
# Each runs exactly once. State is tracked in ~/.local/state/smplos/migrations/
# (an empty file per completed migration).
#
# Usage: smplos-migrate [--list | --pending | --dry-run]

set -euo pipefail

SMPLOS_PATH="${SMPLOS_PATH:-$HOME/.local/share/smplos}"
MIGRATIONS_DIR="$SMPLOS_PATH/repo/migrations"
STATE_DIR="$HOME/.local/state/smplos/migrations"
SKIPPED_DIR="$STATE_DIR/skipped"

mkdir -p "$STATE_DIR" "$SKIPPED_DIR"

# ── Argument parsing ──────────────────────────────────────────────────────────
MODE="run"
for arg in "$@"; do
    case "$arg" in
        --list)    MODE="list" ;;
        --pending) MODE="pending" ;;
        --dry-run) MODE="dry-run" ;;
        -h|--help)
            echo "Usage: smplos-migrate [--list | --pending | --dry-run]"
            echo "  --list     Show all migrations and their status"
            echo "  --pending  Show only pending migrations"
            echo "  --dry-run  Show what would run without executing"
            exit 0 ;;
        *) echo "Unknown option: $arg" >&2; exit 1 ;;
    esac
done

# ── Helpers ───────────────────────────────────────────────────────────────────
migration_status() {
    local filename="$1"
    if [[ -f "$STATE_DIR/$filename" ]]; then
        echo "done"
    elif [[ -f "$SKIPPED_DIR/$filename" ]]; then
        echo "skipped"
    else
        echo "pending"
    fi
}

# ── List / Pending ────────────────────────────────────────────────────────────
if [[ "$MODE" == "list" || "$MODE" == "pending" ]]; then
    if [[ ! -d "$MIGRATIONS_DIR" ]] || ! compgen -G "$MIGRATIONS_DIR/*.sh" &>/dev/null; then
        echo "No migrations found."
        exit 0
    fi
    for file in "$MIGRATIONS_DIR"/*.sh; do
        filename=$(basename "$file")
        status=$(migration_status "$filename")
        if [[ "$MODE" == "pending" && "$status" != "pending" ]]; then
            continue
        fi
        printf "  %-8s %s\n" "[$status]" "${filename%.sh}"
    done
    exit 0
fi

# ── Run migrations ────────────────────────────────────────────────────────────
if [[ ! -d "$MIGRATIONS_DIR" ]] || ! compgen -G "$MIGRATIONS_DIR/*.sh" &>/dev/null; then
    exit 0
fi

n_run=0 n_skip=0 n_fail=0 n_defer=0

for file in "$MIGRATIONS_DIR"/*.sh; do
    filename=$(basename "$file")

    # Already done or skipped
    [[ -f "$STATE_DIR/$filename" || -f "$SKIPPED_DIR/$filename" ]] && continue

    if [[ "$MODE" == "dry-run" ]]; then
        echo "  [would run] ${filename%.sh}"
        ((n_run++)) || true
        continue
    fi

    echo ""
    echo -e "\e[32m── Migration ${filename%.sh} ──\e[0m"

    if bash "$file"; then
        touch "$STATE_DIR/$filename"
        ((n_run++)) || true
    else
        status=$?
        if [[ $status -eq 75 ]]; then
            echo "  Migration ${filename%.sh} deferred; leaving unmarked for retry."
            ((n_defer++)) || true
            continue
        fi
        echo -e "\e[31m  Migration ${filename%.sh} failed.\e[0m"
        # DEFAULT: continue with subsequent migrations. The failed migration
        # is intentionally NOT marked done, so it retries on the next
        # smplos-migrate run. Aborting the whole chain on one failure means
        # a single flaky migration blocks every unrelated migration behind
        # it — which is exactly how the fleet ended up with hyprland stuck
        # at 0.55.4 when the eww-smplos install hit a resolvable pacman
        # conflict on 2026-08-04. Use --strict to restore the historical
        # abort-on-first-failure behavior for one-off manual debugging.
        ((n_fail++)) || true
        if [[ "${SMPLOS_MIGRATE_STRICT:-0}" == "1" ]]; then
            echo "  --strict: aborting migrations."
            exit 1
        fi
        echo "  Leaving unmarked so it retries on next update."
        echo "  Continuing with remaining migrations."
    fi
done

if [[ "$MODE" == "dry-run" ]]; then
    [[ $n_run -eq 0 ]] && echo "  No pending migrations."
else
    [[ $n_run -gt 0 ]] && echo -e "\n  Ran $n_run migration(s)."
    [[ $n_skip -gt 0 ]] && echo "  Skipped $n_skip migration(s)."
    [[ $n_fail -gt 0 ]] && echo -e "\e[33m  $n_fail migration(s) failed and will retry on the next update.\e[0m"
    [[ $n_defer -gt 0 ]] && echo "  $n_defer migration(s) deferred and will retry on the next update."
fi

[[ $n_fail -eq 0 ]]

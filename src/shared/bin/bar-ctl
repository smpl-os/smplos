#!/bin/bash
# Bar Control Script (EWW)

LOG="${XDG_STATE_HOME:-$HOME/.local/state}/smplos/eww-startup.log"
mkdir -p "${LOG%/*}" || exit 1

action="${1:-toggle}"
EWW_CONFIG="$HOME/.config/eww"
BAR_NAME="${2:-bar}"

echo "$(date '+%Y-%m-%d %H:%M:%S') bar-ctl: action=$action bar=$BAR_NAME config=$EWW_CONFIG" >> "$LOG"

if ! command -v eww &>/dev/null; then
    echo "Error: eww not found" | tee -a "$LOG" >&2
    exit 1
fi

# Verify config files exist
for f in eww.yuck eww.scss theme-colors.scss; do
    if [[ ! -f "$EWW_CONFIG/$f" ]]; then
        echo "Warning: $EWW_CONFIG/$f not found" | tee -a "$LOG" >&2
    fi
done

# Ensure EWW listener scripts are executable
find "$EWW_CONFIG/scripts" -name '*.sh' ! -perm -u+x -exec chmod +x {} \; 2>/dev/null

eww_cmd() {
    # A newly spawned daemon must not inherit the lifecycle lock.
    eww --config "$EWW_CONFIG" "$@" 8>&- 9>&-
}

# The primary monitor owns workspace 1 under the stable workspace policy. It is
# empty without that policy (or off Hyprland), so the bar keeps EWW's default.
eww_primary() {
    workspace-ctl primary 2>/dev/null || true
}

# Open the bar on the primary monitor, or on EWW's default when the primary is
# unknown or not addressable yet. bar_screen records where it actually landed,
# so a bar that fell back is moved by the next refresh instead of staying put.
bar_screen=""
eww_open() {
    local primary=$1
    shift
    bar_screen=""
    if [[ -n "$primary" ]] && eww_cmd open "$BAR_NAME" "$@" --screen "$primary" >> "$LOG" 2>&1; then
        bar_screen=$primary
        return 0
    fi
    eww_cmd open "$BAR_NAME" "$@" >> "$LOG" 2>&1
}

eww_geometry() {
    if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
        printf '%s\n' unsupported
        return
    fi
    local monitors
    monitors=$(hyprctl -j monitors) &&
        jq -ce 'select(type == "array" and length > 0)
            | map({name, width, height, scale, transform, x, y}) | sort_by(.name)' <<< "$monitors" ||
        { echo "Error: cannot read monitor geometry" | tee -a "$LOG" >&2; return 1; }
}

eww_stale_pid() {
    local pid executable config candidate i daemon fd socket
    local -a args
    executable=$(command -v eww) || return 1
    config=$(realpath -m "$EWW_CONFIG") || return 1
    while read -r pid; do
        [[ -r "/proc/$pid/cmdline" ]] || continue
        mapfile -d '' -t args < "/proc/$pid/cmdline" || continue
        candidate="$HOME/.config/eww"
        daemon=0
        for ((i=1; i<${#args[@]}; i++)); do
            case "${args[i]}" in
                daemon|open|open-many) daemon=1 ;;
                --config|-c) candidate="${args[i+1]:-}"; ((i++)) ;;
                --config=*) candidate="${args[i]#*=}" ;;
            esac
        done
        [[ $daemon == 1 && -n "$candidate" ]] || continue
        [[ "$(realpath -m "$candidate")" == "$config" ]] || continue
        if [[ ! "$executable" -ef "/proc/$pid/exe" ]]; then
            # Auto-started daemons retain the original "open" argv. Require
            # a listening socket so an old transient client cannot match.
            for fd in "/proc/$pid/fd/"*; do
                socket=$(readlink "$fd") || continue
                [[ "$socket" == socket:\[*\] ]] || continue
                socket="${socket#socket:[}"
                socket="${socket%]}"
                if awk -v inode="$socket" '$7 == inode && $4 == "00010000" { found=1 }
                        END { exit !found }' /proc/net/unix; then
                    printf '%s\n' "$pid"
                    return
                fi
            done
        fi
    done < <(pgrep -u "$UID" -x eww)
}

eww_start() {
    # Let EWW handle daemon spawning itself — running 'eww open' on a
    # non-running daemon auto-starts one. This avoids the race condition
    # where a separate 'eww daemon' + 'eww open' could spawn two daemons
    # if the IPC socket wasn't ready between the two commands.
    local geometry primary
    geometry=$(eww_geometry) || return 1
    primary=$(eww_primary)
    echo "$(date '+%H:%M:%S') Opening: $BAR_NAME on ${primary:-the default monitor}" >> "$LOG"
    eww_open "$primary" || return

    # Apply saved bar settings (workspace count, position, etc.)
    eww_apply || return

    echo "$(date '+%H:%M:%S') Active windows:" >> "$LOG"
    eww_cmd active-windows >> "$LOG" 2>&1 || return
    printf '%s\n' "$geometry" > "$geometry_file" || return
    printf '%s\n' "$bar_screen" > "$screen_file" || return

    # Start the geometry watcher so the bar recomputes its width whenever the
    # monitor scale/resolution changes (Settings -> Display, hot-plug, etc.).
    if ! pgrep -f "bar-ctl watch" >/dev/null 2>&1; then
        setsid "$0" watch "$BAR_NAME" 8>&- 9>&- >/dev/null 2>&1 &
    fi

    # One-shot recompute shortly after boot: the bar may open before the final
    # monitor scale is applied, leaving it centred/too-narrow.  Redrawing once
    # the layout has settled snaps it back to the correct full width.
    ( sleep 2; "$0" refresh "$BAR_NAME" ) 8>&- 9>&- >/dev/null 2>&1 &

    echo "$(date '+%H:%M:%S') bar-ctl start complete" >> "$LOG"
}
eww_stop() {
    eww_cmd close "$BAR_NAME" 2>/dev/null
}

# Force the bar to recompute its geometry (percentage widths are resolved
# against the monitor only at open time, so a close+reopen is the reliable
# way to pick up a new scale/resolution) and to move to the given primary.
eww_redraw() {
    local primary=$1 geometry
    geometry=$(eww_geometry) || return 1
    eww_cmd close "$BAR_NAME" 2>/dev/null
    sleep 0.3
    eww_open "$primary" || return
    eww_apply || return
    printf '%s\n' "$geometry" > "$geometry_file" || return
    printf '%s\n' "$bar_screen" > "$screen_file" || return
    echo "$(date '+%H:%M:%S') bar-ctl redraw complete" >> "$LOG"
}

eww_refresh() {
    local geometry primary previous="" screen=""
    geometry=$(eww_geometry) || return 1
    primary=$(eww_primary)
    [[ ! -f "$geometry_file" ]] || previous=$(<"$geometry_file")
    [[ ! -f "$screen_file" ]] || screen=$(<"$screen_file")
    if [[ "$geometry" == unsupported || "$geometry" != "$previous" || "$primary" != "$screen" ]]; then
        eww_redraw "$primary"
    fi
}

# Background daemon: listen on Hyprland's IPC socket2 and redraw the bar on any
# event that can change the monitor geometry (scale change via config reload,
# monitor hot-plug/unplug).  A short settle delay lets Hyprland finish applying
# the new layout before we recompute.
eww_watch() {
    local sock="${XDG_RUNTIME_DIR}/hypr/${HYPRLAND_INSTANCE_SIGNATURE}/.socket2.sock"
    [[ -S "$sock" ]] || return 0
    command -v socat &>/dev/null || return 0
    echo "$(date '+%H:%M:%S') bar-ctl watch started" >> "$LOG"
    socat -u "UNIX-CONNECT:$sock" - 2>/dev/null \
    | while IFS= read -r line; do
        case "${line%%>>*}" in
            monitoradded|monitoraddedv2|monitorremoved|configreloaded)
                sleep 1
                "$0" refresh "$BAR_NAME"
                ;;
        esac
    done
}
eww_toggle() {
    local primary
    primary=$(eww_primary)
    if [[ -n "$primary" ]] && eww_cmd open --toggle "$BAR_NAME" --screen "$primary" 2>/dev/null; then
        printf '%s\n' "$primary" > "$screen_file"
        return
    fi
    eww_cmd open --toggle "$BAR_NAME" || return
    [[ -z "$primary" ]] || printf '\n' > "$screen_file"
}
eww_reload() {
    local stale geometry
    geometry=$(eww_geometry) || return 1
    stale=$(eww_stale_pid)
    if [[ -n "$stale" ]]; then
        # Validate without opening windows or running deflisten/defpoll scripts.
        eww_cmd check-config || return
        echo "$(date '+%H:%M:%S') Activating replaced EWW binary (pid $stale)" >> "$LOG"
        eww_cmd kill || return
        local attempt
        for ((attempt=0; attempt<100; attempt++)); do
            if [[ ! -e "/proc/$stale/exe" ]]; then
                eww_start
                return
            fi
            sleep 0.05
        done
        echo "Error: old EWW daemon did not exit; see $LOG" >&2
        return 1
    fi
    eww_cmd reload || return
    # eww reload resets all defvar to defaults — re-apply saved settings
    sleep 0.3
    eww_apply || return
    printf '%s\n' "$geometry" > "$geometry_file"
}

eww_ensure() {
    local windows
    if ! windows=$(eww_cmd active-windows) ||
        ! awk -F: -v name="$BAR_NAME" '$1 == name { found=1 } END { exit !found }' <<< "$windows"; then
        eww_start || return 1
    else
        eww_apply || return 1
    fi
    windows=$(eww_cmd active-windows) || return 1
    if ! awk -F: -v name="$BAR_NAME" '$1 == name { found=1 } END { exit !found }' <<< "$windows"; then
        echo "Error: $BAR_NAME is still absent after recovery; see $LOG" >&2
        return 1
    fi
}

# Apply bar settings from ~/.config/smplos/bar.conf to running EWW instance.
# File format: literal KEY=VALUE (not sourced as shell). Supported keys:
#   ws_count    = 1-10   (total workspace slots, default 4)
#   ws_position = center | left  (where workspaces live, default center)
#   ws_spacing  = 1-10   (pixel gap, default 1)
#   ws_style    = numbers | squares (default numbers)
apply_error() {
    echo "bar-ctl apply: $*" | tee -a "$LOG" >&2
    return 1
}

eww_apply() {
    local conf="$HOME/.config/smplos/bar.conf"
    local ws_count=4
    local ws_position="center"
    local ws_spacing=1
    local ws_style="numbers"
    local key val
    local -A seen=()

    if [[ -e "$conf" && ( ! -f "$conf" || ! -r "$conf" ) ]]; then
        apply_error "Cannot read $conf"
        return 1
    fi
    if [[ -f "$conf" ]]; then
        while IFS='=' read -r key val || [[ -n "$key" ]]; do
            key="${key#"${key%%[![:space:]]*}"}"
            key="${key%"${key##*[![:space:]]}"}"
            val="${val#"${val%%[![:space:]]*}"}"
            val="${val%"${val##*[![:space:]]}"}"
            [[ -z "$key" || "$key" == \#* ]] && continue
            case "$key" in
                ws_count|ws_position|ws_spacing|ws_style)
                    [[ -z "${seen[$key]:-}" ]] || { apply_error "Duplicate $key"; return 1; }
                    seen[$key]=1
                    ;;
            esac
            case "$key" in
                ws_count)    ws_count="$val" ;;
                ws_position) ws_position="$val" ;;
                ws_spacing)  ws_spacing="$val" ;;
                ws_style)    ws_style="$val" ;;
            esac
        done < "$conf" || { apply_error "Cannot read $conf"; return 1; }
    fi

    [[ "$ws_count" =~ ^([1-9]|10)$ ]] || { apply_error "Invalid ws_count: $ws_count (expected 1-10)"; return 1; }
    [[ "$ws_spacing" =~ ^([1-9]|10)$ ]] || { apply_error "Invalid ws_spacing: $ws_spacing (expected 1-10)"; return 1; }
    [[ "$ws_position" == center || "$ws_position" == left ]] || { apply_error "Invalid ws_position: $ws_position"; return 1; }
    [[ "$ws_style" == numbers || "$ws_style" == squares ]] || { apply_error "Invalid ws_style: $ws_style"; return 1; }

    # The workspace listener reconciles count changes from bar.conf itself.
    # Presentation-only changes must not force a policy reload or move focus.
    if ! eww_cmd update ws-count="$ws_count" ws-position="$ws_position" \
            ws-spacing="$ws_spacing" ws-style="$ws_style"; then
        apply_error "EWW update failed; saved preferences have not been applied"
        return 1
    fi
    echo "$(date '+%H:%M:%S') bar-ctl apply: ws_count=$ws_count ws_position=$ws_position ws_spacing=$ws_spacing ws_style=$ws_style" >> "$LOG"
}

# All entrypoints, including geometry redraws, share one config-scoped lock.
if [[ "$action" != watch ]]; then
    lock_dir="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/smplos"
    config_path=$(realpath -m "$EWW_CONFIG") || exit 1
    config_id=$(printf '%s' "$config_path" | sha256sum) || exit 1
    mkdir -p "$lock_dir" || exit 1
    exec 9>"$lock_dir/bar-${config_id%% *}.lock" || exit 1
    flock 9 || exit 1
    bar_id=$(printf '%s' "$BAR_NAME" | sha256sum) || exit 1
    geometry_file="$lock_dir/bar-${config_id%% *}-${bar_id%% *}.geometry"
    # The monitor the bar was last opened on; kept apart from the geometry
    # because a reload rewrites the geometry but never moves the bar.
    screen_file="${geometry_file%.geometry}.screen"
fi

case "$action" in
    start|open)   eww_start ;;
    stop|close)   eww_stop ;;
    toggle)       eww_toggle ;;
    reload)       eww_reload ;;
    ensure)       eww_ensure ;;
    redraw|refresh) eww_refresh ;;
    watch)        eww_watch ;;
    apply)        eww_apply ;;
    *)
        echo "Usage: bar-ctl [start|stop|toggle|reload|ensure|redraw|refresh|watch|apply] [bar]"
        exit 1
        ;;
esac

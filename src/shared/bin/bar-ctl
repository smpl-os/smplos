#!/bin/bash
# Native smpl-bar control entry point.

LOG="${XDG_STATE_HOME:-$HOME/.local/state}/smplos/bar-startup.log"
mkdir -p "${LOG%/*}" || exit 1

action="${1:-toggle}"
BAR_CONF="$HOME/.config/smplos/bar.conf"

bar_backend_error() {
    echo "bar-ctl: $*" | tee -a "$LOG" >&2
    return 1
}

bar_backend() {
    printf 'smpl-bar\n'
}

native_bar_cmd() {
    command -v smpl-bar >/dev/null 2>&1 || {
        bar_backend_error "smpl-bar not found; native bar delivery is incomplete"
        return 1
    }
    command smpl-bar "$@"
}

native_bar_preflight() {
    local key val ws_count=4 ws_position=left ws_spacing=1 ws_style=numbers
    local bar_edge=bottom bar_mode=pinned bar_margin=2
    local clock_format=time clock_24h=auto clock_date_fmt=auto
    local -A seen=()
    [[ ! -e "$BAR_CONF" || -f "$BAR_CONF" && -r "$BAR_CONF" ]] || {
        bar_backend_error "Cannot read $BAR_CONF"
        return 1
    }
    [[ ! -f "$BAR_CONF" ]] || {
        while IFS='=' read -r key val || [[ -n "$key" ]]; do
            key="${key#"${key%%[![:space:]]*}"}"
            key="${key%"${key##*[![:space:]]}"}"
            val="${val#"${val%%[![:space:]]*}"}"
            val="${val%"${val##*[![:space:]]}"}"
            [[ -z "$key" || "$key" == \#* ]] && continue
            case "$key" in
                ws_count|ws_position|ws_spacing|ws_style|clock_format|clock_24h|clock_date_fmt|bar_edge|bar_mode|bar_margin)
                    [[ -z "${seen[$key]:-}" ]] ||
                        { bar_backend_error "Duplicate $key"; return 1; }
                    seen[$key]=1
                    ;;
            esac
            case "$key" in
                ws_count) ws_count="$val" ;;
                ws_position) ws_position="$val" ;;
                ws_spacing) ws_spacing="$val" ;;
                ws_style) ws_style="$val" ;;
                clock_format) clock_format="$val" ;;
                clock_24h) clock_24h="$val" ;;
                clock_date_fmt) clock_date_fmt="$val" ;;
                bar_edge) bar_edge="$val" ;;
                bar_mode) bar_mode="$val" ;;
                bar_margin) bar_margin="$val" ;;
            esac
        done < "$BAR_CONF" || { bar_backend_error "Cannot read $BAR_CONF"; return 1; }
    }
    [[ "$ws_count" =~ ^([1-9]|10)$ ]] ||
        { bar_backend_error "Invalid ws_count: $ws_count (expected 1-10)"; return 1; }
    [[ "$ws_spacing" =~ ^([1-9]|10)$ ]] ||
        { bar_backend_error "Invalid ws_spacing: $ws_spacing (expected 1-10)"; return 1; }
    [[ "$ws_position" == center || "$ws_position" == left ]] ||
        { bar_backend_error "Invalid ws_position: $ws_position"; return 1; }
    [[ "$ws_style" == numbers || "$ws_style" == squares ]] ||
        { bar_backend_error "Invalid ws_style: $ws_style"; return 1; }
    [[ "$clock_format" == time || "$clock_format" == dow || "$clock_format" == date ]] ||
        { bar_backend_error "Invalid clock_format: $clock_format"; return 1; }
    [[ "$clock_24h" == auto || "$clock_24h" == true || "$clock_24h" == false ]] ||
        { bar_backend_error "Invalid clock_24h: $clock_24h"; return 1; }
    case "$clock_date_fmt" in auto|'M/D'|'D/M'|ISO|'Mon D') ;; *)
        bar_backend_error "Invalid clock_date_fmt: $clock_date_fmt"; return 1 ;; esac
    [[ "$bar_edge" == top || "$bar_edge" == bottom ||
       "$bar_edge" == left || "$bar_edge" == right ]] ||
        { bar_backend_error "Invalid bar_edge: $bar_edge"; return 1; }
    [[ "$bar_mode" == pinned || "$bar_mode" == floating ]] ||
        { bar_backend_error "Invalid bar_mode: $bar_mode"; return 1; }
    [[ "$bar_margin" =~ ^([0-9]|1[0-9]|2[0-4])$ ]] ||
        { bar_backend_error "Invalid bar_margin: $bar_margin (expected 0-24)"; return 1; }
}

native_bar_ready() {
    local status
    status=$(native_bar_cmd status 2>/dev/null) || return 1
    jq -e '
        (.compositor == "hyprland" or .compositor == "niri" or .compositor == "x11") and
        (if (.compositor == "hyprland" or .compositor == "niri") and
             .config.mode == "pinned"
         then .panel.active == true and .panel.transport == "wayland-layer-shell"
         else true
         end)
    ' >/dev/null <<< "$status"
}

native_bar_anchor() {
    local client layer status active previous address edge margin floating pinned x y width height
    [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || return 0
    client=$(hyprctl clients -j 2>/dev/null |
        jq -cer '[.[] | select(.class == "smpl-bar" and
                                (.title == "smpl-bar" or
                                 (.title | startswith("smpl-bar:panel-"))))][0]')
    layer=$(hyprctl layers -j 2>/dev/null |
        jq -cer '[.. | objects |
                  select(.namespace? == "smpl-bar-reservation")][0]')
    [[ -n "$client" && -n "$layer" ]] || return 0
    status=$(native_bar_cmd status 2>/dev/null) || return 0
    address=$(jq -r '.address' <<< "$client")
    edge=$(jq -r '.config.edge // "bottom"' <<< "$status")
    margin=$(jq -r '.config.margin // 2' <<< "$status")
    floating=$(jq -r '.floating // false' <<< "$client")
    pinned=$(jq -r '.pinned // false' <<< "$client")
    if [[ "$edge" == left || "$edge" == right ]]; then
        x=$(jq -r '.x' <<< "$layer")
        y=$(jq -r --argjson margin "$margin" '.y + $margin' <<< "$layer")
        width=$(jq -r '.w' <<< "$layer")
        height=$(jq -r --argjson margin "$margin" '.h - (2 * $margin)' <<< "$layer")
    else
        x=$(jq -r --argjson margin "$margin" '.x + $margin' <<< "$layer")
        y=$(jq -r '.y' <<< "$layer")
        width=$(jq -r --argjson margin "$margin" '.w - (2 * $margin)' <<< "$layer")
        height=$(jq -r '.h' <<< "$layer")
    fi
    [[ "$address" != null && "$width" -gt 0 && "$height" -gt 0 ]] || return 0
    if [[ "$floating" != true ]]; then
        hyprctl dispatch "hl.dsp.window.float({ window = \"address:$address\", action = \"toggle\" })" >/dev/null
    fi
    hyprctl dispatch "hl.dsp.window.resize({ window = \"address:$address\", x = $width, y = $height, relative = false })" >/dev/null
    if [[ "$pinned" != true ]]; then
        hyprctl dispatch "hl.dsp.window.pin({ window = \"address:$address\" })" >/dev/null
    fi
    hyprctl dispatch "hl.dsp.window.move({ window = \"address:$address\", x = $x, y = $y })" >/dev/null
    active=$(hyprctl activewindow -j 2>/dev/null) || active=""
    if [[ $(jq -r '.class // ""' <<< "${active:-null}" 2>/dev/null) == smpl-bar ]]; then
        previous=$(hyprctl clients -j 2>/dev/null |
            jq -cer '[.[] | select(.class != "smpl-bar" and
                                    .mapped == true and .hidden != true)]
                     | sort_by(.focusHistoryID)[0].address')
        [[ "$previous" != null && -n "$previous" ]] &&
            hyprctl dispatch "hl.dsp.focus({ window = \"address:$previous\" })" >/dev/null
    fi
}

native_bar_start() {
    local pid attempt
    if native_bar_cmd status >/dev/null 2>&1; then
        if native_bar_ready; then
            native_bar_cmd show
            return
        fi
        native_bar_cmd show || return
        for ((attempt=0; attempt<20; attempt++)); do
            if native_bar_ready; then
                return
            fi
            sleep 0.1
        done
        native_bar_cmd hide >/dev/null 2>&1 || true
        bar_backend_error "smpl-bar is ready but its panel transport is unavailable"
        return 1
    fi
    setsid smpl-bar --resident </dev/null >> "$LOG" 2>&1 &
    pid=$!
    native_bar_launch_cleanup() {
        kill "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
    }
    trap native_bar_launch_cleanup EXIT
    trap 'native_bar_launch_cleanup; exit 1' HUP INT TERM
    for ((attempt=0; attempt<100; attempt++)); do
        if native_bar_cmd status >/dev/null 2>&1; then
            if native_bar_cmd show; then
                for ((attempt=0; attempt<20; attempt++)); do
                    if native_bar_ready; then
                        trap - EXIT HUP INT TERM
                        return
                    fi
                    sleep 0.1
                done
                native_bar_cmd hide >/dev/null 2>&1 || true
                kill "$pid" 2>/dev/null || true
                wait "$pid" 2>/dev/null || true
                trap - EXIT HUP INT TERM
                bar_backend_error "smpl-bar IPC is ready but its panel transport is unavailable"
                return 1
            fi
            kill "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            bar_backend_error "smpl-bar became ready but could not show its window; see $LOG"
            return 1
        fi
        kill -0 "$pid" 2>/dev/null || {
            wait "$pid" 2>/dev/null || true
            # A successful handoff can leave the launcher short-lived while a
            # pre-existing resident owns IPC; verify once before declaring loss.
            if native_bar_cmd status >/dev/null 2>&1 &&
                native_bar_cmd show; then
                return
            fi
            bar_backend_error "smpl-bar resident exited before its IPC socket became ready; see $LOG"
            return 1
        }
        sleep 0.05
    done
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    trap - EXIT HUP INT TERM
    bar_backend_error "smpl-bar IPC did not become ready within five seconds; see $LOG"
    return 1
}

native_bar_ctl() {
    local status
    case "$action" in
        start|open) native_bar_preflight && native_bar_start && native_bar_anchor ;;
        stop|close) native_bar_cmd stop ;;
        toggle) native_bar_cmd toggle ;;
        reload|apply|redraw|refresh)
            native_bar_preflight || return
            native_bar_cmd apply
            status=$?
            native_bar_anchor
            # Slint may remap the native window after its theme files change.
            # Anchor once more after that asynchronous remap; otherwise the
            # window can briefly reappear at the compositor's default center.
            sleep 0.2
            native_bar_anchor
            return "$status"
            ;;
        ensure) native_bar_preflight && native_bar_start && native_bar_anchor ;;
        watch) return 0 ;; # smpl-bar owns a resident compositor event thread.
        status) native_bar_cmd status ;;
        identify|quit|kill|close-popups|telemetry-sample)
            native_bar_cmd "$action"
            ;;
        popup)
            shift
            native_bar_cmd popup "$@"
            ;;
        set-keypad-present)
            shift
            native_bar_cmd set-keypad-present "${1:?yes|no required}"
            ;;
        keypad-sheet)
            shift
            native_bar_cmd keypad-sheet "${1:--}"
            ;;
        *)
            echo "Usage: bar-ctl [start|stop|toggle|reload|ensure|redraw|refresh|watch|apply|status|identify|popup|close-popups|set-keypad-present|keypad-sheet|telemetry-sample] [arg]" >&2
            return 1
            ;;
    esac
}


if [[ "$action" == backend ]]; then
    bar_backend
    exit 0
fi

echo "$(date '+%Y-%m-%d %H:%M:%S') bar-ctl: action=$action config=$BAR_CONF" >> "$LOG"
native_bar_ctl "$@"

#!/bin/bash
# Bar control compatibility entry point (EWW by default, native smpl-bar opt-in)

LOG="${XDG_STATE_HOME:-$HOME/.local/state}/smplos/eww-startup.log"
mkdir -p "${LOG%/*}" || exit 1

action="${1:-toggle}"
EWW_CONFIG="$HOME/.config/eww"
BAR_NAME="${2:-bar}"
BAR_CONF="$HOME/.config/smplos/bar.conf"

bar_backend_error() {
    echo "bar-ctl: $*" | tee -a "$LOG" >&2
    return 1
}

# BAR_BACKEND is deliberately an environment override for side-by-side
# qualification. The compatible on-disk selector is backend=eww|smpl-bar.
bar_backend() {
    local selected="${BAR_BACKEND:-}" key val configured="" seen=0
    local effective="${XDG_RUNTIME_DIR:-/run/user/$UID}/smplos/bar.backend"
    if [[ -z "$selected" && "${SMPLOS_BAR_IGNORE_EFFECTIVE:-0}" != 1 &&
          -f "$effective" && -r "$effective" ]]; then
        IFS= read -r selected < "$effective" || true
    fi
    if [[ -z "$selected" ]]; then
        if [[ -e "$BAR_CONF" && ( ! -f "$BAR_CONF" || ! -r "$BAR_CONF" ) ]]; then
            bar_backend_error "Cannot read $BAR_CONF"
            return 1
        fi
        if [[ -f "$BAR_CONF" ]]; then
            while IFS='=' read -r key val || [[ -n "$key" ]]; do
                key="${key#"${key%%[![:space:]]*}"}"
                key="${key%"${key##*[![:space:]]}"}"
                val="${val#"${val%%[![:space:]]*}"}"
                val="${val%"${val##*[![:space:]]}"}"
                [[ "$key" == backend ]] || continue
                ((seen++))
                ((seen == 1)) || { bar_backend_error "Duplicate backend"; return 1; }
                configured="$val"
            done < "$BAR_CONF" || { bar_backend_error "Cannot read $BAR_CONF"; return 1; }
        fi
        selected="${configured:-eww}"
    fi
    case "$selected" in
        eww|smpl-bar) printf '%s\n' "$selected" ;;
        *) bar_backend_error "Invalid backend: $selected (expected eww or smpl-bar)" ;;
    esac
}

native_bar_cmd() {
    command -v smpl-bar >/dev/null 2>&1 || {
        bar_backend_error "smpl-bar not found; the selected native backend is unavailable"
        return 1
    }
    command smpl-bar "$@"
}

native_bar_preflight() {
    local key val ws_count=4 ws_position=left ws_spacing=1 ws_style=numbers
    local bar_edge=bottom bar_mode=pinned bar_margin=2
    local -A seen=()
    [[ ! -f "$BAR_CONF" ]] || {
        while IFS='=' read -r key val || [[ -n "$key" ]]; do
            key="${key#"${key%%[![:space:]]*}"}"
            key="${key%"${key##*[![:space:]]}"}"
            val="${val#"${val%%[![:space:]]*}"}"
            val="${val%"${val##*[![:space:]]}"}"
            [[ -z "$key" || "$key" == \#* ]] && continue
            case "$key" in
                ws_count|ws_position|ws_spacing|ws_style|bar_edge|bar_mode|bar_margin)
                    [[ -z "${seen[$key]:-}" ]] ||
                        { bar_backend_error "Duplicate $key"; return 1; }
                    seen[$key]=1
                    ;;
            esac
            case "$key" in
                ws_count) ws_count="$val" ;;
                ws_position) ws_position="$val" ;;
                ws_spacing) ws_spacing="$val" ;;
                ws_style) ws_style="$val" ;;
                bar_edge) bar_edge="$val" ;;
                bar_mode) bar_mode="$val" ;;
                bar_margin) bar_margin="$val" ;;
            esac
        done < "$BAR_CONF" || { bar_backend_error "Cannot read $BAR_CONF"; return 1; }
    }
    [[ "$ws_count" =~ ^([1-9]|10)$ ]] ||
        { bar_backend_error "Invalid ws_count: $ws_count (expected 1-10)"; return 1; }
    [[ "$ws_spacing" =~ ^([1-9]|10)$ ]] ||
        { bar_backend_error "Invalid ws_spacing: $ws_spacing (expected 1-10)"; return 1; }
    [[ "$ws_position" == center || "$ws_position" == left ]] ||
        { bar_backend_error "Invalid ws_position: $ws_position"; return 1; }
    [[ "$ws_style" == numbers || "$ws_style" == squares ]] ||
        { bar_backend_error "Invalid ws_style: $ws_style"; return 1; }
    [[ "$bar_edge" == top || "$bar_edge" == bottom ]] ||
        { bar_backend_error "Invalid bar_edge: $bar_edge"; return 1; }
    [[ "$bar_mode" == pinned || "$bar_mode" == floating ]] ||
        { bar_backend_error "Invalid bar_mode: $bar_mode"; return 1; }
    [[ "$bar_margin" =~ ^([0-9]|1[0-9]|2[0-4])$ ]] ||
        { bar_backend_error "Invalid bar_margin: $bar_margin (expected 0-24)"; return 1; }
}

native_bar_ready() {
    local status
    status=$(native_bar_cmd status 2>/dev/null) || return 1
    jq -e '
        (.compositor == "hyprland" or .compositor == "niri" or .compositor == "x11") and
        (if (.compositor == "hyprland" or .compositor == "niri") and
             .config.mode == "pinned"
         then .panel.active == true and .panel.transport == "wayland-layer-shell"
         else true
         end)
    ' >/dev/null <<< "$status"
}

native_bar_anchor() {
    local client layer status active previous address edge margin client_height pinned x y width height
    [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || return 0
    client=$(hyprctl clients -j 2>/dev/null |
        jq -cer '[.[] | select(.class == "smpl-bar" and
                                (.title == "smpl-bar" or
                                 (.title | startswith("smpl-bar:panel-"))))][0]')
    layer=$(hyprctl layers -j 2>/dev/null |
        jq -cer '[.. | objects |
                  select(.namespace? == "smpl-bar-reservation")][0]')
    [[ -n "$client" && -n "$layer" ]] || return 0
    status=$(native_bar_cmd status 2>/dev/null) || return 0
    address=$(jq -r '.address' <<< "$client")
    edge=$(jq -r '.config.edge // "bottom"' <<< "$status")
    margin=$(jq -r '.config.margin // 2' <<< "$status")
    client_height=$(jq -r '.size[1] // 24' <<< "$client")
    pinned=$(jq -r '.pinned // false' <<< "$client")
    x=$(jq -r --argjson margin "$margin" '.x + $margin' <<< "$layer")
    if [[ "$edge" == top ]]; then
        y=$(jq -r '.y' <<< "$layer")
    else
        y=$(jq -r --argjson height "$client_height" '.y + .h - $height' <<< "$layer")
    fi
    width=$(jq -r --argjson margin "$margin" '.w - (2 * $margin)' <<< "$layer")
    height=$(jq -r '.h' <<< "$layer")
    [[ "$address" != null && "$width" -gt 0 && "$height" -gt 0 ]] || return 0
    hyprctl dispatch "hl.dsp.window.resize({ window = \"address:$address\", x = $width, y = $height, relative = false })" >/dev/null
    if [[ "$pinned" != true ]]; then
        hyprctl dispatch "hl.dsp.window.pin({ window = \"address:$address\" })" >/dev/null
    fi
    hyprctl dispatch "hl.dsp.window.move({ window = \"address:$address\", x = $x, y = $y })" >/dev/null
    active=$(hyprctl activewindow -j 2>/dev/null) || active=""
    if [[ $(jq -r '.class // ""' <<< "${active:-null}" 2>/dev/null) == smpl-bar ]]; then
        previous=$(hyprctl clients -j 2>/dev/null |
            jq -cer '[.[] | select(.class != "smpl-bar" and
                                    .mapped == true and .hidden != true)]
                     | sort_by(.focusHistoryID)[0].address')
        [[ "$previous" != null && -n "$previous" ]] &&
            hyprctl dispatch "hl.dsp.focus({ window = \"address:$previous\" })" >/dev/null
    fi
}

native_bar_start() {
    local pid attempt
    if native_bar_cmd status >/dev/null 2>&1; then
        if native_bar_ready; then
            native_bar_cmd show
            return
        fi
        native_bar_cmd show || return
        for ((attempt=0; attempt<20; attempt++)); do
            if native_bar_ready; then
                return
            fi
            sleep 0.1
        done
        native_bar_cmd hide >/dev/null 2>&1 || true
        bar_backend_error "smpl-bar is ready but its panel transport is unavailable; keeping the EWW fallback"
        return 1
    fi
    setsid smpl-bar --resident </dev/null >> "$LOG" 2>&1 &
    pid=$!
    native_bar_launch_cleanup() {
        kill "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
    }
    trap native_bar_launch_cleanup EXIT
    trap 'native_bar_launch_cleanup; exit 1' HUP INT TERM
    for ((attempt=0; attempt<100; attempt++)); do
        if native_bar_cmd status >/dev/null 2>&1; then
            if native_bar_cmd show; then
                for ((attempt=0; attempt<20; attempt++)); do
                    if native_bar_ready; then
                        trap - EXIT HUP INT TERM
                        return
                    fi
                    sleep 0.1
                done
                native_bar_cmd hide >/dev/null 2>&1 || true
                kill "$pid" 2>/dev/null || true
                wait "$pid" 2>/dev/null || true
                trap - EXIT HUP INT TERM
                bar_backend_error "smpl-bar IPC is ready but its panel transport is unavailable; keeping the EWW fallback"
                return 1
            fi
            kill "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            bar_backend_error "smpl-bar became ready but could not show its window; see $LOG"
            return 1
        fi
        kill -0 "$pid" 2>/dev/null || {
            wait "$pid" 2>/dev/null || true
            # A successful handoff can leave the launcher short-lived while a
            # pre-existing resident owns IPC; verify once before declaring loss.
            if native_bar_cmd status >/dev/null 2>&1 &&
                native_bar_cmd show; then
                return
            fi
            bar_backend_error "smpl-bar resident exited before its IPC socket became ready; see $LOG"
            return 1
        }
        sleep 0.05
    done
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    trap - EXIT HUP INT TERM
    bar_backend_error "smpl-bar IPC did not become ready within five seconds; see $LOG"
    return 1
}

native_bar_ctl() {
    local status
    case "$action" in
        start|open) native_bar_preflight && native_bar_start && native_bar_anchor ;;
        stop|close) native_bar_cmd stop ;;
        toggle) native_bar_cmd toggle ;;
        reload|apply|redraw|refresh)
            native_bar_preflight || return
            native_bar_cmd apply
            status=$?
            native_bar_anchor
            return "$status"
            ;;
        ensure) native_bar_preflight && native_bar_start && native_bar_anchor ;;
        watch) return 0 ;; # smpl-bar owns a resident compositor event thread.
        status) native_bar_cmd status ;;
        identify|quit|kill|close-popups|telemetry-sample)
            native_bar_cmd "$action"
            ;;
        popup)
            shift
            native_bar_cmd popup "$@"
            ;;
        set-keypad-present)
            shift
            native_bar_cmd set-keypad-present "${1:?yes|no required}"
            ;;
        keypad-sheet)
            shift
            native_bar_cmd keypad-sheet "${1:--}"
            ;;
        *)
            echo "Usage: bar-ctl [start|stop|toggle|reload|ensure|redraw|refresh|watch|apply|status|identify|popup|close-popups|set-keypad-present|keypad-sheet|telemetry-sample] [arg]" >&2
            return 1
            ;;
    esac
}

selected_backend=$(bar_backend) || exit 1
if [[ "$action" == backend ]]; then
    printf '%s\n' "$selected_backend"
    exit 0
fi
echo "$(date '+%Y-%m-%d %H:%M:%S') bar-ctl: backend=$selected_backend action=$action bar=$BAR_NAME config=$EWW_CONFIG" >> "$LOG"
if [[ "$selected_backend" == smpl-bar ]]; then
    native_bar_ctl "$@"
    exit $?
fi

if ! command -v eww &>/dev/null; then
    echo "Error: eww not found" | tee -a "$LOG" >&2
    exit 1
fi

# Verify config files exist
for f in eww.yuck eww.scss theme-colors.scss; do
    if [[ ! -f "$EWW_CONFIG/$f" ]]; then
        echo "Warning: $EWW_CONFIG/$f not found" | tee -a "$LOG" >&2
    fi
done

# Ensure EWW listener scripts are executable
find "$EWW_CONFIG/scripts" -name '*.sh' ! -perm -u+x -exec chmod +x {} \; 2>/dev/null

eww_cmd() {
    # A newly spawned daemon must not inherit the lifecycle lock.
    eww --config "$EWW_CONFIG" "$@" 8>&- 9>&-
}

# The primary monitor owns workspace 1 under the stable workspace policy. It is
# empty without that policy (or off Hyprland), so the bar keeps EWW's default.
eww_primary() {
    workspace-ctl primary 2>/dev/null || true
}

# Open the bar on the primary monitor, or on EWW's default when the primary is
# unknown or not addressable yet. bar_screen records where it actually landed,
# so a bar that fell back is moved by the next refresh instead of staying put.
bar_screen=""
eww_open() {
    local primary=$1
    shift
    bar_screen=""
    if [[ -n "$primary" ]] && eww_cmd open "$BAR_NAME" "$@" --screen "$primary" >> "$LOG" 2>&1; then
        bar_screen=$primary
        return 0
    fi
    eww_cmd open "$BAR_NAME" "$@" >> "$LOG" 2>&1
}

eww_geometry() {
    if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
        printf '%s\n' unsupported
        return
    fi
    local monitors
    monitors=$(hyprctl -j monitors) &&
        jq -ce 'select(type == "array" and length > 0)
            | map({name, width, height, scale, transform, x, y}) | sort_by(.name)' <<< "$monitors" ||
        { echo "Error: cannot read monitor geometry" | tee -a "$LOG" >&2; return 1; }
}

eww_stale_pid() {
    local pid executable config candidate i daemon fd socket
    local -a args
    executable=$(command -v eww) || return 1
    config=$(realpath -m "$EWW_CONFIG") || return 1
    while read -r pid; do
        [[ -r "/proc/$pid/cmdline" ]] || continue
        mapfile -d '' -t args < "/proc/$pid/cmdline" || continue
        candidate="$HOME/.config/eww"
        daemon=0
        for ((i=1; i<${#args[@]}; i++)); do
            case "${args[i]}" in
                daemon|open|open-many) daemon=1 ;;
                --config|-c) candidate="${args[i+1]:-}"; ((i++)) ;;
                --config=*) candidate="${args[i]#*=}" ;;
            esac
        done
        [[ $daemon == 1 && -n "$candidate" ]] || continue
        [[ "$(realpath -m "$candidate")" == "$config" ]] || continue
        if [[ ! "$executable" -ef "/proc/$pid/exe" ]]; then
            # Auto-started daemons retain the original "open" argv. Require
            # a listening socket so an old transient client cannot match.
            for fd in "/proc/$pid/fd/"*; do
                socket=$(readlink "$fd") || continue
                [[ "$socket" == socket:\[*\] ]] || continue
                socket="${socket#socket:[}"
                socket="${socket%]}"
                if awk -v inode="$socket" '$7 == inode && $4 == "00010000" { found=1 }
                        END { exit !found }' /proc/net/unix; then
                    printf '%s\n' "$pid"
                    return
                fi
            done
        fi
    done < <(pgrep -u "$UID" -x eww)
}

eww_start() {
    # Let EWW handle daemon spawning itself — running 'eww open' on a
    # non-running daemon auto-starts one. This avoids the race condition
    # where a separate 'eww daemon' + 'eww open' could spawn two daemons
    # if the IPC socket wasn't ready between the two commands.
    local geometry primary
    geometry=$(eww_geometry) || return 1
    primary=$(eww_primary)
    echo "$(date '+%H:%M:%S') Opening: $BAR_NAME on ${primary:-the default monitor}" >> "$LOG"
    eww_open "$primary" || return

    # Apply saved bar settings (workspace count, position, etc.)
    eww_apply || return

    echo "$(date '+%H:%M:%S') Active windows:" >> "$LOG"
    eww_cmd active-windows >> "$LOG" 2>&1 || return
    printf '%s\n' "$geometry" > "$geometry_file" || return
    printf '%s\n' "$bar_screen" > "$screen_file" || return

    # Start the geometry watcher so the bar recomputes its width whenever the
    # monitor scale/resolution changes (Settings -> Display, hot-plug, etc.).
    if ! pgrep -f "bar-ctl watch" >/dev/null 2>&1; then
        setsid "$0" watch "$BAR_NAME" 8>&- 9>&- >/dev/null 2>&1 &
    fi

    # One-shot recompute shortly after boot: the bar may open before the final
    # monitor scale is applied, leaving it centred/too-narrow.  Redrawing once
    # the layout has settled snaps it back to the correct full width.
    ( sleep 2; "$0" refresh "$BAR_NAME" ) 8>&- 9>&- >/dev/null 2>&1 &

    echo "$(date '+%H:%M:%S') bar-ctl start complete" >> "$LOG"
}
eww_stop() {
    eww_cmd close "$BAR_NAME" 2>/dev/null
}

# Force the bar to recompute its geometry (percentage widths are resolved
# against the monitor only at open time, so a close+reopen is the reliable
# way to pick up a new scale/resolution) and to move to the given primary.
eww_redraw() {
    local primary=$1 geometry
    geometry=$(eww_geometry) || return 1
    eww_cmd close "$BAR_NAME" 2>/dev/null
    sleep 0.3
    eww_open "$primary" || return
    eww_apply || return
    printf '%s\n' "$geometry" > "$geometry_file" || return
    printf '%s\n' "$bar_screen" > "$screen_file" || return
    echo "$(date '+%H:%M:%S') bar-ctl redraw complete" >> "$LOG"
}

eww_refresh() {
    local geometry primary previous="" screen=""
    geometry=$(eww_geometry) || return 1
    primary=$(eww_primary)
    [[ ! -f "$geometry_file" ]] || previous=$(<"$geometry_file")
    [[ ! -f "$screen_file" ]] || screen=$(<"$screen_file")
    if [[ "$geometry" == unsupported || "$geometry" != "$previous" || "$primary" != "$screen" ]]; then
        eww_redraw "$primary"
    fi
}

# Background daemon: listen on Hyprland's IPC socket2 and redraw the bar on any
# event that can change the monitor geometry (scale change via config reload,
# monitor hot-plug/unplug).  A short settle delay lets Hyprland finish applying
# the new layout before we recompute.
eww_watch() {
    local sock="${XDG_RUNTIME_DIR}/hypr/${HYPRLAND_INSTANCE_SIGNATURE}/.socket2.sock"
    [[ -S "$sock" ]] || return 0
    command -v socat &>/dev/null || return 0
    echo "$(date '+%H:%M:%S') bar-ctl watch started" >> "$LOG"
    socat -u "UNIX-CONNECT:$sock" - 2>/dev/null \
    | while IFS= read -r line; do
        case "${line%%>>*}" in
            monitoradded|monitoraddedv2|monitorremoved|configreloaded)
                sleep 1
                "$0" refresh "$BAR_NAME"
                ;;
        esac
    done
}
eww_toggle() {
    local primary
    primary=$(eww_primary)
    if [[ -n "$primary" ]] && eww_cmd open --toggle "$BAR_NAME" --screen "$primary" 2>/dev/null; then
        printf '%s\n' "$primary" > "$screen_file"
        return
    fi
    eww_cmd open --toggle "$BAR_NAME" || return
    [[ -z "$primary" ]] || printf '\n' > "$screen_file"
}
eww_reload() {
    local stale geometry
    geometry=$(eww_geometry) || return 1
    stale=$(eww_stale_pid)
    if [[ -n "$stale" ]]; then
        # Validate without opening windows or running deflisten/defpoll scripts.
        eww_cmd check-config || return
        echo "$(date '+%H:%M:%S') Activating replaced EWW binary (pid $stale)" >> "$LOG"
        eww_cmd kill || return
        local attempt
        for ((attempt=0; attempt<100; attempt++)); do
            if [[ ! -e "/proc/$stale/exe" ]]; then
                eww_start
                return
            fi
            sleep 0.05
        done
        echo "Error: old EWW daemon did not exit; see $LOG" >&2
        return 1
    fi
    eww_cmd reload || return
    # eww reload resets all defvar to defaults — re-apply saved settings
    sleep 0.3
    eww_apply || return
    printf '%s\n' "$geometry" > "$geometry_file"
}

eww_ensure() {
    local windows
    if ! windows=$(eww_cmd active-windows) ||
        ! awk -F: -v name="$BAR_NAME" '$1 == name { found=1 } END { exit !found }' <<< "$windows"; then
        eww_start || return 1
    else
        eww_apply || return 1
    fi
    windows=$(eww_cmd active-windows) || return 1
    if ! awk -F: -v name="$BAR_NAME" '$1 == name { found=1 } END { exit !found }' <<< "$windows"; then
        echo "Error: $BAR_NAME is still absent after recovery; see $LOG" >&2
        return 1
    fi
}

# Apply bar settings from ~/.config/smplos/bar.conf to running EWW instance.
# File format: literal KEY=VALUE (not sourced as shell). Supported keys:
#   ws_count    = 1-10   (total workspace slots, default 4)
#   ws_position = center | left  (where workspaces live, default center)
#   ws_spacing  = 1-10   (pixel gap, default 1)
#   ws_style    = numbers | squares (default numbers)
apply_error() {
    echo "bar-ctl apply: $*" | tee -a "$LOG" >&2
    return 1
}

eww_apply() {
    local conf="$HOME/.config/smplos/bar.conf"
    local ws_count=4
    local ws_position="center"
    local ws_spacing=1
    local ws_style="numbers"
    local key val
    local -A seen=()

    if [[ -e "$conf" && ( ! -f "$conf" || ! -r "$conf" ) ]]; then
        apply_error "Cannot read $conf"
        return 1
    fi
    if [[ -f "$conf" ]]; then
        while IFS='=' read -r key val || [[ -n "$key" ]]; do
            key="${key#"${key%%[![:space:]]*}"}"
            key="${key%"${key##*[![:space:]]}"}"
            val="${val#"${val%%[![:space:]]*}"}"
            val="${val%"${val##*[![:space:]]}"}"
            [[ -z "$key" || "$key" == \#* ]] && continue
            case "$key" in
                ws_count|ws_position|ws_spacing|ws_style)
                    [[ -z "${seen[$key]:-}" ]] || { apply_error "Duplicate $key"; return 1; }
                    seen[$key]=1
                    ;;
            esac
            case "$key" in
                ws_count)    ws_count="$val" ;;
                ws_position) ws_position="$val" ;;
                ws_spacing)  ws_spacing="$val" ;;
                ws_style)    ws_style="$val" ;;
            esac
        done < "$conf" || { apply_error "Cannot read $conf"; return 1; }
    fi

    [[ "$ws_count" =~ ^([1-9]|10)$ ]] || { apply_error "Invalid ws_count: $ws_count (expected 1-10)"; return 1; }
    [[ "$ws_spacing" =~ ^([1-9]|10)$ ]] || { apply_error "Invalid ws_spacing: $ws_spacing (expected 1-10)"; return 1; }
    [[ "$ws_position" == center || "$ws_position" == left ]] || { apply_error "Invalid ws_position: $ws_position"; return 1; }
    [[ "$ws_style" == numbers || "$ws_style" == squares ]] || { apply_error "Invalid ws_style: $ws_style"; return 1; }

    # The workspace listener reconciles count changes from bar.conf itself.
    # Presentation-only changes must not force a policy reload or move focus.
    if ! eww_cmd update ws-count="$ws_count" ws-position="$ws_position" \
            ws-spacing="$ws_spacing" ws-style="$ws_style"; then
        apply_error "EWW update failed; saved preferences have not been applied"
        return 1
    fi
    echo "$(date '+%H:%M:%S') bar-ctl apply: ws_count=$ws_count ws_position=$ws_position ws_spacing=$ws_spacing ws_style=$ws_style" >> "$LOG"
}

# All entrypoints, including geometry redraws, share one config-scoped lock.
if [[ "$action" != watch ]]; then
    lock_dir="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/smplos"
    config_path=$(realpath -m "$EWW_CONFIG") || exit 1
    config_id=$(printf '%s' "$config_path" | sha256sum) || exit 1
    mkdir -p "$lock_dir" || exit 1
    exec 9>"$lock_dir/bar-${config_id%% *}.lock" || exit 1
    flock 9 || exit 1
    bar_id=$(printf '%s' "$BAR_NAME" | sha256sum) || exit 1
    geometry_file="$lock_dir/bar-${config_id%% *}-${bar_id%% *}.geometry"
    # The monitor the bar was last opened on; kept apart from the geometry
    # because a reload rewrites the geometry but never moves the bar.
    screen_file="${geometry_file%.geometry}.screen"
fi

case "$action" in
    start|open)   eww_start ;;
    stop|close)   eww_stop ;;
    toggle)       eww_toggle ;;
    reload)       eww_reload ;;
    ensure)       eww_ensure ;;
    redraw|refresh) eww_refresh ;;
    watch)        eww_watch ;;
    apply)        eww_apply ;;
    set-keypad-present)
        eww_cmd update "keypad-present=${2:-no}"
        ;;
    keypad-sheet)
        [[ $# -ge 2 ]] || { echo "Usage: bar-ctl keypad-sheet FILE|JSON|-" >&2; exit 1; }
        sheet=$2
        [[ "$sheet" != "-" ]] || IFS= read -r sheet
        eww_cmd update "pad_sheet=$sheet"
        ;;
    *)
        echo "Usage: bar-ctl [start|stop|toggle|reload|ensure|redraw|refresh|watch|apply] [bar]"
        exit 1
        ;;
esac

#!/bin/bash
# smplOS: Toggle a messenger window — show/hide floating in the bottom-right corner.
# Works for native apps (Signal, Telegram) and webapps (brave-discord, brave-teams).
#
# Usage: toggle-messenger <window-class> [launch-command...]
#
# Behavior:
#   - Window doesn't exist  → launch it (window rules handle positioning)
#   - Window visible         → hide to special:messenger_<class>
#   - Window hidden          → bring back to current workspace, reposition
# Hyprland toggles use the focused monitor and restore the prior window on hide.
#
# The window is floated, sized phone-like (480x720), and pinned to bottom-right
# with a gap above the bar. Under a HUD theme the plugin then moves it further in
# (hyprctl smplhud fit), so the frame it draws round the window is not cut off.

set -euo pipefail

CLASS="${1:?Usage: toggle-messenger <window-class> [launch-command...]}"
shift
LAUNCH_CMD=("$@")

# Sanitize class for special workspace name (no dots/slashes)
WS_NAME="messenger_${CLASS//[^a-zA-Z0-9_-]/_}"

# Messenger window geometry
WIDTH=480
HEIGHT=720
MARGIN_RIGHT=2
MARGIN_BOTTOM=34  # 30px bar + 2px offset + 2px gap (matches notif-center)

# ============================================================================
# niri branch — short-circuit when running under niri.
#
# niri has no "special workspaces" that auto-hide from overview/alt-tab; we
# use a named workspace "scratchpad" (declared in config.kdl) purely as a
# stash. The user should NEVER feel they're "on the scratchpad" — these
# rules guarantee it:
#
#   1) Window on user's current REAL workspace → hide (move to scratchpad).
#   2) Anywhere else (scratchpad OR other workspace,
#      AND regardless of whether the user is currently focused on
#      scratchpad) → bring window to a REAL workspace and focus there.
#
# Rule 2 has two sub-paths:
#   - If user is currently focused on scratchpad (e.g. they alt-tabbed /
#     overview-clicked into it), first jump to their previous real
#     workspace (focus-workspace-previous), then move the window there.
#   - Otherwise just move the window to their focused workspace.
#
# Result: a single press of Signal's shortcut puts it where you are,
# and a second press always tucks it away. You never get "stranded" on the
# scratchpad.
# ============================================================================
if [[ -n "${NIRI_SOCKET:-}" ]] && command -v niri >/dev/null 2>&1; then
  NIRI_SCRATCH="scratchpad"

  # Find an open window whose app_id matches CLASS (case-insensitive substring).
  win_json=$(niri msg --json windows 2>/dev/null \
    | jq -e --arg c "$CLASS" \
      '[.[] | select((.app_id // "") | ascii_downcase | contains($c | ascii_downcase))] | first // empty' \
    2>/dev/null) || true

  if [[ -z "$win_json" ]]; then
    # Not running → launch it. niri window-rules apply on open.
    if [[ ${#LAUNCH_CMD[@]} -gt 0 ]]; then
      setsid -f "${LAUNCH_CMD[@]}" >/dev/null 2>&1
    else
      name="${CLASS%.desktop}"
      launched=0
      for dir in "$HOME/.local/share/applications" "/usr/local/share/applications" "/usr/share/applications"; do
        if [[ -f "$dir/${name}.desktop" ]]; then
          setsid -f gtk-launch "$name" >/dev/null 2>&1
          launched=1
          break
        fi
      done
      [[ $launched -eq 0 ]] && setsid -f "$CLASS" >/dev/null 2>&1
    fi
    exit 0
  fi

  win_id=$(echo "$win_json" | jq -r '.id')
  win_ws_id=$(echo "$win_json" | jq -r '.workspace_id')

  win_ws_name=$(niri msg --json workspaces \
    | jq -r --argjson i "$win_ws_id" '.[] | select(.id == $i) | .name // ""')

  focused=$(niri msg --json workspaces | jq -c '.[] | select(.is_focused) | {id, name, idx}')
  focused_ws_id=$(echo "$focused" | jq -r '.id')
  focused_ws_name=$(echo "$focused" | jq -r '.name // ""')

  # Helper: resolve a workspace ref (name preferred, idx fallback) for a
  # given focused-json blob into a single token niri accepts.
  _ws_target_from() {
    local blob="$1"
    local n
    n=$(echo "$blob" | jq -r '.name // ""')
    if [[ -n "$n" && "$n" != "null" ]]; then
      printf '%s' "$n"
    else
      echo "$blob" | jq -r '.idx'
    fi
  }

  if [[ "$win_ws_id" == "$focused_ws_id" && "$focused_ws_name" != "$NIRI_SCRATCH" ]]; then
    # Rule 1: visible on user's current real workspace → hide.
    niri msg action move-window-to-workspace --window-id "$win_id" --focus false "$NIRI_SCRATCH" >/dev/null 2>&1 || true
  else
    # Rule 2: bring window to a real workspace where the user is (or will be).
    if [[ "$focused_ws_name" == "$NIRI_SCRATCH" ]]; then
      # User is stranded on scratchpad — escape to previous real workspace first.
      niri msg action focus-workspace-previous >/dev/null 2>&1 || true
      sleep 0.05
      # If history sent us back to scratchpad anyway, pick first non-scratchpad ws.
      new_focused=$(niri msg --json workspaces | jq -c '.[] | select(.is_focused) | {id, name, idx}')
      new_focused_name=$(echo "$new_focused" | jq -r '.name // ""')
      if [[ "$new_focused_name" == "$NIRI_SCRATCH" ]]; then
        # No named workspaces besides scratchpad — pick the first
        # non-scratchpad workspace by idx instead.
        fallback=$(niri msg --json workspaces \
          | jq -r --arg s "$NIRI_SCRATCH" \
            'first(.[] | select(.name != $s) | .idx) // empty')
        if [[ -n "$fallback" ]]; then
          niri msg action focus-workspace "$fallback" >/dev/null 2>&1 || true
          sleep 0.05
          new_focused=$(niri msg --json workspaces | jq -c '.[] | select(.is_focused) | {id, name, idx}')
        fi
      fi
      target=$(_ws_target_from "$new_focused")
    else
      target=$(_ws_target_from "$focused")
    fi
    niri msg action move-window-to-workspace --window-id "$win_id" "$target" >/dev/null 2>&1 || true
  fi
  exit 0
fi

# ============================================================================
# Hyprland branch.
# ============================================================================

# Compute pixel position from active monitor
# POS_X / POS_Y  = monitor-relative  (for exec [move ...] and windowrules)
# ABS_X / ABS_Y  = compositor-absolute (for movewindowpixel exact)
POS_X=0
POS_Y=0
ABS_X=0
ABS_Y=0
TARGET_WORKSPACE=""
TARGET_MONITOR=""

fail() {
  echo "toggle-messenger: $*" >&2
  exit 1
}

hypr_dispatch() {
  local reply
  reply=$(hyprctl dispatch "$1") || fail "Hyprland window action failed"
  [[ "$reply" == ok ]] || fail "Hyprland rejected the window action: $reply"
}

evacuate_workspace_aliens() {
  local target_addr="${1:-}" cur_ws addrs addr
  cur_ws=$(hyprctl activeworkspace -j | jq -er '.id | numbers') \
    || fail "Cannot determine a workspace for recovered windows"

  addrs=$(hyprctl -j clients \
    | jq -r --arg ws "special:${WS_NAME}" --arg target "$target_addr" \
      '.[] | select(.workspace.name == $ws and .address != $target) | .address') \
    || fail "Cannot query stashed windows"

  while IFS= read -r addr; do
    [[ -n "$addr" ]] || continue
    [[ "$addr" =~ ^0x[[:xdigit:]]+$ ]] || fail "Invalid stashed window address"
    hypr_dispatch "hl.dsp.window.move({window='address:${addr}', workspace='${cur_ws}', silent=true})"
  done <<< "$addrs"
}

calc_position() {
  local mon_json
  # The pointer can remain on another output after keyboard focus changes.
  # Derive both placement and workspace from the same focused monitor.
  if [[ -f "$HOME/.config/smplos/workspace-policy.enabled" ]]; then
    mon_json=$(workspace-ctl monitor) || fail "Cannot determine the keyboard-focused monitor"
  else
    mon_json=$(hyprctl -j monitors 2>/dev/null | jq -e '
      first(.[] | select(.focused))' 2>/dev/null) \
      || fail "Cannot determine the focused monitor"
  fi
  TARGET_WORKSPACE=$(jq -er '.activeWorkspace.id | numbers' <<< "$mon_json") \
    || fail "Cannot determine the focused workspace"
  TARGET_MONITOR=$(jq -er '.id | numbers' <<< "$mon_json") \
    || fail "Cannot determine the focused monitor identity"
  local mon_w mon_h mon_x mon_y scale transform
  mon_w=$(echo "$mon_json" | jq -r '.width')
  mon_h=$(echo "$mon_json" | jq -r '.height')
  mon_x=$(echo "$mon_json" | jq -r '.x')
  mon_y=$(echo "$mon_json" | jq -r '.y')
  scale=$(echo "$mon_json" | jq -r '.scale')
  transform=$(echo "$mon_json" | jq -r '.transform')
  # Rotated monitors (transform 1/3/5/7 = 90°/270°) report their physical mode
  # in .width/.height, but the on-screen logical extent has the axes swapped.
  # Without this, a portrait (rotated) monitor gets width/height mixed up and
  # the window lands off-screen — it "flies by and disappears".
  if (( transform % 2 == 1 )); then
    local _swap=$mon_w; mon_w=$mon_h; mon_h=$_swap
  fi
  # Effective resolution accounts for scaling
  local eff_w eff_h
  eff_w=$(awk "BEGIN { printf \"%d\", ${mon_w}/${scale} }")
  eff_h=$(awk "BEGIN { printf \"%d\", ${mon_h}/${scale} }")
  # Clamp height to fit the monitor (bar gap + 2px top margin); never exceed it.
  local max_h=$(( eff_h - MARGIN_BOTTOM - 2 ))
  (( HEIGHT > max_h )) && HEIGHT=$max_h
  # Monitor-relative position (for exec [move ...] which is relative to the
  # window's monitor).
  POS_X=$(( eff_w - WIDTH - MARGIN_RIGHT ))
  POS_Y=$(( eff_h - HEIGHT - MARGIN_BOTTOM ))
  # Absolute compositor position (for movewindowpixel exact).
  ABS_X=$(( mon_x + POS_X ))
  ABS_Y=$(( mon_y + POS_Y ))
}

remember_focus() {
  local active clients
  active=$(hyprctl -j activewindow) || fail "Cannot query the current window"
  if jq -e --arg messenger "${addr:-}" --argjson workspace "$TARGET_WORKSPACE" \
    --argjson monitor "$TARGET_MONITOR" '
      .address != $messenger and (.address // "") != ""
      and .workspace.id == $workspace and .monitor == $monitor
      and .mapped != false and .hidden != true' <<< "$active" >/dev/null; then
    jq -c '{address, workspace: .workspace.id, monitor}' <<< "$active" > "$FOCUS_STATE.tmp" \
      || fail "Cannot remember the current window"
  else
    # Notification activation can focus the stashed messenger before the toggle.
    # Recover the underlying workspace's MRU, not clients' arbitrary list order.
    clients=$(hyprctl -j clients) || fail "Cannot query window focus history"
    jq -c --arg messenger "${addr:-}" --argjson workspace "$TARGET_WORKSPACE" \
      --argjson monitor "$TARGET_MONITOR" '
        [.[] | select(.address != $messenger
          and .workspace.id == $workspace and .monitor == $monitor
          and .mapped != false and .hidden != true
          and (.focusHistoryID | type) == "number" and .focusHistoryID >= 0)]
        | sort_by(.focusHistoryID) | first
        | {address: (.address // ""), workspace: $workspace, monitor: $monitor}
      ' <<< "$clients" > "$FOCUS_STATE.tmp" \
      || fail "Cannot remember the previous window"
  fi
  mv -f "$FOCUS_STATE.tmp" "$FOCUS_STATE" \
    || fail "Cannot remember the current window"
}

return_focus_target() {
  local active saved clients
  active=$(hyprctl -j activewindow) || fail "Cannot query the focused window"
  [[ "$(jq -r '.address // ""' <<< "$active")" == "$addr" ]] || return 0
  if [[ ! -f "$FOCUS_STATE" ]] || jq -e --arg messenger "$addr" \
    '.address == $messenger or .workspace < 0' "$FOCUS_STATE" >/dev/null; then
    calc_position
    remember_focus
  fi
  saved=$(jq -ec '.' "$FOCUS_STATE") || fail "Invalid saved focus state"
  clients=$(hyprctl -j clients) || fail "Cannot query the previous window"
  jq -r --argjson saved "$saved" --argjson active "$active" '
    first(.[] | select(.address == $saved.address
      and .workspace.id == $saved.workspace
      and .workspace.id == $active.workspace.id
      and .monitor == $saved.monitor
      and .mapped != false)) | .address // empty' <<< "$clients"
}

restore_focus() {
  local target="$1" saved monitors clients
  [[ -n "$target" ]] || return 0
  [[ "$target" =~ ^0x[[:xdigit:]]+$ ]] || fail "Invalid saved window address"
  saved=$(jq -ec '.' "$FOCUS_STATE") || fail "Invalid saved focus state"
  monitors=$(hyprctl -j monitors) || fail "Cannot query monitor state"
  # Do not reopen a workspace the user switched away from, or disturb another
  # special workspace opened while the messenger was being dismissed.
  jq -e --argjson saved "$saved" 'any(.[];
    .id == $saved.monitor and .activeWorkspace.id == $saved.workspace
    and (.specialWorkspace.id // 0) == 0)' <<< "$monitors" >/dev/null || return 0
  clients=$(hyprctl -j clients) || fail "Cannot query the previous window"
  jq -e --arg target "$target" --argjson saved "$saved" 'any(.[];
    .address == $target and .workspace.id == $saved.workspace
    and .monitor == $saved.monitor and .mapped != false)' <<< "$clients" >/dev/null || return 0
  hypr_dispatch "hl.dsp.focus({window='address:${target}'})"
}

# Serialize invocations. A single Super+Shift+S can emit the exec more than
# once (key mechanics / rapid taps); without a lock two runs race — one shows
# the window while the other, seeing it visible, hides it again (the window
# "flashes" then vanishes). flock -n makes any overlapping run a no-op.
STATE_DIR="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/smplos}"
mkdir -p "$STATE_DIR"
FOCUS_STATE="$STATE_DIR/toggle-messenger-${WS_NAME}.focus.json"
exec 9>"$STATE_DIR/toggle-messenger-${WS_NAME}.lock"
flock -n 9 || exit 0

# --- Query window state ---
window_json=$(hyprctl -j clients 2>/dev/null \
  | jq -e --arg c "$CLASS" \
    '[.[] | select((.class // "" | test($c; "i")) or (.initialClass // "" | test($c; "i")))] | first // empty' \
  2>/dev/null) || true

if [[ -n "$window_json" ]]; then
  addr=$(echo "$window_json" | jq -r '.address')
  ws_name=$(echo "$window_json" | jq -r '.workspace.name')

  if [[ "$ws_name" == special:* ]]; then
    # Hidden → bring back to the current workspace, floating, bottom-right.
    # Hyprland 0.55 lua mode rejects legacy `hyprctl dispatch` from the CLI;
    # drive the window via the hl.dsp.* lua dispatchers instead.
    calc_position
    remember_focus
    evacuate_workspace_aliens "$addr"
    hypr_dispatch "hl.dsp.window.move({window='address:${addr}', workspace='${TARGET_WORKSPACE}', silent=false})"
    hypr_dispatch "hl.dsp.window.float({window='address:${addr}', action='enable'})"
    hypr_dispatch "hl.dsp.window.resize({window='address:${addr}', x=${WIDTH}, y=${HEIGHT}, exact=true})"
    hypr_dispatch "hl.dsp.window.move({window='address:${addr}', x=${ABS_X}, y=${ABS_Y}})"
    # The corner above is for the bare window. With a HUD theme the frame drawn
    # around it reaches past the monitor's edge there, so the smpl-hud plugin is
    # asked to move the window in by the frame. It does nothing without a frame
    # or without the plugin; an unknown command is no reason to stop.
    hyprctl smplhud fit "$addr" >/dev/null 2>&1 || true
    hypr_dispatch "hl.dsp.focus({window='address:${addr}'})"
  else
    return_target=$(return_focus_target)
    # Focus the background window before moving Signal away, so the scrolling
    # layout need not choose an unrelated column as its fallback.
    restore_focus "$return_target"
    evacuate_workspace_aliens "$addr"
    # Visible → hide to special workspace.
    # In Hyprland 0.55 lua mode, moving a window into a special workspace
    # auto-reveals that special workspace on its monitor (the `silent` flag
    # no longer suppresses the reveal). If it got revealed, toggle it back
    # off so the window is actually hidden.
    hypr_dispatch "hl.dsp.window.move({window='address:${addr}', workspace='special:${WS_NAME}', silent=true})"
    # The reveal is applied asynchronously; retry the check briefly so we don't
    # miss it (which would leave the window on-screen).
    for _ in 1 2 3 4; do
      if hyprctl -j monitors 2>/dev/null \
        | jq -e --arg w "special:${WS_NAME}" 'any(.[]; .specialWorkspace.name == $w)' >/dev/null 2>&1; then
        hypr_dispatch "hl.dsp.workspace.toggle_special('${WS_NAME}')"
        break
      fi
      sleep 0.05
    done
    restore_focus "$return_target"
    rm -f "$FOCUS_STATE"
  fi
else
  # Not running → launch with float rules
  calc_position
  remember_focus
  evacuate_workspace_aliens
  if [[ ${#LAUNCH_CMD[@]} -gt 0 ]]; then
    hypr_dispatch "hl.dsp.exec_cmd([[${LAUNCH_CMD[*]}]], {float=true, size='${WIDTH} ${HEIGHT}', move='${POS_X} ${POS_Y}'})"
  else
    # Try to launch via .desktop file (single-arg mode like focus-or-launch)
    name="${CLASS%.desktop}"
    for dir in "$HOME/.local/share/applications" "/usr/local/share/applications" "/usr/share/applications"; do
      if [[ -f "$dir/${name}.desktop" ]]; then
        hypr_dispatch "hl.dsp.exec_cmd([[gtk-launch ${name}]], {float=true, size='${WIDTH} ${HEIGHT}', move='${POS_X} ${POS_Y}'})"
        exit 0
      fi
    done
    # Last resort: run directly
    hypr_dispatch "hl.dsp.exec_cmd([[${CLASS}]], {float=true, size='${WIDTH} ${HEIGHT}', move='${POS_X} ${POS_Y}'})"
  fi
fi

#!/bin/bash
set -u

BAR_CTL="${BAR_CTL:-bar-ctl}"
state_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}/smplos"
state="$state_dir/bar.backend"
mkdir -p "$state_dir"
# Retire the previous shell process during migration without uninstalling its
# package or touching ~/.config/eww, which may contain user-owned data.
if command -v eww >/dev/null 2>&1; then
    eww --config "$HOME/.config/eww" kill >/dev/null 2>&1 || true
fi
restart_control_surface() {
    if systemctl --user is-active --quiet control-surface.service 2>/dev/null; then
        systemctl --user restart control-surface.service 2>/dev/null || true
    fi
}

if "$BAR_CTL" ensure; then
    printf 'smpl-bar\n' > "$state"
    restart_control_surface
    exit 0
fi

rm -f -- "$state"
echo "bar-session-start: smpl-bar failed to start" >&2
exit 1

#!/bin/bash
# Keep the GUI unprivileged; GVfs authenticates privileged file operations.
set -euo pipefail

if [[ $# -ne 0 ]]; then
    echo "Usage: nemo-admin" >&2
    exit 1
fi
if ! command -v nemo >/dev/null; then
    echo "nemo-admin: Nemo is not installed" >&2
    exit 1
fi
exec nemo 'admin:///'

#!/bin/bash
# smplOS: System update -- smplOS files, pacman, AUR, Flatpak, forked apps
# Launched by app-center "Update" buttons or manually.
# Opens in the user's default terminal.
#
# Update order (full mode):
#   1. smplos-os-update   — git pull smplOS repo, sync scripts, run migrations
#   2. pacman -Syu        — general system packages, excluding critical stack
#   3. smplos-update-apps — forked apps from GitHub (smpl-apps, st-smpl, nemo-smpl, micro)
#   4. paru -Sua          — AUR packages, excluding critical stack
#   5. flatpak update     — Flatpak apps
#   6. critical bundle    — optional, explicit kernel/driver/compositor bundle
#
# Critical stack policy is source-controlled in the smplOS repo so App Center
# and CLI both follow the same behavior.

# Parse --mode flag: 'apps' skips kernel/drivers; 'full' is a complete system update
UPDATE_MODE="full"
for arg in "$@"; do
    case "$arg" in
        --mode) ;;
        apps)   UPDATE_MODE="apps" ;;
        full)   UPDATE_MODE="full" ;;
    esac
done

# ── Notification helper ──────────────────────────────────────────────────────
# Never emit the "Cannot autolaunch D-Bus without X11 $DISPLAY" noise when
# there's no session bus (e.g. after pkexec re-execs us as root); always echo
# to stderr too so the message isn't lost.
notify() {
    if command -v notify-send &>/dev/null \
       && [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" || -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]]; then
        notify-send "$1" "${2:-}" 2>/dev/null || true
    fi
    echo "smplOS Update: $1${2:+ — $2}" >&2
}

# Resolve our own absolute path — pkexec requires one — regardless of how we
# were invoked (`smplos-update`, `bash smplos-update`, a relative path, …).
SELF="$(readlink -f "$0")"

# ── Presentation ─────────────────────────────────────────────────────────────
# The update must show its progress in a terminal window. Crucially, we do NOT
# open that window as root: pkexec sanitizes the environment (drops
# WAYLAND_DISPLAY, XDG_RUNTIME_DIR, DISPLAY, DBUS_SESSION_BUS_ADDRESS), so a
# root-owned terminal has no compositor to connect to and silently fails — the
# App Center just asks for a password and then nothing appears. Instead we open
# the terminal as the *user* (who can see the compositor) first, then elevate
# with pkexec inline on that terminal's tty.
#
# `[[ -t 1 ]]` is true when we already have a terminal: a real CLI invocation,
# or the child we re-spawn inside a fresh terminal window just below.
if [[ ! -t 1 && $EUID -ne 0 ]]; then
    # GUI launch (App Center) — no controlling terminal. Resolve a terminal
    # emulator as the user and re-run ourselves inside it. The child gets a tty
    # and falls through to the inline elevation below.
    TERM_BIN="${SMPLOS_TERMINAL:-}"
    if [[ -z "$TERM_BIN" ]]; then
        TERM_BIN="$(command -v terminal 2>/dev/null || true)"
        if [[ -z "$TERM_BIN" ]]; then
            for cand in ghostty foot alacritty kitty wezterm st-wl st xterm; do
                command -v "$cand" &>/dev/null && { TERM_BIN="$(command -v "$cand")"; break; }
            done
        fi
    fi
    if [[ -z "$TERM_BIN" ]]; then
        notify "smplOS Update" "No terminal emulator found"
        exit 1
    fi
    exec "$TERM_BIN" -e bash "$SELF" "$@"
fi

# ── Elevate to root — inline, on the current terminal ────────────────────────
# We now have a tty (a real CLI, or the window we opened as the user above), so
# pkexec prompts right here and all update output stays in this terminal. No
# environment needs to survive pkexec: we're already displaying in a terminal.
if [[ $EUID -ne 0 ]]; then
    exec pkexec bash "$SELF" "$@"
fi

# ── Restore invoker context after pkexec ─────────────────────────────────────
# pkexec strips the environment, so once we re-enter as root, $HOME is /root
# and $USER is root. But every smplOS path — SMPLOS_PATH, the git repo,
# migration markers, update log dir, hypr configs — is anchored on the
# INVOKING user's $HOME. Without this block, the entire update silently
# no-ops against /root/.local/share/smplos/repo (which does not exist), and
# nothing ever lands on disk. This bug ("I press Update OS but nothing
# happens") was invisible because git errors were being swallowed downstream.
#
# We derive the invoker from PKEXEC_UID (set by pkexec) or SUDO_UID (set by
# sudo), resolve /etc/passwd, then rewrite HOME/USER/LOGNAME. Also expose
# SMPLOS_INVOKER_* so nested scripts (smplos-os-update, smplos-migrate) can
# runuser back to the invoker for user-owned file operations.
if [[ $EUID -eq 0 ]]; then
    _invoker_uid="${PKEXEC_UID:-${SUDO_UID:-}}"
    if [[ -n "${_invoker_uid:-}" && "$_invoker_uid" != "0" ]]; then
        _invoker_ent="$(getent passwd "$_invoker_uid" 2>/dev/null || true)"
        if [[ -n "$_invoker_ent" ]]; then
            export SMPLOS_INVOKER_UID="$_invoker_uid"
            export SMPLOS_INVOKER_USER="$(cut -d: -f1 <<<"$_invoker_ent")"
            export SMPLOS_INVOKER_HOME="$(cut -d: -f6 <<<"$_invoker_ent")"
            export HOME="$SMPLOS_INVOKER_HOME"
            export USER="$SMPLOS_INVOKER_USER"
            export LOGNAME="$SMPLOS_INVOKER_USER"
        fi
    fi
    unset _invoker_uid _invoker_ent
fi

UPDATE_SCRIPT=$(mktemp /tmp/smplos-update.XXXXXX.sh)

# Write mode into the script (unquoted heredoc for variable substitution)
cat > "$UPDATE_SCRIPT" << PREAMBLE
#!/bin/bash
UPDATE_MODE="$UPDATE_MODE"
PREAMBLE

# Append the body (single-quoted: no substitution; uses UPDATE_MODE set above)
cat >> "$UPDATE_SCRIPT" << 'EOF'
set -o pipefail
UPDATE_FAILED=0
# Set only when this run's system upgrade completed; gates the bundle.
SYSTEM_UPGRADED=0

# pkexec sanitizes PATH to a hardcoded minimal set that does NOT include
# /usr/local/bin — but every smplOS management script (smplos-os-update,
# smplos-update-apps, smplos-migrate, heal-paru, smplos-check-shadows, …)
# lives there. Without this line, `command -v smplos-os-update` returns
# nothing under pkexec and steps 1 and 3 silently no-op, which is exactly
# the "Update OS button appears to run but nothing gets updated" bug.
export PATH="/usr/local/sbin:/usr/local/bin:$PATH"

SMPLOS_PATH="${SMPLOS_PATH:-$HOME/.local/share/smplos}"
POLICY_DIR="$SMPLOS_PATH/repo/src/shared/update-policy"
CRITICAL_LIST_FILE="$POLICY_DIR/critical-packages.txt"
CRITICAL_BUNDLE_FILE="$POLICY_DIR/critical-bundle.conf"
STATE_DIR="$HOME/.local/state/smplos/update"
APPLIED_BUNDLE_FILE="$STATE_DIR/critical-bundle-applied"
BUNDLE_SNAPSHOT_FILE="$STATE_DIR/critical-bundle-versions"

DEFAULT_CRITICAL_PACKAGES=(
    linux linux-lts linux-zen linux-hardened
    linux-headers linux-lts-headers linux-zen-headers linux-hardened-headers
    nvidia nvidia-lts nvidia-dkms nvidia-utils lib32-nvidia-utils
    mesa lib32-mesa vulkan-radeon lib32-vulkan-radeon amdvlk lib32-amdvlk
    xf86-video-amdgpu xf86-video-intel xf86-video-nouveau
    amd-ucode intel-ucode
    grub mkinitcpio mkinitcpio-busybox
    hyprland eww xdg-desktop-portal xdg-desktop-portal-hyprland
    hyprpaper hypridle hyprlock hyprsunset hyprpicker
)

APPS_EXTRA_IGNORE=(pacman libalpm)
CRITICAL_PACKAGES=()
CRITICAL_IGNORE=""
APPS_MODE_IGNORE=""
HYPRLAND_SERIES=""
NETWORK_OK=1

csv_join() {
    local IFS=,
    echo "$*"
}

load_critical_packages() {
    CRITICAL_PACKAGES=("${DEFAULT_CRITICAL_PACKAGES[@]}")

    if [[ -f "$CRITICAL_LIST_FILE" ]]; then
        mapfile -t CRITICAL_PACKAGES < <(
            awk '
                /^[[:space:]]*#/ { next }
                /^[[:space:]]*$/ { next }
                { gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0); print $0 }
            ' "$CRITICAL_LIST_FILE"
        )
    fi

    if [[ ${#CRITICAL_PACKAGES[@]} -eq 0 ]]; then
        CRITICAL_PACKAGES=("${DEFAULT_CRITICAL_PACKAGES[@]}")
    fi

    CRITICAL_IGNORE=$(csv_join "${CRITICAL_PACKAGES[@]}")
    APPS_MODE_IGNORE=$(csv_join "${CRITICAL_PACKAGES[@]}" "${APPS_EXTRA_IGNORE[@]}")

    # The Hyprland series smplOS has validated, e.g. "0.56" (read, not sourced).
    HYPRLAND_SERIES=""
    if [[ -f "$CRITICAL_BUNDLE_FILE" ]]; then
        HYPRLAND_SERIES=$(sed -n \
            's/^HYPRLAND_SERIES="\{0,1\}\([0-9][0-9]*\.[0-9][0-9]*\)"\{0,1\}[[:space:]]*\(#.*\)\{0,1\}$/\1/p' \
            "$CRITICAL_BUNDLE_FILE" | head -n1)
    fi
}

# Upgrades of the stack through system_upgrade are expected, not drift.
refresh_bundle_snapshot() {
    [[ -s "$BUNDLE_SNAPSHOT_FILE" ]] || return 0
    local pkgs=()
    mapfile -t pkgs < <(awk '{print $1}' "$BUNDLE_SNAPSHOT_FILE")
    pacman -Q "${pkgs[@]}" 2>/dev/null > "$BUNDLE_SNAPSHOT_FILE.tmp" \
        && mv -f "$BUNDLE_SNAPSHOT_FILE.tmp" "$BUNDLE_SNAPSHOT_FILE"
    rm -f "$BUNDLE_SNAPSHOT_FILE.tmp"
}

# Versions that need a reboot (or at least a new session) when they change.
stack_versions() {
    pacman -Q hyprland xdg-desktop-portal-hyprland aquamarine linux linux-lts \
        linux-zen nvidia-open-dkms nvidia-utils nvidia-580xx-dkms 2>/dev/null
}

# Read by smplos-reboot-notify (end of this run and at every login).
REBOOT_MARKER="$HOME/.local/state/smplos/reboot-pending"

mark_reboot_pending() {
    mkdir -p "${REBOOT_MARKER%/*}"
    # boot_id, so the marker expires by itself after a reboot.
    tr -d '-' < /proc/sys/kernel/random/boot_id > "$REBOOT_MARKER" 2>/dev/null || return 0
    if [[ -n "${SMPLOS_INVOKER_UID:-}" ]]; then
        chown "$SMPLOS_INVOKER_UID" "$REBOOT_MARKER" 2>/dev/null || true
    fi
    return 0
}

# Upgrade the whole system in ONE transaction. While Arch ships the Hyprland
# series smplOS validated, the stack moves with everything else: holding
# hyprland back while its libraries move is a partial upgrade that fails
# ("installing aquamarine breaks dependency ... required by hyprland"), and
# installing it separately later can pair it with older system libraries than
# it was built against (Hyprland then cannot start). A newer series stays
# held back until smplOS validates it by raising HYPRLAND_SERIES.
system_upgrade() {
    local available before held=0
    if ! sudo pacman -Sy --noconfirm; then
        echo "  WARNING: could not refresh package databases (check internet/mirrors)"
        UPDATE_FAILED=1
        return 0
    fi
    # pacman translates field labels; read them in the C locale.
    available=$(LC_ALL=C pacman -Si hyprland 2>/dev/null | awk '/^Version/ {print $3; exit}')
    if [[ -z "$HYPRLAND_SERIES" || -z "$available" ]]; then
        # Without a known series or version, keep the previous behaviour.
        held=1
        echo "  Holding Hyprland: could not compare its version with the supported series."
    elif [[ "$available" != "$HYPRLAND_SERIES".* ]]; then
        held=1
        echo "  Holding Hyprland $available: smplOS supports the $HYPRLAND_SERIES series."
    fi
    before=$(stack_versions)
    if [[ $held -eq 0 ]] && sudo pacman -Su --noconfirm; then
        SYSTEM_UPGRADED=1
        refresh_bundle_snapshot
    elif [[ $held -eq 1 ]] && sudo pacman -Su --noconfirm --ignore "$CRITICAL_IGNORE"; then
        SYSTEM_UPGRADED=1
        refresh_bundle_snapshot
    else
        echo "  WARNING: system update failed"
        if [[ $held -eq 1 ]]; then
            echo "  Other packages already need Hyprland $available, which smplOS has not"
            echo "  validated yet. System updates resume once an smplOS update supports it."
        fi
        UPDATE_FAILED=1
    fi
    if [[ "$(stack_versions)" != "$before" ]]; then
        mark_reboot_pending
        echo "  Hyprland, the kernel or the graphics driver changed — reboot when convenient."
    fi
}

critical_bundle_prompt_and_apply() {
    [[ "$UPDATE_MODE" == "full" ]] || return 0
    [[ -f "$CRITICAL_BUNDLE_FILE" ]] || return 0
    if [[ "$NETWORK_OK" -eq 0 ]]; then
        echo "── Critical bundle ──"
        echo "  Skipped: no internet connection"
        echo
        return 0
    fi

    # shellcheck disable=SC1090
    source "$CRITICAL_BUNDLE_FILE" 2>/dev/null || {
        echo "── Critical bundle ──"
        echo "  WARNING: could not parse critical-bundle.conf"
        echo
        return 0
    }

    local bundle_id="${BUNDLE_ID:-}"
    local bundle_desc="${DESCRIPTION:-Critical stack update}"
    local bundle_reboot="${REBOOT_REQUIRED:-1}"
    local bundle_packages_raw="${PACKAGES:-}"
    local optional_packages_raw="${PACKAGES_IF_INSTALLED:-}"

    [[ -n "$bundle_id" && -n "$bundle_packages_raw" ]] || return 0

    mkdir -p "$STATE_DIR"
    local applied_id=""
    [[ -f "$APPLIED_BUNDLE_FILE" ]] && applied_id=$(<"$APPLIED_BUNDLE_FILE")

    if [[ "$applied_id" == "$bundle_id" ]]; then
        return 0
    fi

    # Install only on a fully updated system, so new packages are built for
    # the system libraries that are actually installed.
    if [[ "${SYSTEM_UPGRADED:-0}" -ne 1 ]]; then
        echo "── Critical bundle ──"
        echo "  Skipped $bundle_id until the system update above completes."
        echo
        return 0
    fi

    # Split PACKAGES into an array. Elements can be plain package names or
    # pinned specs like "nvidia=570.153.02-1".
    local bundle_packages=()
    read -r -a bundle_packages <<< "$bundle_packages_raw"
    [[ ${#bundle_packages[@]} -gt 0 ]] || return 0

    # Refreshed only where installed under exactly that name: `pacman -Q`
    # also matches a package that merely provides it (nvidia-580xx-utils
    # provides nvidia-utils and conflicts with it).
    local optional_packages=() optional
    read -r -a optional_packages <<< "$optional_packages_raw"
    for optional in "${optional_packages[@]}"; do
        [[ "$(pacman -Qq "$optional" 2>/dev/null)" == "$optional" ]] && bundle_packages+=("$optional")
    done

    echo "── Critical bundle ──"
    echo "  Applying $bundle_id: $bundle_desc"
    echo "  Packages: ${bundle_packages[*]}"
    echo
    if sudo pacman -S --noconfirm --needed "${bundle_packages[@]}"; then
        printf '%s\n' "$bundle_id" > "$APPLIED_BUNDLE_FILE"
        : > "$BUNDLE_SNAPSHOT_FILE"
        for spec in "${bundle_packages[@]}"; do
            pkg_name="${spec%%=*}"
            pacman -Q "$pkg_name" 2>/dev/null >> "$BUNDLE_SNAPSHOT_FILE" || true
        done
        echo "  ✓ Critical bundle applied: $bundle_id"
        if [[ "$bundle_reboot" == "1" ]]; then
            mark_reboot_pending
            echo "  Reboot required — you will be reminded when you close this window."
        fi
    else
        echo "  WARNING: critical bundle install failed (safe to retry)"
    fi
    echo
}

warn_if_critical_stack_drifted() {
    [[ -f "$BUNDLE_SNAPSHOT_FILE" ]] || return 0

    local drifted=0
    while read -r pkg ver; do
        [[ -n "$pkg" && -n "$ver" ]] || continue
        current=$(pacman -Q "$pkg" 2>/dev/null | awk '{print $2}')
        [[ -n "$current" ]] || continue
        if [[ "$current" != "$ver" ]]; then
            if [[ $drifted -eq 0 ]]; then
                echo "── Critical stack drift detected ──"
                echo "  Critical packages changed outside the managed bundle path:"
            fi
            drifted=1
            echo "  - $pkg: $ver -> $current"
        fi
    done < "$BUNDLE_SNAPSHOT_FILE"

    if [[ $drifted -eq 1 ]]; then
        echo "  A new critical bundle should be applied to restore a known-good stack."
        echo
    fi
}

detect_network() {
    # Best-effort connectivity probe so offline runs skip network steps cleanly.
    if curl -fsSL --connect-timeout 5 --max-time 8 https://archlinux.org >/dev/null 2>&1; then
        NETWORK_OK=1
    else
        NETWORK_OK=0
    fi
}

prepare_pacman_transaction() {
    [[ "$NETWORK_OK" -eq 1 ]] || return 0

    if ! pacman -Qq qemu-block-gluster >/dev/null 2>&1; then
        return 0
    fi

    echo "── Pacman preflight ──"
    if ! sudo pacman -Sy --noconfirm >/dev/null 2>&1; then
        echo "  WARNING: could not refresh package database for preflight"
        echo
        return 0
    fi

    if ! pacman -Si qemu-common 2>/dev/null | grep -qE '^Conflicts With.*qemu-block-gluster'; then
        echo "  qemu-block-gluster installed, but current qemu-common does not conflict"
        echo
        return 0
    fi

    echo "  Removing obsolete qemu-block-gluster update blocker"
    if pacman -Qq qemu-full >/dev/null 2>&1; then
        echo "  Temporarily removing old qemu-full meta-package"
        if sudo pacman -R --noconfirm qemu-full qemu-block-gluster; then
            sudo pacman -S --needed --noconfirm qemu-full \
                && echo "  Restored qemu-full meta-package without qemu-block-gluster" \
                || echo "  WARNING: qemu-full restore failed; concrete QEMU packages remain installed"
        else
            echo "  WARNING: could not remove qemu-full/qemu-block-gluster"
        fi
    elif ! sudo pacman -R --noconfirm qemu-block-gluster; then
        echo "  WARNING: could not remove qemu-block-gluster"
    fi
    echo
}

# Note: We're already running as root (elevated via pkexec),
# so sudo calls are just for safety/compatibility. No password needed.

# Log all output to file for debugging
LOG_DIR="$HOME/.local/state/smplos/update"
LOG_FILE="$LOG_DIR/update-$(date +%Y%m%d-%H%M%S).log"
mkdir -p "$LOG_DIR"

# Create a simple wrapper that tees to both terminal and log
{
    echo "════════════════════════════════════════"
    echo "  smplOS System Update"
    echo "  $(date)"
    echo "════════════════════════════════════════"
    echo

load_critical_packages
detect_network
warn_if_critical_stack_drifted
if [[ "$UPDATE_MODE" == "apps" ]]; then
    echo "══════════════════════════════════════"
    echo "  smplOS App Update"
    echo "  (critical stack preserved)"
    echo "══════════════════════════════════════"
else
    echo "══════════════════════════════════════"
    echo "  smplOS Full System Update"
    echo "  (critical stack via explicit bundle)"
    echo "══════════════════════════════════════"
fi
if [[ "$NETWORK_OK" -eq 0 ]]; then
    echo "  Network check: offline"
    echo "  Network-dependent steps will be skipped with warnings."
fi
echo

# ── Step 1: smplOS system files (git pull + sync scripts + migrations) ───────
# Only in full mode — these aren't "app" updates.
# Always print the section header BEFORE the guard so a silent skip is
# impossible to hide. Every failure mode has an audit trail in the log.
echo "── smplOS system files ──"
if [[ "$UPDATE_MODE" != "full" ]]; then
    echo "  Skipped: mode=$UPDATE_MODE (only runs in --mode full)"
elif ! command -v smplos-os-update &>/dev/null; then
    echo "  WARNING: smplos-os-update not found in PATH (\$PATH=$PATH)"
    UPDATE_FAILED=1
else
    smplos-os-update 2>&1 || { echo "  WARNING: smplos-os-update failed (exit $?)"; UPDATE_FAILED=1; }
    # Reload the critical-packages list AFTER smplos-os-update has git-pulled
    # the repo. Otherwise the ignore list handed to pacman -Syu below is the
    # STALE one from before the pull — meaning a policy change (e.g. removing
    # linux-lts from ignore) doesn't take effect until the SECOND click. This
    # was the whole reason customer machines never rolled forward hyprland.
    load_critical_packages
fi
echo

# ── Step 2: Official repos ───────────────────────────────────────────────────
prepare_pacman_transaction
if [[ "$UPDATE_MODE" == "apps" ]]; then
    echo "── Pacman (apps only) ──"
    if [[ "$NETWORK_OK" -eq 0 ]]; then
        echo "  Skipped: no internet connection"
    elif ! sudo pacman -Syu --noconfirm --ignore "$APPS_MODE_IGNORE"; then
        echo "  WARNING: pacman update failed (check internet/mirrors)"
    fi
else
    echo "── Pacman ──"
    if [[ "$NETWORK_OK" -eq 0 ]]; then
        echo "  Skipped: no internet connection"
    else
        system_upgrade
    fi
fi
echo

# ── Step 4: Forked smplOS apps (GitHub releases) ────────────────────────────
# Always print the header BEFORE the guard: a silent skip here was the bug
# where Update OS would appear to succeed but never actually fetch new
# settings/app-center/etc. binaries from GitHub.
echo "── smplOS Apps ──"
if [[ "$NETWORK_OK" -eq 0 ]]; then
    echo "  Skipped: no internet connection"
    UPDATE_FAILED=1
elif ! command -v smplos-update-apps &>/dev/null; then
    echo "  WARNING: smplos-update-apps not found in PATH (\$PATH=$PATH)"
    UPDATE_FAILED=1
else
    # Signal to smplos-update-apps that sudo credentials are already primed
    # (we're root via pkexec) so it doesn't try `sudo -v` against a pkexec
    # environment where cached credentials may not carry over.
    SMPLOS_SUDO_READY=1 smplos-update-apps 2>&1 \
        || { echo "  WARNING: smplos-update-apps failed (exit $?)"; UPDATE_FAILED=1; }
fi
echo

# ── Step 5: AUR packages (paru) — auto-heal if libalpm was bumped ────────────
paru_ok() { paru --version &>/dev/null 2>&1; }
if command -v paru &>/dev/null && ! paru_ok; then
    echo "── Healing paru (libalpm mismatch) ──"
    heal-paru || echo "WARNING: paru heal failed, AUR updates skipped"
    echo
fi
if paru_ok; then
    # Run paru at background CPU/IO priority so AUR compilation (e.g. webkit2gtk,
    # edk2) never starves Hyprland and causes input event drops / apparent
    # keybinding failures. nice -n 10 keeps compile threads below interactive
    # priority; ionice -c 3 (idle) ensures disk I/O doesn't block the compositor.
    _paru_run() {
        if command -v ionice &>/dev/null; then
            nice -n 10 ionice -c 3 paru "$@"
        else
            nice -n 10 paru "$@"
        fi
    }
    if [[ "$UPDATE_MODE" == "apps" ]]; then
        echo "── AUR (apps only, background priority) ──"
        if [[ "$NETWORK_OK" -eq 0 ]]; then
            echo "  Skipped: no internet connection"
        elif ! _paru_run -Sua --noconfirm --sudoloop --ignore "$APPS_MODE_IGNORE"; then
            echo "  WARNING: AUR update failed (check internet/mirrors)"
        fi
    else
        echo "── AUR (excluding critical stack, background priority) ──"
        if [[ "$NETWORK_OK" -eq 0 ]]; then
            echo "  Skipped: no internet connection"
        elif ! _paru_run -Sua --noconfirm --sudoloop --ignore "$CRITICAL_IGNORE"; then
            echo "  WARNING: AUR update failed (check internet/mirrors)"
        fi
    fi
    echo
fi

# ── Step 6: Flatpak (always safe — sandboxed, no kernel interaction) ─────────
if command -v flatpak &>/dev/null; then
    installed=$(flatpak list --app 2>/dev/null | wc -l)
    if [[ "$installed" -gt 0 ]]; then
        echo "── Flatpak ──"
        if [[ "$NETWORK_OK" -eq 0 ]]; then
            echo "  Skipped: no internet connection"
        elif ! flatpak update -y --noninteractive; then
            echo "  WARNING: flatpak update failed (check internet/remotes)"
        fi
        echo
    fi
fi

# ── Step 6: Critical bundle (explicit opt-in) ───────────────────────────────
critical_bundle_prompt_and_apply

# ── Final Hyprland reload ─────────────────────────────────────────────────────
# Reload config after all compilation is done so any state lost during heavy
# CPU load (e.g. paru building webkit2gtk) is cleanly restored.
# pkexec strips HYPRLAND_INSTANCE_SIGNATURE, so we probe the invoker's
# environment (via SMPLOS_INVOKER_UID) to find the running instance instead of
# relying on our own env — otherwise this step silently skips every time.
#
# NOTE: src/shared/lib/smplos-session-env.sh generalises exactly this probe
# (and adds WAYLAND_DISPLAY / DISPLAY / D-Bus). This block is deliberately kept
# inline: smplos-update is the elevation entry point for the whole update, and
# giving it a hard dependency on a file that a not-yet-updated machine may not
# have on disk would be a worse failure mode than the duplication.
echo "── Reloading Hyprland ──"
if ! command -v hyprctl &>/dev/null; then
    echo "  Skipped: hyprctl not installed"
else
    # Try current env first; fall back to invoker's Hyprland signature.
    _his="${HYPRLAND_INSTANCE_SIGNATURE:-}"
    if [[ -z "$_his" && -n "${SMPLOS_INVOKER_UID:-}" ]]; then
        _runtime="/run/user/$SMPLOS_INVOKER_UID"
        if [[ -d "$_runtime/hypr" ]]; then
            _his=$(ls -t "$_runtime/hypr" 2>/dev/null | head -1)
        fi
    fi
    if [[ -z "$_his" ]]; then
        echo "  Skipped: no running Hyprland instance"
    else
        HYPRLAND_INSTANCE_SIGNATURE="$_his" \
        XDG_RUNTIME_DIR="/run/user/${SMPLOS_INVOKER_UID:-$UID}" \
        hyprctl reload 2>/dev/null \
            && echo "  Config reloaded" \
            || echo "  Reload failed (safe to ignore)"
    fi
    unset _his _runtime
fi
echo

echo "══════════════════════════════════════"
if [[ "$UPDATE_FAILED" -eq 0 ]]; then
    echo "  Update complete!"
else
    echo "  Update incomplete: see errors above, resolve them, then retry Update OS."
fi
echo "  Log: $LOG_FILE"
echo "══════════════════════════════════════"
echo

# Auto-close terminal after 3 seconds (user can press Ctrl+C to keep it open)
echo "Closing in 3 seconds... (Ctrl+C to cancel)"
sleep 3

# After the terminal closes, fire a reboot notification if needed: detached so
# closing the window cannot kill it, and as the user, whose session bus shows
# notifications (root under pkexec has none).
if [[ -f "$REBOOT_MARKER" ]] && command -v smplos-reboot-notify &>/dev/null; then
    if [[ $EUID -eq 0 && -n "${SMPLOS_INVOKER_USER:-}" ]]; then
        setsid -f runuser -u "$SMPLOS_INVOKER_USER" -- env \
            XDG_RUNTIME_DIR="/run/user/$SMPLOS_INVOKER_UID" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$SMPLOS_INVOKER_UID/bus" \
            sh -c 'sleep 1; exec smplos-reboot-notify' >/dev/null 2>&1
    else
        setsid -f sh -c 'sleep 1; exec smplos-reboot-notify' >/dev/null 2>&1
    fi
fi
[[ "$UPDATE_FAILED" -eq 0 ]]
} 2>&1 | tee -a "$LOG_FILE"
EOF
chmod +x "$UPDATE_SCRIPT"

# We are always root on a real terminal here (a CLI invocation, or the window we
# opened as the user before elevating), so run the update inline.
exec bash "$UPDATE_SCRIPT"

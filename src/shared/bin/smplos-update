#!/bin/bash
# smplOS: System update -- smplOS files, pacman, AUR, Flatpak, forked apps
# Launched by app-center "Update" buttons or manually.
# Opens in the user's default terminal.
#
# Refresh scripts, upgrade the complete base, deploy the desktop/native apps,
# then verify installed files, shared libraries, package state and the session.
#
# Critical stack policy is source-controlled in the smplOS repo so App Center
# and CLI both follow the same behavior.

set -o pipefail

# Apps mode never performs a partial host-package upgrade.
UPDATE_MODE="full"
BOOTSTRAP_ONLY=0
LEGACY_HANDOFF=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --mode)
            [[ "${2:-}" == full || "${2:-}" == apps ]] || {
                echo "Usage: smplos-update [--mode full|apps]" >&2; exit 1;
            }
            UPDATE_MODE="$2"; shift ;;
        --bootstrap-only) BOOTSTRAP_ONLY=1 ;;
        --legacy-handoff)
            [[ -n "${2:-}" ]] || { echo "Missing handoff record" >&2; exit 1; }
            LEGACY_HANDOFF="$2"; shift ;;
        -h|--help) echo "Usage: smplos-update [--mode full|apps] [--bootstrap-only]"; exit 0 ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
    shift
done

# ── Notification helper ──────────────────────────────────────────────────────
# Never emit the "Cannot autolaunch D-Bus without X11 $DISPLAY" noise when
# there's no session bus (e.g. after pkexec re-execs us as root); always echo
# to stderr too so the message isn't lost.
notify() {
    if command -v notify-send &>/dev/null \
       && [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" || -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]]; then
        notify-send "$1" "${2:-}" 2>/dev/null || true
    fi
    echo "smplOS Update: $1${2:+ — $2}" >&2
}

startup_fail() {
    local message="$1${STARTUP_LOG:+ Startup log: $STARTUP_LOG}"
    local title="${2:-Update OS could not start}" notification_script="${3:-}"
    stop_sudo_keepalive
    release_update_lock || exit 1
    if [[ -n "$notification_script" ]]; then
        echo "smplOS Update: $title - $message" >&2
        setsid -f bash "$notification_script" 9>&- >/dev/null 2>&1 ||
            notify "$title" "$message"
    else
        notify "$title" "$message"
    fi
    [[ ! -t 0 || "${SMPLOS_UPDATE_NO_HOLD:-0}" == 1 ]] ||
        read -r -p "Update could not start. Press Enter to close. " _
    exit 1
}

# Resolve the entrypoint before opening a terminal or refreshing scripts.
SELF="$(readlink -f "$0")"

check_update_power() {
    local supplies="${1:-/sys/class/power_supply}" path type status scope
    local batteries=0 online=0 charging=0 discharging=0
    [[ -d "$supplies" && -r "$supplies" ]] || {
        echo "ERROR: cannot inspect system power supplies; update not started." >&2
        return 1
    }
    for path in "$supplies"/*; do
        [[ -e "$path" ]] || continue
        type=$(cat "$path/type") || return 1
        scope=""
        if [[ -f "$path/scope" ]]; then
            scope=$(cat "$path/scope") || return 1
        fi
        [[ "$scope" != Device ]] || continue
        case "${path##*/}" in hid-*|hidpp_battery_*) continue ;; esac
        if [[ "$type" == Battery ]]; then
            if [[ -f "$path/present" && "$(cat "$path/present")" == 0 ]]; then
                continue
            fi
            batteries=$((batteries + 1))
            status=$(cat "$path/status") || return 1
            echo "  Battery ${path##*/}: $status$(if [[ -r "$path/capacity" ]]; then printf ' (%s%%)' "$(cat "$path/capacity")"; fi)"
            [[ "$status" != Charging ]] || charging=1
            [[ "$status" != Discharging ]] || discharging=1
        elif [[ -f "$path/online" ]]; then
            [[ "$(cat "$path/online")" != 1 ]] || online=1
        fi
    done
    if [[ $batteries -gt 0 && ( $discharging -eq 1 || ( $online -eq 0 && $charging -eq 0 ) ) ]]; then
        echo "ERROR: connect the laptop to external power, then retry Update OS." >&2
        echo "  Even a full battery is not a substitute for plugged-in power." >&2
        return 1
    fi
    echo "  Power check: OK"
}

# ── Presentation ─────────────────────────────────────────────────────────────
# The update must show its progress in a terminal window. Crucially, we do NOT
# open that window as root: the desktop user owns the session and sudo's tty
# credential context. Only individual system operations elevate.
#
# `[[ -t 1 ]]` is true when we already have a terminal: a real CLI invocation,
# or the child we re-spawn inside a fresh terminal window just below.
if [[ ! -t 1 && $EUID -ne 0 ]]; then
    # GUI launch (App Center) — no controlling terminal. Resolve a terminal
    # emulator as the user and re-run ourselves inside it. The child gets a tty
    # and falls through to the inline elevation below.
    TERM_BIN="${SMPLOS_TERMINAL:-}"
    if [[ -z "$TERM_BIN" ]]; then
        TERM_BIN="$(command -v terminal 2>/dev/null || true)"
        if [[ -z "$TERM_BIN" ]]; then
            for cand in ghostty foot alacritty kitty wezterm st-wl st xterm; do
                command -v "$cand" &>/dev/null && { TERM_BIN="$(command -v "$cand")"; break; }
            done
        fi
    fi
    if [[ -z "$TERM_BIN" ]]; then
        notify "smplOS Update" "No terminal emulator found"
        exit 1
    fi
    launch_args=(--mode "$UPDATE_MODE")
    [[ $BOOTSTRAP_ONLY -eq 0 ]] || launch_args+=(--bootstrap-only)
    [[ -z "$LEGACY_HANDOFF" ]] || launch_args+=(--legacy-handoff "$LEGACY_HANDOFF")
    # Terminal servers may close inherited descriptors or retain them outside
    # the child. The tty coordinator must acquire its own lock in either case.
    if [[ "${SMPLOS_UPDATE_LOCKED:-0}" == 1 ]]; then
        exec 9>&-
        unset SMPLOS_UPDATE_LOCKED
    fi
    exec "$TERM_BIN" -e bash "$SELF" "${launch_args[@]}"
fi

# Keep one user's tty/sudo credential context for the entire run. Root-owned
# orchestration followed by runuser created unrelated authentication contexts.
if [[ $EUID -eq 0 ]]; then
    echo "Run smplos-update as your desktop user, without sudo or pkexec." >&2
    exit 1
fi
export PATH="/usr/local/sbin:/usr/local/bin:$PATH"
SMPLOS_PATH="${SMPLOS_PATH:-$HOME/.local/share/smplos}"
export SMPLOS_UPDATE_COORDINATOR=1
LOG_DIR="$HOME/.local/state/smplos/update"
UPDATE_SCRIPT=""
STARTUP_LOG=""
stop_sudo_keepalive() {
    if [[ -n "${SMPLOS_SUDO_KEEPALIVE_PID:-}" ]]; then
        kill "$SMPLOS_SUDO_KEEPALIVE_PID" 2>/dev/null || true
        wait "$SMPLOS_SUDO_KEEPALIVE_PID" 2>/dev/null || true
        unset SMPLOS_SUDO_KEEPALIVE_PID
    fi
}
release_update_lock() {
    if [[ "${SMPLOS_UPDATE_LOCKED:-0}" == 1 ]]; then
        flock -u 9 || { echo "ERROR: cannot release the update lock" >&2; return 1; }
        exec 9>&-
        unset SMPLOS_UPDATE_LOCKED
    fi
    UPDATE_LOCK_RELEASED=1
}
check_reboot_before_update() {
    [[ "$UPDATE_MODE" == full && $BOOTSTRAP_ONLY -eq 0 ]] || return 0
    local state="$LOG_DIR/status" helper="" candidate status=0
    [[ -f "$state" ]] || return 0
    awk -F= '
        $1 == "status" { status=$2; statuses++ }
        $1 == "stage" { stage=$2; stages++ }
        $1 == "core_verified" { core=$2; cores++ }
        END { exit !(statuses == 1 && stages == 1 && cores == 1 &&
            (status == "complete" || status == "complete-with-warnings") &&
            stage == "finished" && core == "1") }
    ' "$state" || return 0
    for candidate in "${SELF%/*}/../lib/smplos/smplos-reboot.sh" \
        "${SELF%/*}/../lib/smplos-reboot.sh" \
        "$SMPLOS_PATH/repo/src/shared/lib/smplos-reboot.sh"; do
        [[ -r "$candidate" ]] || continue
        helper="$candidate"
        break
    done
    if [[ -z "$helper" ]]; then
        # Older installations acquire the helper during the verified bootstrap.
        [[ "${1:-}" != allow-bootstrap ]] || return 0
        startup_fail "Cannot check whether a reboot is required: updater helper is missing."
    fi
    source "$helper" || startup_fail "Cannot load the pending-reboot check."
    smplos_reboot_pending || status=$?
    case "$status" in
        0)
            local notifier=""
            for candidate in "$SMPLOS_PATH/repo/src/shared/bin/smplos-reboot-notify" \
                "${SELF%/*}/smplos-reboot-notify"; do
                [[ -r "$candidate" ]] || continue
                notifier="$candidate"
                break
            done
            startup_fail "The previous update is complete. Save your work and reboot before running Update OS again." \
                "Reboot required" "$notifier"
            ;;
        1) return 0 ;;
        *) startup_fail "Cannot verify whether a reboot is required; inspect the reboot marker before retrying." ;;
    esac
}
authenticate_update() {
    [[ "${SMPLOS_SUDO_READY:-0}" != 1 ]] || return 0
    command sudo -v || startup_fail "Authentication failed; update not started."
    (
        trap - EXIT INT HUP
        sleeper=""
        trap '[[ -z "$sleeper" ]] || kill "$sleeper" 2>/dev/null; exit' TERM
        while true; do
            sleep 30 & sleeper=$!
            wait "$sleeper" || exit
            command sudo -n -v || exit
        done
    ) 9>&- >/dev/null 2>&1 &
    export SMPLOS_SUDO_KEEPALIVE_PID=$!
    export SMPLOS_SUDO_READY=1
}
repair_update_state() {
    local helper="$SMPLOS_PATH/repo/src/shared/bin/smplos-update-handoff"
    [[ -r "$helper" ]] || {
        echo "ERROR: updater state-repair helper is missing: $helper" >&2
        return 1
    }
    echo "Checking legacy updater-state ownership."
    command sudo -n python3 "$helper" --repair-state --uid "$UID"
}
trap 'stop_sudo_keepalive; release_update_lock' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# Legacy root runners can leave the state directory or lock unwritable.
# Authenticate once and repair only managed state, never remove the lock.
if ! mkdir -p "$LOG_DIR" || [[ ! -w "$LOG_DIR" ]] ||
    [[ -e "$LOG_DIR/update.lock" && ! -w "$LOG_DIR/update.lock" ]]; then
    STARTUP_LOG=$(mktemp "${TMPDIR:-/tmp}/smplos-update-startup.XXXXXX.log") ||
        startup_fail "Cannot create a private startup-repair log."
    check_update_power 2>&1 | tee -a "$STARTUP_LOG" ||
        startup_fail "Connect external power before repairing Update OS."
    authenticate_update
    repair_update_state 2>&1 | tee -a "$STARTUP_LOG" ||
        startup_fail "Cannot restore updater-state access; existing state was preserved."
    mkdir -p "$LOG_DIR" || startup_fail "Cannot create the update state directory: $LOG_DIR"
fi
if [[ "${SMPLOS_UPDATE_LOCKED:-0}" != 1 ]]; then
    exec 9>>"$LOG_DIR/update.lock" ||
        startup_fail "Cannot write $LOG_DIR/update.lock; existing state was preserved."
fi
flock -n 9 || startup_fail "Another smplOS update is already running."
export SMPLOS_UPDATE_LOCKED=1
check_reboot_before_update allow-bootstrap
export SMPLOS_UPDATE_LOG_FILE="${SMPLOS_UPDATE_LOG_FILE:-$LOG_DIR/update-$(date +%Y%m%d-%H%M%S)-$$.log}"
if [[ -n "$STARTUP_LOG" ]]; then
    cat -- "$STARTUP_LOG" >> "$SMPLOS_UPDATE_LOG_FILE" ||
        startup_fail "Cannot retain the startup-repair transcript in the update log."
fi
bootstrap_fail() {
    echo "ERROR: $* Log: $SMPLOS_UPDATE_LOG_FILE" | tee -a "$SMPLOS_UPDATE_LOG_FILE" >&2
    [[ -z "$UPDATE_SCRIPT" ]] || rm -f -- "$UPDATE_SCRIPT"
    stop_sudo_keepalive
    release_update_lock || exit 1
    [[ ! -t 0 || "${SMPLOS_UPDATE_NO_HOLD:-0}" == 1 ]] ||
        read -r -p "Update could not start. Press Enter to close. " _
    exit 1
}

if [[ -n "$LEGACY_HANDOFF" ]]; then
    python3 "$SMPLOS_PATH/repo/src/shared/bin/smplos-update-handoff" --wait "$LEGACY_HANDOFF" \
        2>&1 | tee -a "$SMPLOS_UPDATE_LOG_FILE" ||
        bootstrap_fail "Automatic updater handoff failed; no package upgrade was started."
fi
if ! check_update_power 2>&1 | tee -a "$SMPLOS_UPDATE_LOG_FILE"; then
    stop_sudo_keepalive
    release_update_lock || exit 1
    [[ ! -t 0 || "${SMPLOS_UPDATE_NO_HOLD:-0}" == 1 ]] ||
        read -r -p "Plug in power, then press Enter to close and retry. " _
    exit 1
fi
authenticate_update
sudo() { command sudo -n "$@"; }
export -f sudo

# Refresh the orchestration itself before migrations or package transactions.
# Never let a legacy installed helper perform the first Git synchronization.
source_updater="$SMPLOS_PATH/repo/src/shared/bin/smplos-os-update"
source_checker="$SMPLOS_PATH/repo/src/shared/bin/smplos-update-check"
if [[ ! -r "$source_updater" || ! -r "$source_checker" ]] ||
    ! grep -qxF 'SMPLOS_UPDATE_PROTOCOL=1' "$source_updater"; then
    enrollment=/usr/local/bin/smplos-update-bootstrap
    [[ -r "$enrollment" ]] || bootstrap_fail "Updater bootstrap is missing; no package upgrade was started."
    enrollment_args=(--mode "$UPDATE_MODE")
    [[ $BOOTSTRAP_ONLY -eq 0 ]] || enrollment_args+=(--bootstrap-only)
    exec bash "$enrollment" "${enrollment_args[@]}"
fi
if [[ "${SMPLOS_UPDATER_REFRESHED:-0}" != 1 ]]; then
    before=$(sha256sum "$SELF") || bootstrap_fail "Cannot read updater entrypoint."
    set -o pipefail
    if ! bash "$source_updater" --scripts 2>&1 | tee -a "$SMPLOS_UPDATE_LOG_FILE"; then
        bootstrap_fail "Updater bootstrap failed."
    fi
    fresh=/usr/local/bin/smplos-update
    if [[ ! -x "$fresh" ]]; then
        bootstrap_fail "Updater bootstrap did not install $fresh."
    fi
    after=$(sha256sum "$fresh") || bootstrap_fail "Cannot verify refreshed updater."
fi

if ! SMPLOS_PATH="$SMPLOS_PATH" python3 "$source_checker" --mode bootstrap \
    --output "$SMPLOS_UPDATE_LOG_FILE.bootstrap.json" 2>&1 | tee -a "$SMPLOS_UPDATE_LOG_FILE"; then
    bootstrap_fail "Updater commands/helpers do not match the fetched source. No package upgrade was started."
fi
if [[ "${SMPLOS_UPDATER_REFRESHED:-0}" != 1 ]]; then
    export SMPLOS_UPDATER_REFRESHED=1
    if [[ "${before%% *}" != "${after%% *}" ]]; then
        # The inherited lock belongs to the same open file description.
        reexec_args=(--mode "$UPDATE_MODE")
        [[ $BOOTSTRAP_ONLY -eq 0 ]] || reexec_args+=(--bootstrap-only)
        exec bash "$fresh" "${reexec_args[@]}"
    fi
fi
if ! repair_update_state 2>&1 | tee -a "$SMPLOS_UPDATE_LOG_FILE"; then
    bootstrap_fail "Updater-state ownership could not be restored. No package upgrade was started."
fi
if [[ $BOOTSTRAP_ONLY -eq 1 ]]; then
    echo "Updater enrollment verified. No host packages, native apps or desktop configs were updated." |
        tee -a "$SMPLOS_UPDATE_LOG_FILE"
    echo "Bootstrap report: $SMPLOS_UPDATE_LOG_FILE.bootstrap.json"
    echo "When ready, run smplos-update --mode full as this desktop user."
    exit 0
fi
check_reboot_before_update

UPDATE_SCRIPT=$(mktemp /tmp/smplos-update.XXXXXX.sh) || bootstrap_fail "Cannot prepare updater."

# Write mode into the script (unquoted heredoc for variable substitution)
cat > "$UPDATE_SCRIPT" << PREAMBLE || bootstrap_fail "Cannot write update preamble."
#!/bin/bash
UPDATE_MODE="$UPDATE_MODE"
PREAMBLE
declare -f check_update_power stop_sudo_keepalive release_update_lock >> "$UPDATE_SCRIPT" || bootstrap_fail "Cannot write update helpers."

# Append the body (single-quoted: no substitution; uses UPDATE_MODE set above)
cat >> "$UPDATE_SCRIPT" << 'EOF' || bootstrap_fail "Cannot write updater body."
set -o pipefail
UPDATE_FAILED=0
CORE_VERIFIED=0
BRAVE_TARGET_REQUESTED=0
OPTIONAL_WARNINGS=()
# Set only when this run's system upgrade completed; gates the bundle.
SYSTEM_UPGRADED=0

# Prefer canonical scripts over historical user-local shadow copies.
export PATH="/usr/local/sbin:/usr/local/bin:$PATH"

SMPLOS_PATH="${SMPLOS_PATH:-$HOME/.local/share/smplos}"
POLICY_DIR="$SMPLOS_PATH/repo/src/shared/update-policy"
CRITICAL_LIST_FILE="$POLICY_DIR/critical-packages.txt"
CRITICAL_BUNDLE_FILE="$POLICY_DIR/critical-bundle.conf"
STATE_DIR="$HOME/.local/state/smplos/update"
APPLIED_BUNDLE_FILE="$STATE_DIR/critical-bundle-applied"
BUNDLE_SNAPSHOT_FILE="$STATE_DIR/critical-bundle-versions"

DEFAULT_CRITICAL_PACKAGES=(
    linux linux-lts linux-zen linux-hardened
    linux-headers linux-lts-headers linux-zen-headers linux-hardened-headers
    nvidia nvidia-lts nvidia-dkms nvidia-utils lib32-nvidia-utils
    mesa lib32-mesa vulkan-radeon lib32-vulkan-radeon amdvlk lib32-amdvlk
    xf86-video-amdgpu xf86-video-intel xf86-video-nouveau
    amd-ucode intel-ucode
    grub mkinitcpio mkinitcpio-busybox
    hyprland eww xdg-desktop-portal xdg-desktop-portal-hyprland
    hyprpaper hypridle hyprlock hyprsunset hyprpicker
)

APPS_EXTRA_IGNORE=(pacman libalpm)
CRITICAL_PACKAGES=()
CRITICAL_IGNORE=""
APPS_MODE_IGNORE=""
HYPRLAND_SERIES=""
NETWORK_OK=1
CURRENT_STAGE=starting
FINISHED=0
UPDATE_LOCK_RELEASED=0

record_update_state() {
    local status="$1" destination="${2:-$STATE_DIR/status}" temporary
    temporary=$(mktemp "${destination}.XXXXXX") || return 1
    {
        printf 'status=%s\nstage=%s\nlog=%s\nmode=%s\ncore_verified=%s\noptional_phase_warnings=%s\n' \
            "$status" "$CURRENT_STAGE" "$LOG_FILE" "$UPDATE_MODE" "$CORE_VERIFIED" "${#OPTIONAL_WARNINGS[@]}"
        if [[ $# -eq 2 ]]; then
            printf 'protocol=1\nlock_released=%s\n' "$UPDATE_LOCK_RELEASED"
        fi
    } > "$temporary" &&
        sync -f "$temporary" &&
        mv -f -- "$temporary" "$destination" &&
        sync -f "$(dirname -- "$destination")"
}

update_stage() {
    CURRENT_STAGE="$1"
    record_update_state running || { echo "ERROR: cannot persist update progress" >&2; exit 1; }
}

finish_update() {
    local status=$?
    if [[ $FINISHED -eq 0 ]]; then
        record_update_state interrupted || echo "ERROR: cannot record interrupted update" >&2
    fi
    stop_sudo_keepalive
    rm -f -- "$0"
    release_update_lock || return 1
    if [[ $FINISHED -eq 0 ]]; then
        record_update_state interrupted "$LOG_FILE.result" ||
            echo "ERROR: cannot publish interrupted update result" >&2
        echo "Update stopped during $CURRENT_STAGE. Log: $LOG_FILE" >&2
        [[ $CORE_VERIFIED -ne 1 ]] || echo "Core update was verified before optional work was interrupted." >&2
        [[ ! -t 0 ]] || read -r -p "Update stopped. Press Enter to close. " _
    fi
    return "$status"
}

# Noninteractive calls fail visibly instead of requesting another password.
sudo() { command sudo -n "$@"; }
export -f sudo
export SMPLOS_SUDO_READY=1

csv_join() {
    local IFS=,
    echo "$*"
}

optional_warning() {
    OPTIONAL_WARNINGS+=("$*")
    echo "  WARNING (optional): $*"
}

run_optional() {
    local label="$1"
    shift
    if "$@"; then
        return 0
    else
        local status=$?
        optional_warning "$label failed (exit $status); pending for retry. See $LOG_FILE."
    fi
}

update_flatpak_scope() {
    local scope="$1" attempt transcript status
    local flatpak_command=(flatpak "--$scope")
    [[ "$scope" != system ]] || flatpak_command=(sudo "${flatpak_command[@]}")
    for attempt in 1 2; do
        transcript="$LOG_FILE.flatpak-$scope-$attempt.log"
        LC_ALL=C "${flatpak_command[@]}" update -y --noninteractive 2>&1 | tee "$transcript" || return 1
        if grep -qF 'Warning: Treating remote fetch error as non-fatal since ' "$transcript"; then
            :
        else
            status=$?
            [[ $status -eq 1 ]] || return "$status"
            return 0
        fi
        if [[ $attempt -eq 2 ]]; then
            echo "ERROR: $scope Flatpak refs remain unavailable; some installed versions were retained. See $transcript." >&2
            return 1
        fi
        check_update_power || return 1
        echo "  Refreshing $scope Flatpak remote metadata before one retry..."
        LC_ALL=C "${flatpak_command[@]}" remote-ls --columns=ref >/dev/null || return 1
    done
}

_yay_run() {
    if command -v ionice &>/dev/null; then
        nice -n 10 ionice -c 3 yay "$@"
    else
        nice -n 10 yay "$@"
    fi
}

load_critical_packages() {
    CRITICAL_PACKAGES=("${DEFAULT_CRITICAL_PACKAGES[@]}")

    if [[ -f "$CRITICAL_LIST_FILE" ]]; then
        mapfile -t CRITICAL_PACKAGES < <(
            awk '
                /^[[:space:]]*#/ { next }
                /^[[:space:]]*$/ { next }
                { gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0); print $0 }
            ' "$CRITICAL_LIST_FILE"
        )
    fi

    if [[ ${#CRITICAL_PACKAGES[@]} -eq 0 ]]; then
        CRITICAL_PACKAGES=("${DEFAULT_CRITICAL_PACKAGES[@]}")
    fi

    CRITICAL_IGNORE=$(csv_join "${CRITICAL_PACKAGES[@]}")
    APPS_MODE_IGNORE=$(csv_join "${CRITICAL_PACKAGES[@]}" "${APPS_EXTRA_IGNORE[@]}")

    # The Hyprland series smplOS has validated, e.g. "0.56" (read, not sourced).
    HYPRLAND_SERIES=""
    if [[ -f "$CRITICAL_BUNDLE_FILE" ]]; then
        HYPRLAND_SERIES=$(sed -n \
            's/^HYPRLAND_SERIES="\{0,1\}\([0-9][0-9]*\.[0-9][0-9]*\)"\{0,1\}[[:space:]]*\(#.*\)\{0,1\}$/\1/p' \
            "$CRITICAL_BUNDLE_FILE" | head -n1)
    fi
}

# Upgrades of the stack through system_upgrade are expected, not drift.
refresh_bundle_snapshot() {
    [[ -s "$BUNDLE_SNAPSHOT_FILE" ]] || return 0
    local pkgs=()
    mapfile -t pkgs < <(awk '{print $1}' "$BUNDLE_SNAPSHOT_FILE")
    pacman -Q "${pkgs[@]}" 2>/dev/null > "$BUNDLE_SNAPSHOT_FILE.tmp" \
        && mv -f "$BUNDLE_SNAPSHOT_FILE.tmp" "$BUNDLE_SNAPSHOT_FILE"
    rm -f "$BUNDLE_SNAPSHOT_FILE.tmp"
}

# Versions that need a reboot (or at least a new session) when they change.
stack_versions() {
    pacman -Q hyprland xdg-desktop-portal-hyprland aquamarine linux linux-lts \
        linux-zen nvidia-open-dkms nvidia-utils nvidia-580xx-dkms 2>/dev/null
}

# Read by smplos-reboot-notify (end of this run and at every login).
REBOOT_MARKER="$HOME/.local/state/smplos/reboot-pending"

mark_reboot_pending() {
    mkdir -p "${REBOOT_MARKER%/*}"
    # boot_id, so the marker expires by itself after a reboot.
    tr -d '-' < /proc/sys/kernel/random/boot_id > "$REBOOT_MARKER" 2>/dev/null || return 0
    if [[ -n "${SMPLOS_INVOKER_UID:-}" ]]; then
        chown "$SMPLOS_INVOKER_UID" "$REBOOT_MARKER" 2>/dev/null || true
    fi
    return 0
}

# Never upgrade libraries underneath a held compositor.
system_upgrade() {
    local available before held=0
    if ! sudo pacman -Sy --noconfirm; then
        echo "  WARNING: could not refresh package databases (check internet/mirrors)"
        UPDATE_FAILED=1
        return 0
    fi
    # pacman translates field labels; read them in the C locale.
    available=$(LC_ALL=C pacman -Si hyprland 2>/dev/null | awk '/^Version/ {print $3; exit}')
    if pacman -Q hyprland >/dev/null 2>&1 && [[ -z "$HYPRLAND_SERIES" || -z "$available" ]]; then
        held=1
        echo "  ERROR: could not compare Hyprland with the supported series."
    elif pacman -Q hyprland >/dev/null 2>&1 && [[ "${available#*:}" != "$HYPRLAND_SERIES".* ]]; then
        held=1
        echo "  ERROR: Hyprland $available is outside the supported $HYPRLAND_SERIES series."
    fi
    if [[ $held -eq 1 ]]; then
        echo "  Stopping the entire system upgrade; no partial library/driver upgrade will be attempted."
        UPDATE_FAILED=1
        return 0
    fi
    # A retired helper's pinned libalpm dependency must not block the base upgrade.
    local package retired=()
    for package in paru paru-bin paru-git; do
        if pacman -Qq "$package" >/dev/null 2>&1; then
            retired+=("$package")
        fi
    done
    if [[ ${#retired[@]} -gt 0 ]]; then
        echo "  Retiring Paru before the libalpm upgrade; dependencies and user caches are preserved."
        if ! sudo pacman -R --noconfirm "${retired[@]}"; then
            echo "  ERROR: cannot retire Paru safely; system upgrade stopped."
            UPDATE_FAILED=1
            return 0
        fi
    fi
    before=$(stack_versions)
    local conflict_args=()
    if pacman -Qq qemu-block-gluster >/dev/null 2>&1; then
        # Accept the official replacement conflict inside the full transaction.
        conflict_args=(--ask 4)
    fi
    if sudo pacman -Su --noconfirm "${conflict_args[@]}"; then
        SYSTEM_UPGRADED=1
        refresh_bundle_snapshot
    else
        echo "  WARNING: system update failed"
        UPDATE_FAILED=1
    fi
    if [[ "$(stack_versions)" != "$before" ]]; then
        mark_reboot_pending
        echo "  Hyprland, the kernel or the graphics driver changed — reboot when convenient."
    fi
}

critical_bundle_prompt_and_apply() {
    [[ "$UPDATE_MODE" == "full" ]] || return 0
    [[ -f "$CRITICAL_BUNDLE_FILE" ]] || return 0
    if ! check_update_power; then
        UPDATE_FAILED=1
        return 0
    fi
    if [[ "$NETWORK_OK" -eq 0 ]]; then
        echo "── Critical bundle ──"
        echo "  Skipped: no internet connection"
        echo
        return 0
    fi

    # shellcheck disable=SC1090
    source "$CRITICAL_BUNDLE_FILE" 2>/dev/null || {
        echo "── Critical bundle ──"
        echo "  WARNING: could not parse critical-bundle.conf"
        UPDATE_FAILED=1
        echo
        return 0
    }

    local bundle_id="${BUNDLE_ID:-}"
    local bundle_desc="${DESCRIPTION:-Critical stack update}"
    local bundle_reboot="${REBOOT_REQUIRED:-1}"
    local bundle_packages_raw="${PACKAGES:-}"
    local optional_packages_raw="${PACKAGES_IF_INSTALLED:-}"

    [[ -n "$bundle_id" && -n "$bundle_packages_raw" ]] || return 0

    mkdir -p "$STATE_DIR"
    local applied_id=""
    [[ -f "$APPLIED_BUNDLE_FILE" ]] && applied_id=$(<"$APPLIED_BUNDLE_FILE")

    if [[ "$applied_id" == "$bundle_id" ]]; then
        return 0
    fi

    # Install only on a fully updated system, so new packages are built for
    # the system libraries that are actually installed.
    if [[ "${SYSTEM_UPGRADED:-0}" -ne 1 ]]; then
        echo "── Critical bundle ──"
        echo "  Skipped $bundle_id until the system update above completes."
        echo
        return 0
    fi

    # Split PACKAGES into an array. Elements can be plain package names or
    # pinned specs like "nvidia=570.153.02-1".
    local bundle_packages=()
    read -r -a bundle_packages <<< "$bundle_packages_raw"
    [[ ${#bundle_packages[@]} -gt 0 ]] || return 0

    # Refreshed only where installed under exactly that name: `pacman -Q`
    # also matches a package that merely provides it (nvidia-580xx-utils
    # provides nvidia-utils and conflicts with it).
    local optional_packages=() optional
    read -r -a optional_packages <<< "$optional_packages_raw"
    for optional in "${optional_packages[@]}"; do
        [[ "$(pacman -Qq "$optional" 2>/dev/null)" == "$optional" ]] && bundle_packages+=("$optional")
    done

    echo "── Critical bundle ──"
    echo "  Applying $bundle_id: $bundle_desc"
    echo "  Packages: ${bundle_packages[*]}"
    echo
    if sudo pacman -S --noconfirm --needed "${bundle_packages[@]}"; then
        printf '%s\n' "$bundle_id" > "$APPLIED_BUNDLE_FILE"
        : > "$BUNDLE_SNAPSHOT_FILE"
        for spec in "${bundle_packages[@]}"; do
            pkg_name="${spec%%=*}"
            pacman -Q "$pkg_name" 2>/dev/null >> "$BUNDLE_SNAPSHOT_FILE" || true
        done
        echo "  ✓ Critical bundle applied: $bundle_id"
        if [[ "$bundle_reboot" == "1" ]]; then
            mark_reboot_pending
            echo "  Reboot required — you will be reminded when you close this window."
        fi
    else
        echo "  WARNING: critical bundle install failed (safe to retry)"
        UPDATE_FAILED=1
    fi
    echo
}

warn_if_critical_stack_drifted() {
    [[ -f "$BUNDLE_SNAPSHOT_FILE" ]] || return 0

    local drifted=0
    while read -r pkg ver; do
        [[ -n "$pkg" && -n "$ver" ]] || continue
        current=$(pacman -Q "$pkg" 2>/dev/null | awk '{print $2}')
        [[ -n "$current" ]] || continue
        if [[ "$current" != "$ver" ]]; then
            if [[ $drifted -eq 0 ]]; then
                echo "── Critical stack drift detected ──"
                echo "  Critical packages changed outside the managed bundle path:"
            fi
            drifted=1
            echo "  - $pkg: $ver -> $current"
        fi
    done < "$BUNDLE_SNAPSHOT_FILE"

    if [[ $drifted -eq 1 ]]; then
        echo "  A new critical bundle should be applied to restore a known-good stack."
        echo
    fi
}

detect_network() {
    # Best-effort connectivity probe so offline runs skip network steps cleanly.
    if curl -fsSL --connect-timeout 5 --max-time 8 https://archlinux.org >/dev/null 2>&1; then
        NETWORK_OK=1
    else
        NETWORK_OK=0
    fi
}

prepare_pacman_transaction() {
    [[ "$NETWORK_OK" -eq 1 ]] || return 0

    local migration
    for migration in 20260805-100050-clear-ignorepkg-hyprland-eww.sh \
                     20260805-100060-remove-dropped-lib32-gstreamer.sh; do
        if ! bash "$SMPLOS_PATH/repo/migrations/$migration"; then
            echo "  ERROR: package preflight failed: $migration"
            UPDATE_FAILED=1
            return 1
        fi
    done

    local directive values
    for directive in IgnorePkg IgnoreGroup; do
        values=$(pacman-conf "$directive") || {
            echo "ERROR: cannot inspect pacman $directive policy"
            return 1
        }
        if [[ -n "$values" ]]; then
            echo "ERROR: custom $directive holds prevent a complete upgrade: $values"
            echo "Resolve those holds before Update OS; they were not changed."
            return 1
        fi
    done
}

# Log all output to file for debugging
LOG_DIR="$HOME/.local/state/smplos/update"
LOG_FILE="$SMPLOS_UPDATE_LOG_FILE"
mkdir -p "$LOG_DIR"

# Create a simple wrapper that tees to both terminal and log
{
    trap finish_update EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    sudo rm -f /etc/sudoers.d/99-smplos-update-transient || exit 1
    sudo rm -f /etc/pacman.d/hooks/90-rebuild-paru.hook || exit 1
    if [[ -f "$STATE_DIR/status" ]] && grep -q '^status=\(running\|interrupted\)$' "$STATE_DIR/status"; then
        echo "WARNING: the previous update was interrupted. Previous progress:"
        cat "$STATE_DIR/status"
    fi
    update_stage preflight
    echo "════════════════════════════════════════"
    echo "  smplOS System Update"
    echo "  $(date)"
    echo "════════════════════════════════════════"
    echo

load_critical_packages
detect_network
if ! check_update_power; then exit 1; fi
if ! command -v smplos-update-check >/dev/null; then
    echo "ERROR: update verification tool was not installed by the bootstrap."
    exit 1
fi
smplos-update-check --snapshot --output "$LOG_FILE.before.json" || exit 1
warn_if_critical_stack_drifted
if [[ "$UPDATE_MODE" == "apps" ]]; then
    echo "══════════════════════════════════════"
    echo "  smplOS App Update"
    echo "  (critical stack preserved)"
    echo "══════════════════════════════════════"
else
    echo "══════════════════════════════════════"
    echo "  smplOS Full System Update"
    echo "  (complete base upgrade, then desktop and apps)"
    echo "══════════════════════════════════════"
fi
if [[ "$NETWORK_OK" -eq 0 ]]; then
    echo "  Network check: offline"
    echo "  Network-dependent steps will be skipped with warnings."
fi
echo

# ── Step 1: smplOS system files (bootstrap already completed) ──────────────
# Only in full mode — these aren't "app" updates.
# Always print the section header BEFORE the guard so a silent skip is
# impossible to hide. Every failure mode has an audit trail in the log.
echo "── smplOS system files ──"
if [[ "$UPDATE_MODE" != "full" ]]; then
    echo "  Skipped: mode=$UPDATE_MODE (only runs in --mode full)"
elif ! command -v smplos-os-update &>/dev/null; then
    echo "  WARNING: smplos-os-update not found in PATH (\$PATH=$PATH)"
    UPDATE_FAILED=1
else
    echo "  Updater scripts refreshed; desktop deployment follows the system upgrade."
    load_critical_packages
fi
echo

# ── Step 2: Official repos ───────────────────────────────────────────────────
update_stage system-packages
if [[ "$UPDATE_MODE" == "apps" ]]; then
    echo "  Host packages are updated only by Update OS; no partial pacman upgrade."
else
    echo "── Pacman ──"
    if [[ "$NETWORK_OK" -eq 0 ]]; then
        echo "  Skipped: no internet connection"
        UPDATE_FAILED=1
    elif check_update_power && prepare_pacman_transaction; then
        system_upgrade
    else
        UPDATE_FAILED=1
    fi
fi
echo

update_stage core-aur
AUR_POLICY_READY=0
CORE_AUR_PACKAGES=""
OPTIONAL_AUR_PACKAGES=""
if [[ "$UPDATE_MODE" == full && $SYSTEM_UPGRADED -eq 1 ]] && check_update_power; then
    if ! SMPLOS_SYSTEM_UPGRADED=1 bash "$SMPLOS_PATH/repo/migrations/20261018-000000-remove-orphaned-lib32-mpg123.sh"; then
        echo "  ERROR: retired dependency cleanup failed."
        UPDATE_FAILED=1
    fi
    critical_bundle_prompt_and_apply
    echo "── Required AUR drivers, libraries and update tools ──"
    if SMPLOS_SYSTEM_UPGRADED=1 smplos-ensure-yay &&
        smplos-update-check --classify-aur --output "$LOG_FILE.aur.json"; then
        if policy_lines=$(python3 - "$LOG_FILE.aur.json" <<'PY'
import json, re, sys
with open(sys.argv[1]) as stream:
    report = json.load(stream)
if report["errors"]:
    sys.exit("ERROR: AUR priority inventory contains errors")
for group in ("required", "optional"):
    packages = report["aur_policy"][group]
    if not isinstance(packages, list) or not all(
            isinstance(name, str) and re.fullmatch(r"[A-Za-z0-9@._+:-]+", name) for name in packages):
        sys.exit("ERROR: malformed AUR priority inventory")
    print(group + "=" + ",".join(packages))
PY
        ); then
            while IFS='=' read -r group packages; do
                case "$group" in
                    required) CORE_AUR_PACKAGES="$packages" ;;
                    optional) OPTIONAL_AUR_PACKAGES="$packages" ;;
                esac
            done <<< "$policy_lines"
            AUR_POLICY_READY=1
        else
            echo "  ERROR: cannot read required/optional AUR package policy."
            UPDATE_FAILED=1
        fi
    else
        echo "  ERROR: required AUR tooling or dependency classification failed."
        UPDATE_FAILED=1
    fi
    if [[ $AUR_POLICY_READY -eq 1 && -n "$CORE_AUR_PACKAGES" ]]; then
        if ! _yay_run -Sua --noconfirm --sudoloop=false --sudo sudo --sudoflags=-n \
            --ignore "$CRITICAL_IGNORE,nemo-smpl,grafium-bin,eww-smplos${OPTIONAL_AUR_PACKAGES:+,$OPTIONAL_AUR_PACKAGES}"; then
            echo "  ERROR: required AUR drivers/libraries were not updated."
            UPDATE_FAILED=1
        fi
    fi
fi

# ── Step 4: Forked smplOS apps (GitHub releases) ────────────────────────────
# Always print the header BEFORE the guard: a silent skip here was the bug
# where Update OS would appear to succeed but never actually fetch new
# settings/app-center/etc. binaries from GitHub.
echo "── smplOS Apps ──"
update_stage native-apps
if [[ "$UPDATE_MODE" == full && $SYSTEM_UPGRADED -ne 1 ]]; then
    echo "  Skipped: incomplete system upgrade"
    UPDATE_FAILED=1
elif [[ "$NETWORK_OK" -eq 0 ]]; then
    echo "  Skipped: no internet connection"
    UPDATE_FAILED=1
elif ! check_update_power; then
    UPDATE_FAILED=1
elif ! command -v smplos-update-apps &>/dev/null; then
    echo "  WARNING: smplos-update-apps not found in PATH (\$PATH=$PATH)"
    UPDATE_FAILED=1
else
    # Reuse the same user's tty credential context.
    SMPLOS_SUDO_READY=1 smplos-update-apps --group core --report "$LOG_FILE.apps.json" 2>&1 \
        || { echo "  WARNING: smplos-update-apps failed (exit $?)"; UPDATE_FAILED=1; }
fi
echo

update_stage desktop
if [[ "$UPDATE_MODE" == full && $SYSTEM_UPGRADED -eq 1 ]] && check_update_power; then
    export SMPLOS_SYSTEM_UPGRADED=1 SMPLOS_UPDATE_APP_OWNER=1
    smplos-os-update --deploy --core 2>&1 || {
        echo "  ERROR: smplos-os-update failed (exit $?)"
        UPDATE_FAILED=1
    }
elif [[ "$UPDATE_MODE" == full ]]; then
    echo "  Desktop deployment skipped: the base upgrade and external power are required."
    UPDATE_FAILED=1
fi

update_stage core-verification
if smplos-update-check --core-only --before "$LOG_FILE.before.json" \
    --output "$LOG_FILE.core.json" --apps-report "$LOG_FILE.apps.json" --mode "$UPDATE_MODE"; then
    if [[ $UPDATE_FAILED -eq 0 ]]; then
        CORE_VERIFIED=1
        update_stage core-verified
        echo "  Core update verified: packages, native apps and essential configs."
    fi
else
    echo "  ERROR: core verification failed; optional work will not start."
    UPDATE_FAILED=1
fi

# ── Step 5: Optional applications and integrations ────────────────────────
update_stage optional-apps
if [[ $CORE_VERIFIED -eq 1 ]] && check_update_power; then
    echo "── Optional apps and configurations ──"
    if [[ "$UPDATE_MODE" == full ]]; then
        run_optional "App configurations/migrations" smplos-os-update --optional
    fi
else
    optional_warning "Optional apps/configurations deferred: verified core update and external power are required."
fi

update_stage aur
if [[ "$UPDATE_MODE" == full && $CORE_VERIFIED -eq 1 && $AUR_POLICY_READY -eq 1 ]]; then
    echo "── Optional AUR apps (background priority) ──"
    if [[ "$NETWORK_OK" -eq 1 ]] && check_update_power; then
        BRAVE_TARGET_REQUESTED=1
        run_optional "Brave target capture" smplos-update-check \
            --capture-brave-target --output "$LOG_FILE.brave.json"
        if [[ -n "$OPTIONAL_AUR_PACKAGES" ]]; then
            run_optional "Optional AUR apps" _yay_run -Sua --noconfirm --sudoloop=false \
                --sudo sudo --sudoflags=-n \
                --ignore "$CRITICAL_IGNORE,nemo-smpl,grafium-bin,eww-smplos${CORE_AUR_PACKAGES:+,$CORE_AUR_PACKAGES}"
        fi
    else
        optional_warning "Optional AUR updates deferred: network and external power are required."
    fi
fi

# ── Step 6: Sandboxed apps ─────────────────────────────────────────────────
update_stage flatpak
if [[ $CORE_VERIFIED -eq 1 ]] && command -v flatpak &>/dev/null; then
    echo "── Flatpak ──"
    for scope in user system; do
        if ! installed=$(flatpak list "--$scope" --columns=ref); then
            optional_warning "Cannot inventory $scope Flatpak apps/runtimes."
            continue
        fi
        [[ -n "$installed" ]] || continue
        echo "  Updating $scope apps and runtimes..."
        if [[ "$NETWORK_OK" -eq 0 ]]; then
            optional_warning "$scope Flatpak updates deferred: no internet connection."
        elif ! check_update_power; then
            optional_warning "$scope Flatpak updates deferred: external power is required."
        else
            run_optional "$scope Flatpak update" update_flatpak_scope "$scope"
        fi
    done
    echo
fi

# ── Final Hyprland reload ─────────────────────────────────────────────────────
# Reload config after all compilation is done so any state lost during heavy
# CPU load (e.g. Yay building webkit2gtk) is cleanly restored.
# pkexec strips HYPRLAND_INSTANCE_SIGNATURE, so we probe the invoker's
# environment (via SMPLOS_INVOKER_UID) to find the running instance instead of
# relying on our own env — otherwise this step silently skips every time.
#
# NOTE: src/shared/lib/smplos-session-env.sh generalises exactly this probe
# (and adds WAYLAND_DISPLAY / DISPLAY / D-Bus). This block is deliberately kept
# inline: smplos-update is the elevation entry point for the whole update, and
# giving it a hard dependency on a file that a not-yet-updated machine may not
# have on disk would be a worse failure mode than the duplication.
update_stage verification
echo "── Reloading Hyprland ──"
if ! command -v hyprctl &>/dev/null; then
    echo "  Skipped: hyprctl not installed"
else
    # Try current env first; fall back to invoker's Hyprland signature.
    _his="${HYPRLAND_INSTANCE_SIGNATURE:-}"
    if [[ -z "$_his" && -n "${SMPLOS_INVOKER_UID:-}" ]]; then
        _runtime="/run/user/$SMPLOS_INVOKER_UID"
        if [[ -d "$_runtime/hypr" ]]; then
            _his=$(ls -t "$_runtime/hypr" 2>/dev/null | head -1)
        fi
    fi
    if [[ -z "$_his" ]]; then
        echo "  Skipped: no running Hyprland instance"
    else
        if HYPRLAND_INSTANCE_SIGNATURE="$_his" \
        XDG_RUNTIME_DIR="/run/user/${SMPLOS_INVOKER_UID:-$UID}" \
        hyprctl reload; then
            echo "  Config reloaded"
        else
            echo "  ERROR: Hyprland reload failed"
            UPDATE_FAILED=1
        fi
    fi
    unset _his _runtime
fi
echo

check_args=(--before "$LOG_FILE.before.json" --output "$LOG_FILE.after.json"
    --apps-report "$LOG_FILE.apps.json"
    --mode "$UPDATE_MODE")
[[ $BRAVE_TARGET_REQUESTED -eq 0 ]] || check_args+=(--brave-report "$LOG_FILE.brave.json")
for warning in "${OPTIONAL_WARNINGS[@]}"; do check_args+=(--optional-warning "$warning"); done
[[ $UPDATE_FAILED -eq 0 ]] || check_args+=(--required-error "A required update operation failed; see $LOG_FILE")
AUDIT_WARNINGS=0
if smplos-update-check "${check_args[@]}"; then
    :
else
    check_status=$?
    if [[ $check_status -eq 2 ]]; then
        AUDIT_WARNINGS=1
    else
        UPDATE_FAILED=1
    fi
fi
if [[ "$UPDATE_MODE" == full && $UPDATE_FAILED -eq 0 ]]; then
    smplos-os-update --finalize || UPDATE_FAILED=1
fi
CURRENT_STAGE=finished
if [[ $UPDATE_FAILED -eq 0 ]]; then
    completion=complete
    if [[ ${#OPTIONAL_WARNINGS[@]} -gt 0 || $AUDIT_WARNINGS -eq 1 ]]; then
        completion=complete-with-warnings
    fi
    if ! record_update_state "$completion"; then
        echo "ERROR: could not record update completion" >&2
        UPDATE_FAILED=1
        completion=failed
    fi
else
    completion=failed
    record_update_state failed || echo "ERROR: could not record update failure"
fi
stop_sudo_keepalive
# Publish shared state while still exclusive; only this run's receipt follows
# the unlock, so an old terminal cannot overwrite a newer run's progress.
FINISHED=1
release_update_lock || exit 1
record_update_state "$completion" "$LOG_FILE.result" || {
    echo "ERROR: could not publish update completion result" >&2
    UPDATE_FAILED=1
}

echo "══════════════════════════════════════"
if [[ "$UPDATE_FAILED" -eq 0 && "$completion" == complete-with-warnings ]]; then
    echo "  Update complete with warnings: core updated; optional app work remains pending."
    echo "  Optional errors and retry details: $LOG_FILE.after.json"
elif [[ "$UPDATE_FAILED" -eq 0 ]]; then
    echo "  Update complete!"
else
    echo "  Update incomplete: see errors above, resolve them, then retry Update OS."
fi
echo "  Log: $LOG_FILE"
echo "══════════════════════════════════════"
echo

if [[ $UPDATE_FAILED -eq 0 ]]; then
    echo "Closing in 3 seconds... (Ctrl+C to cancel)"
    sleep 3
elif [[ -t 0 ]]; then
    read -r -p "Update incomplete. Press Enter to close this window. " _
fi

# After the terminal closes, fire a reboot notification if needed: detached so
# closing the window cannot kill it, and as the user, whose session bus shows
# notifications (root under pkexec has none).
if [[ -f "$REBOOT_MARKER" ]] && command -v smplos-reboot-notify &>/dev/null; then
    if [[ $EUID -eq 0 && -n "${SMPLOS_INVOKER_USER:-}" ]]; then
        setsid -f runuser -u "$SMPLOS_INVOKER_USER" -- env \
            XDG_RUNTIME_DIR="/run/user/$SMPLOS_INVOKER_UID" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$SMPLOS_INVOKER_UID/bus" \
            sh -c 'sleep 1; exec smplos-reboot-notify' 9>&- >/dev/null 2>&1
    else
        setsid -f sh -c 'sleep 1; exec smplos-reboot-notify' 9>&- >/dev/null 2>&1
    fi
fi
[[ "$UPDATE_FAILED" -eq 0 ]]
} 2>&1 | tee -a "$LOG_FILE"
EOF
chmod +x "$UPDATE_SCRIPT" || bootstrap_fail "Cannot prepare updater permissions."

# The same desktop user and tty own orchestration, builds and sudo credentials.
exec bash "$UPDATE_SCRIPT"

#!/usr/bin/env python3
"""Read-only installed-state verification; reports stay on this machine."""

import argparse
import fnmatch
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile
from datetime import datetime, timezone


APPS = (
    "start-menu", "notif-center", "settings", "app-center", "webapp-center",
    "sync-center-daemon", "sync-center-gui", "smpl-calendar", "smpl-calendar-alertd",
    "smpl-hints", "smpl-hintsd",
)
XR_SCRIPTS = {"xrctl", "xr-game", "xr-glasses-hotplugd"}
USER_HYPR = {
    "monitors.conf", "pointer.conf", "hypridle.conf", "bindings.conf", "messenger-bindings.conf",
    "theme.conf", "hyprlock-theme.conf",
}
STACK = re.compile(
    r"^(linux(?:-lts|-zen|-hardened|-surface)?(?:-headers)?|linux-firmware.*|"
    r".*nvidia.*|.*mesa.*|.*vulkan.*|.*-dkms(?:-git)?|xf86-(?:input|video)-.*|"
    r".*ucode|hypr.*|aquamarine|xdg-desktop-portal.*|eww.*|glibc|gcc-libs|"
    r"openssl|systemd.*|pacman|libalpm|grub|mkinitcpio.*|kernel-modules-hook|dkms|"
    r"libdrm|wayland|libxkbcommon.*|qt6-.*|gtk[34]|glib2|webkit2gtk.*|"
    r"nemo-smpl|control-surface|bash|coreutils|sudo|polkit.*|pam|"
    r"python|curl|git|gnupg|ca-certificates.*|yay(?:-bin|-git)?|flatpak|"
    r"greetd.*|plymouth|dbus.*|networkmanager|pipewire.*|wireplumber|brave-bin)$"
)
KERNELS = {"linux", "linux-lts", "linux-zen", "linux-hardened", "linux-surface"}
RELEASE_COMPONENTS = {"smpl-apps", "st-smpl", "nemo-smpl", "micro-smpl", "control-surface"}
OPTIONAL_PACKAGES = {"brave-bin", "flatpak", "nvidia-container-toolkit"}
CORE_BINARIES = {
    "bash": ("usr/bin/bash",),
    "sudo": ("usr/bin/sudo",),
    "pacman": ("usr/bin/pacman",),
    "python": ("usr/bin/python3",),
    "curl": ("usr/bin/curl",),
    "git": ("usr/bin/git",),
    "systemd": ("usr/lib/systemd/systemd", "usr/bin/systemctl"),
    "greetd": ("usr/bin/greetd",),
    "networkmanager": ("usr/bin/NetworkManager",),
    "polkit": ("usr/lib/polkit-1/polkitd",),
    "pipewire": ("usr/bin/pipewire",),
    "yay": ("usr/bin/yay",),
    "yay-bin": ("usr/bin/yay",),
    "yay-git": ("usr/bin/yay",),
}


def digest(path):
    checksum = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            checksum.update(chunk)
    return checksum.hexdigest()


def run(*args):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=45,
                              env={**os.environ, "LC_ALL": "C"})
    except (OSError, subprocess.TimeoutExpired) as error:
        raise RuntimeError(f"{' '.join(map(str, args))}: {error}") from error


def package_inputs(command=run, configuration="/etc/pacman.conf"):
    configuration_result = command("pacman-conf", "--config", configuration)
    database = command("pacman-conf", "--config", configuration, "DBPath")
    repositories = command("pacman-conf", "--config", configuration, "--repo-list")
    for result in (configuration_result, database, repositories):
        if result is None or result.returncode:
            raise RuntimeError("Cannot read the complete pacman configuration")
    directory = Path(database.stdout.strip())
    if not directory.is_absolute() or "[options]" not in configuration_result.stdout:
        raise ValueError("Invalid effective pacman configuration/database path")
    checksum = hashlib.sha256(configuration_result.stdout.encode())
    paths = [directory / "local/ALPM_DB_VERSION", *sorted((directory / "local").glob("*/desc")),
             *(directory / "sync" / f"{name}.db" for name in repositories.stdout.splitlines())]
    for path in paths:
        checksum.update(str(path).encode() + b"\0")
        checksum.update(path.read_bytes())
    return {"configuration": configuration_result.stdout, "database": str(directory),
            "fingerprint": checksum.hexdigest()}


def verify_pin_transaction(path, targets=None):
    record = json.loads(path.read_text())
    plan = record["pin_plan"]
    configuration = record["_guard_configuration"]
    if targets is not None:
        if not (Path(plan["inputs"]["database"]) / "db.lck").exists():
            raise RuntimeError("Protected-stack hook requires pacman's active database lock")
        current = run("pacman-conf", "--config", record["_guard_source_configuration"])
        if current.returncode or current.stdout != plan["inputs"]["configuration"]:
            raise RuntimeError("Pacman configuration changed after planning; retry Update OS")
        if record.get("_guard_base"):
            if package_inputs(configuration=record["_guard_source_configuration"])["fingerprint"] != plan["inputs"]["fingerprint"]:
                raise RuntimeError("Package databases/configuration changed after planning; retry Update OS")
            if targets != set(plan["targets"]) | set(plan["removals"]):
                raise RuntimeError("Actual package targets differ from the prepared update plan")
    result = run("pacman", "--config", configuration, "-Q")
    if result.returncode and (result.returncode != 1 or result.stdout.strip() or result.stderr.strip()):
        raise RuntimeError("Cannot verify installed package versions")
    installed = dict(line.split() for line in result.stdout.splitlines())
    for name, entry in plan["pins"].items():
        if installed.get(name) != entry["version"] or targets is not None and name in targets:
            raise RuntimeError(f"Protected package would change or was already changed: {name}")
    if targets is None:
        if not plan["targets"] and not plan["removals"] and (
                package_inputs(configuration=record["_guard_source_configuration"])["fingerprint"] !=
                plan["inputs"]["fingerprint"]):
            raise RuntimeError("Package inputs changed during a no-op update; retry Update OS")
        for name, version in plan["targets"].items():
            if installed.get(name) != version:
                raise RuntimeError(f"Prepared package target was not delivered: {name} {version}")
        for name in plan["removals"]:
            if name in installed and name not in plan["targets"]:
                raise RuntimeError(f"Prepared package removal was not completed: {name}")


def installed_closure(records, roots):
    providers = {}
    for name, record in records.items():
        for value in (name, *record["Provides"]):
            if value != "None":
                providers.setdefault(re.split(r"[<>=]", value, maxsplit=1)[0], set()).add(name)
    closure, pending = set(), list(roots)
    while pending:
        name = pending.pop()
        if name in closure:
            continue
        closure.add(name)
        for value in records[name]["Depends On"]:
            if value == "None":
                continue
            dependency = re.split(r"[<>=]", value, maxsplit=1)[0]
            candidates = {dependency} if dependency in records else providers.get(dependency, set())
            if not candidates:
                raise ValueError(f"Cannot resolve installed dependency {dependency} required by {name}")
            pending.extend(candidates - closure)
    return closure


def save_report(path, report):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=".update-report-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(report, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(name):
            os.unlink(name)


class Audit:
    def __init__(self, home, repo, root=Path("/"), runner=run, core_only=False):
        self.home, self.repo, self.root, self.run = home, repo, root, runner
        self.core_only = core_only
        self.library_paths = set()
        self.library_packages = set()
        self.report = {
            "schema": 3, "time": datetime.now(timezone.utc).isoformat(),
            "errors": [], "warnings": [], "optional_failures": [], "files": {}, "linkage": {},
        }

    def error(self, text):
        self.report["errors"].append(text)

    def optional_error(self, text):
        self.report["optional_failures"].append(text)
        self.report["warnings"].append(f"Optional: {text}")

    def optional_check(self, label, check, *args):
        start = len(self.report["errors"])
        core_libraries = self.library_paths.copy()
        try:
            check(*args)
        except (OSError, ValueError, KeyError, TypeError) as error:
            self.error(str(error))
        finally:
            self.library_paths = core_libraries
        failures = self.report["errors"][start:]
        del self.report["errors"][start:]
        for failure in failures:
            self.optional_error(f"{label}: {failure}")

    def command(self, *args):
        try:
            return self.run(*map(str, args))
        except RuntimeError as error:
            self.error(str(error))
            return None

    def snapshot(self):
        packages = self.command("pacman", "-Q")
        self.report["packages"] = {}
        if packages is None or packages.returncode or not packages.stdout.strip():
            self.error("Cannot inventory installed packages with pacman -Q")
        else:
            for line in packages.stdout.splitlines():
                name, version = line.split(maxsplit=1)
                self.report["packages"][name] = version
        self.report["running_kernel"] = os.uname().release
        commit = self.command("git", "-C", self.repo, "rev-parse", "HEAD")
        if commit is None or commit.returncode:
            self.error("Cannot identify the deployed OS source commit")
        else:
            self.report["source_commit"] = commit.stdout.strip()
        versions = self.home / ".local/state/smplos/app-versions"
        self.report["app_versions"] = {}
        for path in versions.glob("*"):
            if path.name not in RELEASE_COMPONENTS or not path.is_file():
                continue
            try:
                self.report["app_versions"][path.name] = path.read_text().strip()
            except OSError as error:
                self.error(f"Cannot read installed app version marker {path}: {error}")
        return self.report

    def compare(self, source, destination, executable=False):
        key = str(destination)
        try:
            if not destination.is_file() or digest(source) != digest(destination):
                self.error(f"Missing or stale managed file: {destination}")
                self.report["files"][key] = "mismatch"
            else:
                self.report["files"][key] = digest(destination)
                if executable and not os.access(destination, os.X_OK):
                    self.error(f"Managed executable is not executable: {destination}")
        except OSError as error:
            self.error(f"Cannot verify {destination}: {error}")

    def managed_files(self, desktop=True):
        for relative, destination, patterns in (
            ("src/shared/bin", self.root / "usr/local/bin", ("*",)),
            ("src/shared/lib", self.root / "usr/local/lib/smplos", ("*.sh", "*.py")),
        ):
            directory = self.repo / relative
            if not directory.is_dir():
                self.error(f"Missing source directory: {directory}")
            for pattern in patterns:
                for source in directory.glob(pattern):
                    if source.is_file():
                        self.compare(source, destination / source.name, executable=relative.endswith("/bin"))
        if not desktop:
            return
        eww = self.repo / "src/shared/eww"
        for pattern in ("*.yuck", "*.scss", "scripts/*"):
            for source in eww.glob(pattern):
                if source.is_file() and not source.name.startswith("theme-colors."):
                    self.compare(source, self.home / ".config/eww" / source.relative_to(eww),
                                 executable=source.parent.name == "scripts")
        palette = self.home / ".config/eww/theme-colors.scss"
        if not palette.is_file() or not palette.stat().st_size:
            self.error(f"Missing generated EWW palette: {palette}")
        hypr = self.repo / "src/compositors/hyprland/hypr"
        if self.hyprland_installed():
            for pattern in ("*.conf", "*.lua", "apps/*"):
                for source in hypr.glob(pattern):
                    if source.is_file() and source.name not in USER_HYPR:
                        self.compare(source, self.home / ".config/hypr" / source.relative_to(hypr))
        themes = self.repo / "src/shared/themes"
        for theme in themes.glob("*"):
            if not theme.is_dir() or theme.name.startswith("_"):
                continue
            sources = {path.relative_to(theme): path for path in theme.rglob("*")}
            destinations = [self.home / ".local/share/smplos/themes" / theme.name]
            override = self.home / ".config/smplos/themes" / theme.name
            if override.exists() or override.is_symlink():
                destinations.append(override)
            for destination in destinations:
                if destination.is_symlink():
                    self.error(f"Managed theme directory was not replaced: {destination}")
                    continue
                for relative, source in sources.items():
                    target = destination / relative
                    if source.is_file():
                        self.compare(source, target)
                    elif source.is_dir() and not target.is_dir():
                        self.error(f"Missing managed theme directory: {target}")
                installed = {path.relative_to(destination) for path in destination.rglob("*")}
                for extra in sorted(installed - sources.keys()):
                    self.error(f"Obsolete managed theme entry: {destination / extra}")
        current = self.home / ".config/smplos/current"
        name_file = current / "theme.name"
        if name_file.is_file():
            name = name_file.read_text().strip()
            if not name or Path(name).name != name:
                self.error("Invalid active theme name")
            else:
                selected = self.home / ".config/smplos/themes" / name
                if not selected.is_dir():
                    selected = self.home / ".local/share/smplos/themes" / name
                for filename in ("colors.toml", "eww-colors.scss", "nemo.css", "hyprland.conf", "hyprlock.conf"):
                    source = selected / filename
                    if source.is_file():
                        self.compare(source, current / "theme" / filename)
                for filename, target in (
                    ("eww-colors.scss", ".config/eww/theme-colors.scss"),
                    ("nemo.css", ".config/smplos/nemo-theme.css"),
                    ("hyprland.conf", ".config/hypr/theme.conf"),
                    ("hyprlock.conf", ".config/hypr/hyprlock-theme.conf"),
                    ("micro.theme", ".config/micro/colorschemes/smplos.micro"),
                ):
                    source = current / "theme" / filename
                    if source.is_file():
                        self.compare(source, self.home / target)
        else:
            self.error("Missing active theme name; core theme deployment was not completed")
        unit = self.repo / "src/shared/configs/systemd/user/smplos-session.target"
        if unit.is_file():
            self.compare(unit, self.home / ".config/systemd/user/smplos-session.target")

    def linkage(self, path, *, allow_xr_script=False):
        try:
            if not path.is_file():
                self.error(f"Missing application: {path}")
                return
            if not os.access(path, os.X_OK):
                self.error(f"Application is not executable: {path}")
            if allow_xr_script and path.is_symlink():
                self.error(f"Optional XR application must not be a symlink: {path}")
                return
            with path.open("rb") as stream:
                if stream.read(4) != b"\x7fELF":
                    stream.seek(0)
                    if allow_xr_script and path.name in XR_SCRIPTS and stream.readline(64) in (
                            b"#!/usr/bin/env bash\n", b"#!/bin/bash\n"):
                        result = self.command("bash", "-n", path)
                        if result is not None:
                            if result.returncode:
                                self.error(f"Invalid XR script {path}: {result.stderr.strip()}")
                            else:
                                self.report["linkage"][str(path)] = "Bash XR script; syntax verified"
                        return
                    self.error(f"Application is not an ELF binary: {path}")
                    return
        except OSError as error:
            self.error(f"Cannot inspect {path}: {error}")
            return
        result = self.command("ldd", path)
        if result is None:
            return
        text = result.stdout + result.stderr
        self.report["linkage"][str(path)] = text.strip()
        self.library_paths.update(re.findall(r"(?:=>\s+|^\s*)(/[^\s(]+)", text, re.M))
        static = "statically linked" in text or "not a dynamic executable" in text
        if "not found" in text or (result.returncode and not static):
            self.error(f"Missing/incompatible shared libraries for {path}: {text.strip()}")

    def hyprland_installed(self):
        return "hyprland" in self.report["packages"] or (self.root / "usr/bin/Hyprland").exists()

    def apps(self):
        for name in (*APPS, "st-wl", "micro"):
            self.linkage(self.root / "usr/local/bin" / name)
        for name in ("nemo", "eww"):
            self.linkage(self.root / "usr/bin" / name)
        if self.hyprland_installed():
            self.linkage(self.root / "usr/bin/Hyprland")
        for name in ("nemo-document-renderer", "nemo-archive-create-worker"):
            self.linkage(self.root / "usr/libexec" / name)
        for name in ("control-surfaced", "mouse-remapperd"):
            path = self.root / "usr/bin" / name
            if "control-surface" in self.report["packages"] or path.exists():
                self.linkage(path)
        self.receipt("smpl-apps", APPS)
        self.receipt("st-smpl", ("st-wl",))
        self.receipt("micro-smpl", ("micro",))

    def core_runtime(self):
        for package, paths in CORE_BINARIES.items():
            if package in self.report["packages"]:
                for path in paths:
                    self.linkage(self.root / path)
        if {"yay", "yay-bin", "yay-git"} & self.report["packages"].keys():
            result = self.command(self.root / "usr/bin/yay", "-Q", "pacman")
            if result is None or result.returncode or not result.stdout.startswith("pacman "):
                self.error("Yay cannot read the installed pacman/libalpm database")
    def brave_runtime(self):
        if "brave-bin" in self.report["packages"]:
            listing = self.command("pacman", "-Qql", "brave-bin")
            if listing is None or listing.returncode:
                self.error("Cannot identify Brave's package-owned browser binary")
                return
            binaries = set()
            for line in listing.stdout.splitlines():
                path = self.root / line.lstrip("/")
                if path.name in ("brave", "brave-browser") and path.is_file():
                    with path.open("rb") as stream:
                        if stream.read(4) == b"\x7fELF":
                            binaries.add(path.resolve())
            if not binaries:
                self.error("Brave package has no installed browser ELF binary")
            for path in sorted(binaries):
                self.linkage(path)
                version = self.command(path, "--version")
                if version is None or version.returncode:
                    self.error("Brave's installed browser cannot report its runtime version")
                    continue
                match = re.fullmatch(r"Brave Browser\s+(\d+(?:\.\d+){2,3})(?:\s+.*)?",
                                     version.stdout.strip())
                if not match:
                    self.error(f"Cannot parse Brave's runtime version: {version.stdout.strip()}")
                    continue
                # Some releases prefix the Brave version with Chromium's major.
                browser_version = ".".join(match[1].split(".")[-3:])
                package_version = self.report["packages"]["brave-bin"].split(":")[-1].rsplit("-", 1)[0]
                self.report["brave_runtime"] = {
                    "binary": str(path), "version": browser_version,
                    "output": version.stdout.strip(), "package_version": package_version,
                }
                comparison = self.command("vercmp", browser_version, package_version)
                if comparison is None or comparison.returncode or comparison.stdout.strip() != "0":
                    self.error("Brave's actual browser version does not match its installed package record")

    def capture_brave_target(self):
        item = self.report["brave"] = {
            "package": "brave-bin", "source": "AUR", "before": None, "target": None,
        }
        installed = self.command("pacman", "-Q", "brave-bin")
        if installed is not None and installed.returncode == 0:
            fields = installed.stdout.split()
            if len(fields) == 2 and fields[0] == "brave-bin":
                item["before"] = fields[1]
            else:
                self.error("Cannot parse installed Brave package version")
        elif installed is None or installed.returncode != 1:
            self.error("Cannot inspect installed Brave package version")
        result = self.command("yay", "-Si", "--aur", "brave-bin")
        if result is None or result.returncode:
            self.error("Cannot capture Brave's AUR update target")
            return
        names = re.findall(r"^Name\s*:\s*(\S+)\s*$", result.stdout, re.M)
        versions = re.findall(r"^Version\s*:\s*(\S+)\s*$", result.stdout, re.M)
        if names != ["brave-bin"] or len(versions) != 1 or not re.fullmatch(
                r"[0-9][A-Za-z0-9.+:~_-]*", versions[0]):
            self.error("Cannot parse Brave's AUR update target")
            return
        item["target"] = versions[0]

    def brave_result(self, path):
        captured = json.loads(path.read_text())
        item = captured["brave"]
        if (captured["errors"] or not isinstance(item, dict) or
                item.get("package") != "brave-bin" or item.get("source") != "AUR" or
                not isinstance(item.get("target"), str) or
                not re.fullmatch(r"[0-9][A-Za-z0-9.+:~_-]*", item["target"])):
            raise ValueError("Brave target capture was not successful")
        installed = self.report["packages"].get("brave-bin")
        result = self.report["brave"] = {
            **item, "installed": installed, "status": "unknown",
            "target_record": str(path), "target_time": captured.get("time"),
        }
        if not installed:
            result["status"] = "missing"
            self.error("Brave is not installed; its recorded update target was not met")
            return
        comparison = self.command("vercmp", installed, item["target"])
        if comparison is None or comparison.returncode or comparison.stdout.strip() not in ("-1", "0", "1"):
            self.error("Cannot compare installed Brave against its recorded update target")
        elif comparison.stdout.strip() == "-1":
            result["status"] = "pending"
            self.error(f"Brave was not updated: installed {installed} < recorded target {item['target']}")
        else:
            result["status"] = "current" if comparison.stdout.strip() == "0" else "newer-local"

    def library_owners(self):
        if not self.library_paths:
            return
        result = self.command("pacman", "-Qoq", "--", *sorted(self.library_paths))
        if result is None:
            return
        self.library_packages.update(result.stdout.splitlines())
        packages = self.report["packages"]
        self.report["runtime_library_packages"] = {
            name: packages.get(name) for name in sorted(self.library_packages)
        }
        if result.returncode or not self.library_packages:
            self.report["warnings"].append(
                "Some runtime libraries have no verifiable pacman owner: " + result.stderr.strip()
            )

    def release_results(self, path):
        results = json.loads(path.read_text())["components"]
        if not isinstance(results, dict):
            raise ValueError("components must be an object")
        self.report.setdefault("native_updates", {}).update(
            {name: result for name, result in results.items() if name in RELEASE_COMPONENTS}
        )
        for component in sorted(RELEASE_COMPONENTS):
            result = results.get(component)
            self.release_component_result(component, result)

    def release_component_result(self, component, result):
        if isinstance(result, dict) and result.get("status") == "pinned":
            pin = self.report.get("pin_plan", {}).get("pins", {}).get(component)
            installed = self.report["packages"].get(component)
            if (component not in {"nemo-smpl", "control-surface"} or not pin or
                    result.get("before") != pin["version"] or result.get("after") != installed or
                    installed != pin["version"]):
                self.error(f"{component}: held native package could not be verified against this run's pins")
            return
        if not isinstance(result, dict) or result.get("status") not in ("current", "updated"):
            self.error(f"{component}: native release update was not completed; see native_updates/transcript")
            return
        if not isinstance(result.get("target"), str) or not result["target"]:
            self.error(f"{component}: published release target could not be verified")
            return
        package = component if component in {"nemo-smpl", "control-surface"} else None
        installed = (self.report["packages"].get(package) if package
                     else self.report["app_versions"].get(component))
        target = result["target"].removeprefix("v") + ("-1" if package else "")
        if package and "package_target" in result:
            target = result["package_target"]
            if not isinstance(target, str) or not re.fullmatch(r"[0-9]+(?:\.[0-9]+)*-[0-9]+", target):
                self.error(f"{component}: invalid captured package target")
                return
            if target.rsplit("-", 1)[0] != result["target"].removeprefix("v"):
                self.error(f"{component}: package target differs from captured release")
                return
        if not installed:
            self.error(f"{component}: no installed version matches the release result")
            return
        comparison = self.command("vercmp", installed.removeprefix("v"), target)
        if comparison is None or comparison.returncode or comparison.stdout.strip() not in ("0", "1"):
            self.error(f"{component}: installed {installed} did not reach release target {result['target']}")

    def aur_policy(self):
        foreign_result = self.command("pacman", "-Qmq")
        if foreign_result is None:
            return
        if foreign_result.returncode and (foreign_result.returncode != 1 or
                                         foreign_result.stdout.strip() or foreign_result.stderr.strip()):
            self.error("Cannot inventory foreign packages for core/optional AUR ordering")
            return
        foreign = set(foreign_result.stdout.split())
        packages = self.report["packages"]
        if not foreign <= packages.keys():
            self.error("Foreign package inventory differs from the installed package inventory")
            return
        roots = {name for name in packages if STACK.fullmatch(name) and name not in OPTIONAL_PACKAGES}
        public_libraries = {}

        def inventory_files(names):
            if not names:
                return True
            listing = self.command("pacman", "-Ql", *sorted(names))
            if listing is None or listing.returncode:
                self.error("Cannot identify foreign shared libraries and kernel drivers")
                return False
            for line in listing.stdout.splitlines():
                name, separator, filename = line.partition(" ")
                if not separator or name not in names:
                    self.error(f"Invalid foreign package file inventory: {line}")
                    return False
                library = re.fullmatch(r"/usr/lib(?:32|64)?/([^/]+\.so)(?:\.[^/]*)?", filename)
                if library:
                    public_libraries.setdefault(library[1], set()).add(name)
                if name in foreign and (library or re.match(
                        r"/usr/(?:lib/modules/|src/[^/]+/dkms\.conf$)", filename)):
                    roots.add(name)
            return True

        if not inventory_files(foreign):
            return
        records = self.dependency_metadata()
        if records is None:
            return
        providers = {}
        for name, record in records.items():
            for value in (name, *record["Provides"]):
                if value != "None":
                    providers.setdefault(re.split(r"[<>=]", value, maxsplit=1)[0], set()).add(name)
        library_providers = set().union(*(
            names for provided, names in providers.items() if ".so" in provided
        ))
        if not inventory_files(library_providers - foreign):
            return
        closure, pending = set(), list(roots)
        while pending:
            name = pending.pop()
            if name in closure:
                continue
            closure.add(name)
            for dependency in records[name]["Depends On"]:
                if dependency == "None":
                    continue
                dependency = re.split(r"[<>=]", dependency, maxsplit=1)[0]
                if dependency not in providers:
                    self.error(f"Cannot resolve core dependency {dependency} required by {name}")
                    return
                candidates = providers[dependency]
                if dependency in records:
                    candidates = {dependency}
                elif dependency in public_libraries:
                    # Electron bundles advertise private EGL/GLES sonames too;
                    # they are not the system libraries loaded by core apps.
                    candidates = candidates & public_libraries[dependency]
                if not candidates:
                    self.error(f"No system provider for core dependency {dependency} required by {name}")
                    return
                pending.extend(candidates - closure)
        managed = {"nemo-smpl", "eww-smplos", "control-surface"}
        app_only = {"grafium-bin"}
        excluded = managed | app_only
        self.report["aur_policy"] = {
            "required": sorted((foreign & closure) - excluded),
            "optional": sorted(foreign - closure - excluded),
            "managed_releases": sorted(foreign & managed),
            "app_updates_only": sorted(foreign & app_only),
            "required_closure": sorted(closure),
        }

    def dependency_metadata(self):
        metadata = self.command("pacman", "-Qi")
        if metadata is None or metadata.returncode:
            self.error("Cannot read installed package dependency metadata")
            return
        records, record, field = {}, None, None
        for line in metadata.stdout.splitlines():
            match = re.match(r"^([A-Za-z][A-Za-z ]*?)\s*:\s*(.*)$", line)
            if match:
                key, value = match.groups()
                key = key.strip()
                if key == "Name":
                    if value in records:
                        self.error(f"Duplicate installed package metadata: {value}")
                        return
                    record = records[value] = {}
                field = key if key in ("Provides", "Depends On", "Groups") else None
                if record is not None and field:
                    record.setdefault(field, []).extend(value.split())
            elif line[:1].isspace() and record is not None and field:
                record[field].extend(line.split())
        if records.keys() != self.report["packages"].keys() or any(
                not {"Provides", "Depends On"} <= record.keys() for record in records.values()):
            self.error("Incomplete installed dependency metadata")
            return
        return records

    def pin_policy(self):
        directory = self.repo / "src/shared/update-policy"
        return {name: digest(directory / name)
                for name in ("critical-packages.txt", "critical-bundle.conf")}

    def configured_pins(self, records):
        patterns, groups = [], []
        for directive, output in (("IgnorePkg", patterns), ("IgnoreGroup", groups)):
            result = self.command("pacman-conf", directive)
            if result is None or result.returncode:
                raise RuntimeError(f"Cannot inspect pacman {directive}")
            output.extend(result.stdout.split())
        self.ignored_patterns = patterns
        self.ignored_candidates = set()
        if groups and any("Groups" not in record for record in records.values()):
            raise ValueError("Incomplete installed group metadata")
        pins = {}
        for name, version in self.report["packages"].items():
            if any(fnmatch.fnmatchcase(name, pattern) for pattern in patterns):
                pins[name] = {"version": version, "reason": "user IgnorePkg"}
            elif any(fnmatch.fnmatchcase(group, pattern) for pattern in groups
                     for group in records[name].get("Groups", []) if group != "None"):
                pins[name] = {"version": version, "reason": "user IgnoreGroup"}
        if groups:
            result = self.command("pacman", "-Sgg")
            if result is None or result.returncode not in (0, 1) or result.stderr.strip():
                raise RuntimeError("Cannot inspect repository package groups")
            for line in result.stdout.splitlines():
                group, name = line.split()
                if any(fnmatch.fnmatchcase(group, pattern) for pattern in groups):
                    self.ignored_candidates.add(name)
                    if name in self.report["packages"]:
                        pins[name] = {"version": self.report["packages"][name], "reason": "user IgnoreGroup"}
        required = installed_closure(records, pins)
        for name in (required & {"paru", "paru-bin", "paru-git"}) - pins.keys():
            pins[name] = {"version": self.report["packages"][name],
                          "reason": "required by a configured hold; retirement deferred"}
        return pins

    def user_pin_plan(self):
        inputs = package_inputs(self.command)
        records = self.dependency_metadata()
        if records is not None:
            self.report["pin_plan"] = {
                "pins": self.configured_pins(records), "inputs": inputs,
                "targets": {}, "removals": {},
            }
            if package_inputs(self.command) != inputs:
                self.error("Package databases/configuration changed while inventorying user holds; retry Update OS")

    def ignored_candidate(self, name):
        return name in self.ignored_candidates or any(fnmatch.fnmatchcase(name, pattern) for pattern in self.ignored_patterns)

    def planned_removals(self, targets):
        self.planned_metadata = {}
        if not targets:
            return {}
        result = self.command("pacman", "-Si", *sorted(targets))
        if result is None or result.returncode:
            raise RuntimeError("Cannot inspect planned replacement metadata")
        records, record, field = {}, None, None
        for line in result.stdout.splitlines():
            match = re.match(r"^([A-Za-z][A-Za-z ]*?)\s*:\s*(.*)$", line)
            if match:
                key, value = (part.strip() for part in match.groups())
                if key == "Name":
                    if value in records:
                        raise ValueError(f"Duplicate repository metadata: {value}")
                    record = records[value] = {}
                field = key if key in ("Version", "Replaces", "Conflicts With", "Depends On", "Provides") else None
                if record is not None and field:
                    record.setdefault(field, []).extend(value.split())
            elif line[:1].isspace() and record is not None and field:
                record[field].extend(line.split())
        if records.keys() != targets.keys():
            raise ValueError("Incomplete planned replacement metadata")
        self.planned_metadata = records
        removals = {}
        for name, metadata in records.items():
            if (metadata.get("Version") != [targets[name]] or
                    not {"Replaces", "Conflicts With"} <= metadata.keys()):
                raise ValueError(f"Repository target changed during planning: {name}")
            replacements = list(metadata.get("Replaces", []))
            if name.startswith("qemu-"):
                replacements += [item for item in metadata.get("Conflicts With", [])
                                 if re.split(r"[<>=]", item, maxsplit=1)[0] == "qemu-block-gluster"]
            for value in replacements:
                match = re.fullmatch(r"([^<>=]+)(>=|<=|=|<|>)?(.*)", value)
                package, operator, version = match.groups()
                installed = self.report["packages"].get(package)
                if installed is None:
                    continue
                if operator:
                    comparison = self.command("vercmp", installed, version)
                    if comparison is None or comparison.returncode or comparison.stdout.strip() not in ("-1", "0", "1"):
                        raise RuntimeError(f"Cannot compare replacement version for {package}")
                    if int(comparison.stdout) not in {"=": {0}, "<": {-1}, ">": {1}, "<=": {-1, 0}, ">=": {0, 1}}[operator]:
                        continue
                removals[package] = installed
        return removals

    def plan_pins(self):
        packages = self.report["packages"]
        inputs = package_inputs(self.command)
        records = self.dependency_metadata()
        if records is None:
            return
        pins = self.configured_pins(records)
        plan = self.report["pin_plan"] = {
            "policy": self.pin_policy(), "pins": pins, "targets": {}, "removals": {}, "attempts": [],
            "inputs": inputs,
        }
        if "hyprland" in packages:
            bundle = (self.repo / "src/shared/update-policy/critical-bundle.conf").read_text()
            series = re.findall(r'^HYPRLAND_SERIES="?([0-9]+\.[0-9]+)"?\s*(?:#.*)?$', bundle, re.M)
            available = self.command("pacman", "-Si", "hyprland")
            versions = re.findall(r"^Version\s*:\s*(\S+)$", available.stdout, re.M) if available else []
            if len(series) != 1 or len(versions) != 1 or available.returncode:
                self.error("Cannot establish the approved and available Hyprland series")
                return
            approved_available = versions[0].split(":")[-1].startswith(series[0] + ".")
            if not packages["hyprland"].split(":")[-1].startswith(series[0] + "."):
                comparison = self.command("vercmp", packages["hyprland"], versions[0])
                if (not approved_available or comparison is None or comparison.returncode
                        or comparison.stdout.strip() != "-1"):
                    self.error("Installed Hyprland is outside the approved series; refusing an automatic downgrade")
                    return
            if not approved_available:
                patterns = (self.repo / "src/shared/update-policy/critical-packages.txt").read_text().splitlines()
                for pattern in patterns:
                    pattern = pattern.split("#", 1)[0].strip()
                    if not pattern:
                        continue
                    if not re.fullmatch(r"[a-zA-Z0-9@._+*?-]+", pattern):
                        raise ValueError(f"Invalid protected package pattern: {pattern}")
                    for name, version in packages.items():
                        if fnmatch.fnmatchcase(name, pattern):
                            pins.setdefault(name, {"version": version, "reason": f"approved desktop stack ({series[0]})"})
                if "hyprland" not in pins:
                    self.error("Protected stack policy does not include Hyprland")
                    return
        for _ in range(len(packages) + 1):
            arguments = ["pacman", "-Su", "--print", "--print-format", "%n %v", "--noconfirm"]
            if "qemu-block-gluster" in packages:
                arguments += ["--ask", "4"]
            if pins:
                arguments += ["--ignore", ",".join(sorted(pins))]
            result = self.command(*arguments)
            if result is None:
                return
            transcript = result.stdout + result.stderr
            plan["attempts"].append({"ignore": sorted(pins), "output": transcript,
                                     "returncode": result.returncode})
            if result.returncode == 0:
                for line in result.stdout.splitlines():
                    fields = line.split()
                    if len(fields) != 2 or not re.fullmatch(r"[a-zA-Z0-9@._+-]+", fields[0]):
                        self.error(f"Invalid pacman transaction preview: {line}")
                        return
                    name, version = fields
                    if name in pins:
                        self.error(f"Pacman selected protected package {name} for installation")
                        return
                    plan["targets"][name] = version
                plan["removals"] = self.planned_removals(plan["targets"])
                blocked = {name for name in plan["targets"] if self.ignored_candidate(name)}
                for name, metadata in self.planned_metadata.items():
                    if any(re.split(r"[<>=]", value, maxsplit=1)[0] in pins and
                           re.split(r"[<>=]", value, maxsplit=1)[0] in plan["removals"]
                           for value in metadata.get("Replaces", []) + metadata.get("Conflicts With", [])):
                        blocked.add(name)
                while blocked:
                    provided = {re.split(r"[<>=]", value, maxsplit=1)[0] for name in blocked
                                for value in (name, *self.planned_metadata[name].get("Provides", []))}
                    dependents = {name for name, metadata in self.planned_metadata.items()
                                  if any(re.split(r"[<>=]", value, maxsplit=1)[0] in provided
                                         for value in metadata.get("Depends On", []))}
                    if dependents <= blocked:
                        break
                    blocked.update(dependents)
                additions = blocked.intersection(packages).difference(pins)
                if blocked:
                    if not additions:
                        self.error("Configured holds prevent the prepared dependency/replacement transaction")
                        return
                    for name in additions:
                        pins[name] = {"version": packages[name], "reason": "preserves configured dependency/replacement holds"}
                    plan["targets"] = {}
                    plan["removals"] = {}
                    continue
                if package_inputs(self.command) != inputs:
                    self.error("Package databases/configuration changed during planning; retry Update OS")
                return
            additions = {}
            provided = {
                re.split(r"[<>=]", value, maxsplit=1)[0]
                for name in pins for value in (name, *records[name]["Provides"]) if value != "None"
            }
            required = installed_closure(records, pins)
            for line in transcript.splitlines():
                broken = re.fullmatch(
                    r":: installing (\S+) \([^)]+\) breaks dependency '([^']+)' required by (\S+)", line)
                missing = re.fullmatch(r":: unable to satisfy dependency '([^']+)' required by (\S+)", line)
                if broken and broken[3] in required:
                    if broken[3] not in pins:
                        additions[broken[3]] = "installed dependency of the protected stack"
                    additions[broken[1]] = f"preserves {broken[2]} required by {broken[3]}"
                elif missing and re.split(r"[<>=]", missing[1], maxsplit=1)[0] in provided:
                    additions[missing[2]] = f"requires {missing[1]}, unavailable with the approved stack"
                elif missing and self.ignored_candidate(re.split(r"[<>=]", missing[1], maxsplit=1)[0]):
                    additions[missing[2]] = f"requires {missing[1]}, blocked by a configured package/group hold"
            additions = {name: reason for name, reason in additions.items()
                         if name in packages and name not in pins}
            if not additions:
                self.error(f"Cannot resolve an update preserving the approved stack:\n{transcript}")
                return
            for name, reason in additions.items():
                pins[name] = {"version": packages[name], "reason": reason}
        self.error("Protected dependency planning did not converge")

    def load_pins(self, path, previous):
        record = json.loads(path.read_text())
        plan = record["pin_plan"]
        pins = plan["pins"]
        if not isinstance(pins, dict):
            raise ValueError("Invalid protected package inventory")
        retired = {"paru", "paru-bin", "paru-git"}
        baseline = {name: version for name, version in previous["packages"].items() if name not in retired}
        planned = {name: version for name, version in record["packages"].items() if name not in retired}
        if (record["errors"] or planned != baseline
                or record["source_commit"] != self.report.get("source_commit")
                or plan["policy"] != self.pin_policy() or not plan["attempts"]
                or plan["attempts"][-1]["returncode"] != 0):
            raise ValueError("Pin plan is failed, stale, or does not match this update's baseline/policy")
        for name, item in pins.items():
            if (not re.fullmatch(r"[a-zA-Z0-9@._+-]+", name) or not isinstance(item, dict)
                    or not isinstance(item["version"], str) or not item["version"]
                    or item["version"] != previous["packages"].get(name)
                    or not isinstance(item["reason"], str) or not item["reason"].strip()):
                raise ValueError(f"Invalid protected package record: {name}")
            if self.report["packages"].get(name) != item["version"]:
                self.error(f"Protected package changed or was removed: {name}; expected {item['version']}")
        self.report["pin_plan"] = plan

    def receipt(self, component, names):
        state = self.home / ".local/state/smplos/app-versions"
        marker = state / component
        if not marker.is_file() or not marker.read_text().strip():
            self.error(f"No installed {component} version marker; retry Update OS")
        receipt = state / f"{component}.sha256"
        if not receipt.is_file():
            self.error(f"No installed {component} release checksum receipt; retry Update OS")
            return
        entries = receipt.read_text().splitlines()
        recorded = {
            fields[1].lstrip("*") for line in entries
            if len(fields := line.split(maxsplit=1)) == 2
        }
        expected = {str(self.root / "usr/local/bin" / name) for name in names}
        retained = {}
        # Optional bundled executables are verified when delivered, not required
        # on machines whose release never included them.
        if component == "smpl-apps":
            optional = ("xr-workspace", "xrctl", "xr-game", "xr-glasses-hotplugd")
            for name in optional:
                path = self.root / "usr/local/bin" / name
                if path.exists() or path.is_symlink() or str(path) in recorded:
                    expected.add(str(path))
                    self.linkage(path, allow_xr_script=True)
            retained_receipt = state / "smpl-apps-retained.sha256"
            if retained_receipt.is_file():
                optional_paths = {str(self.root / "usr/local/bin" / name) for name in optional}
                for line in retained_receipt.read_text().splitlines():
                    fields = line.split(maxsplit=1)
                    if (len(fields) != 2 or not re.fullmatch(r"[0-9a-f]{64}", fields[0])
                            or fields[1] not in optional_paths):
                        self.error("Malformed retained optional smpl-apps checksum receipt")
                        continue
                    retained[fields[1]] = fields[0]
                    if fields[1] not in expected:
                        expected.add(fields[1])
                        self.linkage(Path(fields[1]), allow_xr_script=True)
                    entries.append(line)
        checked = set()
        files = self.report.setdefault("native_files", {})
        for line in entries:
            fields = line.split(maxsplit=1)
            if len(fields) != 2 or not re.fullmatch(r"[0-9a-f]{64}", fields[0]):
                self.error(f"Malformed {component} release checksum receipt")
                continue
            checksum, filename = fields
            filename = filename.lstrip("*")
            if filename in expected:
                if filename in checked:
                    self.error(f"Duplicate native app checksum entry: {filename}")
                checked.add(filename)
                path = Path(filename)
                actual = digest(path) if path.is_file() else None
                files[filename] = {
                    "component": component, "expected_sha256": checksum,
                    "installed_sha256": actual, "status": "verified" if actual == checksum else "mismatch",
                }
                if filename in retained:
                    files[filename]["delivery"] = "retained-not-upgraded"
                    if retained[filename] != checksum:
                        self.error(f"Retained optional checksum differs from installed receipt: {path}")
                    self.report["warnings"].append(
                        f"Optional native app retained from an earlier release, not upgraded: {path}"
                    )
                if actual != checksum:
                    origin = "retained checksum receipt" if filename in retained else "release receipt"
                    self.error(f"Installed native app differs from its {origin}: {path}")
        if checked != expected:
            self.error(f"Installed {component} checksum receipt is incomplete")
        if retained.keys() - checked:
            self.error("Retained optional smpl-apps receipt is not covered by installed checksums")

    def repository_versions(self):
        result = self.command("pacman", "-Sl")
        repositories = {}
        valid = result is not None and result.returncode == 0 and bool(result.stdout.strip())
        if valid:
            for line in result.stdout.splitlines():
                fields = line.split()
                if len(fields) < 3:
                    self.error(f"Cannot parse repository package inventory: {line}")
                    valid = False
                    continue
                repository, name, version = fields[:3]
                # The first configured repository wins, not the newest version.
                repositories.setdefault(name, {"repository": repository, "available": version})
        else:
            self.error("Cannot compare installed packages with configured repository versions")
        self.report["repository_comparison_valid"] = valid
        statuses = self.report["package_status"] = {}
        pins = self.report.get("pin_plan", {}).get("pins", {})
        for name, installed in sorted(self.report["packages"].items()):
            target = repositories.get(name, {})
            available = target.get("available")
            status = "not-in-repositories" if valid else "unknown"
            if available == installed:
                status = "current"
            elif available:
                comparison = self.command("vercmp", installed, available)
                if comparison is None or comparison.returncode or comparison.stdout.strip() not in ("-1", "0", "1"):
                    self.error(f"Cannot compare installed and repository versions of {name}")
                    status = "unknown"
                elif comparison.stdout.strip() == "-1":
                    if name in pins and installed == pins[name]["version"]:
                        status = "pinned"
                    else:
                        status = "pending"
                        self.error(f"Package was not updated: {name} {installed} -> {available}")
                elif comparison.stdout.strip() == "0":
                    status = "current"
                else:
                    status = "newer-local"
            statuses[name] = {"installed": installed, "status": status, **target}
            if name in pins:
                statuses[name]["pin_reason"] = pins[name]["reason"]
        foreign = sum(item["status"] == "not-in-repositories" for item in statuses.values())
        if foreign:
            self.report["warnings"].append(
                f"{foreign} AUR/local packages are outside configured repositories; "
                "repository comparison alone cannot certify their latest release"
            )

    def system(self):
        result = self.command("pacman", "-Dk")
        if result is not None and result.returncode:
            self.error(f"Package database/dependencies are inconsistent: {result.stdout}{result.stderr}")
        result = self.command("pacman", "-Qu")
        if result is not None:
            self.report["pending_repo_updates"] = result.stdout.splitlines()
            pins = self.report.get("pin_plan", {}).get("pins", {})
            unexpected = []
            for line in result.stdout.splitlines():
                fields = line.split()
                if (len(fields) not in (4, 5) or len(fields) == 5 and fields[4] != "[ignored]" or
                        fields[2] != "->" or fields[0] not in pins
                        or fields[1] != pins[fields[0]]["version"]):
                    unexpected.append(line)
            if unexpected or result.stderr.strip() or result.returncode not in (0, 1):
                self.error(f"Repository updates remain or could not be checked: {result.stdout}{result.stderr}")
        packages = self.report["packages"]
        recipe = self.repo / "src/shared/pkgbuilds/eww-smplos/PKGBUILD"
        if recipe.is_file():
            commit = re.search(r"^_commit=([0-9a-f]{7})", recipe.read_text(), re.M)
            if commit and f".g{commit[1]}-" not in packages.get("eww-smplos", ""):
                self.error("EWW fork is missing or behind the required commit; its migration remains incomplete")
        self.repository_versions()
        critical = sorted(
            name for name in packages
            if (STACK.fullmatch(name) and name not in OPTIONAL_PACKAGES) or name in self.library_packages
        )
        self.report["critical_packages"] = critical
        if critical:
            result = self.command("sudo", "-n", "pacman", "-Qk", *critical)
            if result is not None:
                self.report["critical_package_files"] = result.stdout + result.stderr
                if result.returncode:
                    self.error("Critical package files could not be verified; see critical_package_files in the report")
        installed_modules = []
        for kernel in sorted(KERNELS & packages.keys()):
            artifacts = {}
            for name in (f"vmlinuz-{kernel}", f"initramfs-{kernel}.img"):
                path = self.root / "boot" / name
                result = self.command("sudo", "-n", "stat", "-L", "-c", "%f %s", "--", path)
                if result is None:
                    continue
                if result.returncode:
                    self.error(f"Cannot inspect boot artifact {path}: {result.stdout}{result.stderr}")
                    continue
                fields = result.stdout.split()
                if len(fields) != 2 or not re.fullmatch(r"[0-9a-fA-F]+", fields[0]) or not fields[1].isdigit():
                    self.error(f"Invalid boot artifact metadata for {path}: {result.stdout}")
                    continue
                if not stat.S_ISREG(int(fields[0], 16)) or not int(fields[1]):
                    self.error(f"Missing/empty boot artifact: {path}; repair before rebooting")
                    continue
                artifacts[name] = path
            listing = self.command("pacman", "-Qql", kernel)
            if listing is None or listing.returncode:
                self.error(f"Cannot identify package-owned kernel modules for {kernel}")
                continue
            # kernel-modules-hook retains old trees: those are not the next
            # boot's installed kernel and must not determine this check.
            module_dirs = [
                (self.root / line.lstrip("/")).parent for line in listing.stdout.splitlines()
                if re.fullmatch(r"/?usr/lib/modules/[^/]+/pkgbase", line)
            ]
            if len(module_dirs) != 1:
                self.error(f"Cannot identify the installed module tree for {kernel}")
                continue
            modules = module_dirs[0]
            installed_modules.append(modules)
            boot_kernel = self.root / "boot" / f"vmlinuz-{kernel}"
            packaged_kernel = modules / "vmlinuz"
            if boot_kernel.name in artifacts:
                result = self.command("sudo", "-n", "sha256sum", "--", boot_kernel, packaged_kernel)
                if result is not None:
                    checksums = [line.split(maxsplit=1)[0] for line in result.stdout.splitlines()]
                    if result.returncode or len(checksums) != 2 or any(
                        not re.fullmatch(r"[0-9a-f]{64}", value) for value in checksums
                    ):
                        self.error(f"Cannot verify boot kernel for {kernel}: {result.stdout}{result.stderr}")
                    elif checksums[0] != checksums[1]:
                        self.error(f"Boot kernel does not match installed {kernel} modules; repair before rebooting")
            image = self.root / "boot" / f"initramfs-{kernel}.img"
            result = self.command("sudo", "-n", "lsinitcpio", "-l", image)
            if result is not None:
                if result.returncode:
                    self.error(f"Cannot inspect initramfs {image}: {result.stdout}{result.stderr}")
                elif f"usr/lib/modules/{modules.name}/" not in result.stdout:
                    self.error(f"Initramfs does not contain the installed {kernel} module version {modules.name}")
        driver_versions = {
            version.split(":")[-1].rsplit("-", 1)[0]
            for name, version in packages.items()
            if re.fullmatch(r"nvidia(?:-open|-[0-9]+xx)?(?:-lts|-dkms)?", name)
        }
        if driver_versions:
            checked = 0
            self.report["nvidia_modules"] = {}
            for modules in installed_modules:
                checked += 1
                release = modules.name
                result = self.command("modinfo", "-k", release, "-F", "filename", "nvidia")
                if result is None or result.returncode or not result.stdout.strip():
                    self.error(f"NVIDIA module missing for installed kernel {release}; repair before rebooting")
                    continue
                details = {"filename": result.stdout.strip()}
                self.report["nvidia_modules"][release] = details
                for field in ("version", "vermagic"):
                    result = self.command("modinfo", "-k", release, "-F", field, "nvidia")
                    if result is None or result.returncode:
                        self.error(f"Cannot verify NVIDIA {field} for {release}")
                        continue
                    details[field] = result.stdout.strip()
                if details.get("version") not in driver_versions:
                    self.error(f"NVIDIA module version for {release} differs from its installed driver package")
                if details.get("vermagic", "").split(" ", 1)[0] != release:
                    self.error(f"NVIDIA module was not built for installed kernel {release}")
            if not checked:
                self.error("Cannot verify NVIDIA driver: installed kernel module metadata is missing")

    def changes(self, previous):
        packages = previous["packages"]
        self.report["package_changes"] = {
            name: {"before": packages.get(name), "after": self.report["packages"].get(name)}
            for name in sorted(packages.keys() | self.report["packages"].keys())
            if packages.get(name) != self.report["packages"].get(name)
        }
        versions = previous.get("app_versions", {})
        self.report["app_version_changes"] = {
            name: {"before": versions.get(name), "after": self.report["app_versions"].get(name)}
            for name in sorted((versions.keys() | self.report["app_versions"].keys()) & RELEASE_COMPONENTS)
            if versions.get(name) != self.report["app_versions"].get(name)
        }
        for name, item in self.report.get("package_status", {}).items():
            item["before"] = packages.get(name)
            item["changed"] = packages.get(name) != item["installed"]

    def summary(self):
        brave = self.report.get("brave")
        if brave:
            print(f"  Brave: {brave.get('before') or 'absent'} -> "
                  f"{brave.get('installed') or 'not yet verified'}; "
                  f"recorded target={brave.get('target') or 'unknown'}; "
                  f"{brave.get('status', 'target captured')}")
        runtime = self.report.get("brave_runtime")
        if runtime:
            print(f"  Brave on-disk browser: {runtime['version']}. "
                  "Restart already-open Brave windows to use the installed binary.")
        statuses = self.report.get("package_status", {})
        if statuses:
            print("  Critical apps, update tools and runtime libraries (before -> installed; repository target; status):")
            for name in self.report["critical_packages"]:
                item = statuses[name]
                target = item.get("available") or (
                    "AUR/local" if item["status"] == "not-in-repositories" else "unknown"
                )
                print(f"  {name}: {item.get('before') or 'not recorded'} -> {item['installed']}; "
                      f"target={target}; {item['status']}")
            print(f"  Compared {len(statuses)} installed packages; "
                  f"{sum(item['status'] == 'pending' for item in statuses.values())} unexpectedly pending; "
                  f"{sum(item['status'] == 'pinned' for item in statuses.values())} deliberately deferred.")
        for name, item in sorted(self.report.get("pin_plan", {}).get("pins", {}).items()):
            print(f"  Protected {name} {item['version']}: {item['reason']}")
        if self.report.get("pin_plan", {}).get("pins"):
            print("  Protected packages were retained, not updated; their security fixes may also be deferred.")
        for name, change in self.report.get("package_changes", {}).items():
            print(f"  Package change {name}: {change['before'] or 'absent'} -> {change['after'] or 'removed'}")
        for name, item in sorted(self.report.get("native_updates", {}).items()):
            if not isinstance(item, dict):
                print(f"  Native {name}: invalid release result")
                continue
            print(f"  Native {name}: {item.get('before') or 'not recorded'} -> "
                  f"{item.get('after') or 'not recorded'}; "
                  f"target={item.get('package_target') or item.get('target') or 'unknown'}; "
                  f"{item.get('status', 'unknown')}"
                  + ("; Testing needed" if item.get("status") == "updated" else ""))

    def session(self):
        if not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
            self.report["warnings"].append("No graphical session; live bar/config checks deferred")
            return
        result = self.command("eww", "--config", self.home / ".config/eww", "active-windows")
        if result is not None:
            if result.returncode or not any(line.split(":", 1)[0] == "bar" for line in result.stdout.splitlines()):
                self.error("EWW bar is not open; inspect ~/.local/state/smplos/eww-startup.log")
        if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            result = self.command("hyprctl", "configerrors")
            if result is not None:
                self.report["hyprland_config_errors"] = result.stdout + result.stderr
                if result.returncode or result.stdout.strip() not in ("", "ok"):
                    self.error(f"Hyprland reports configuration errors: {result.stdout}{result.stderr}")

    def verify(self, mode):
        self.report["mode"] = mode
        checks = [self.apps]
        try:
            self.managed_files(desktop=mode == "full")
        except OSError as error:
            self.error(f"Managed-file verification could not finish: {error}")
        if mode == "bootstrap":
            return self.report
        if mode == "full":
            checks.append(self.core_runtime)
            if not self.core_only:
                self.optional_check("Brave runtime", self.brave_runtime)
        checks.append(self.library_owners)
        if mode == "full":
            checks.extend((self.system, self.session))
        for check in checks:
            try:
                check()
            except (OSError, ValueError) as error:
                self.error(f"{check.__name__} verification could not finish: {error}")
        return self.report


def main():
    if len(sys.argv) == 3 and sys.argv[1] in ("--pin-guard", "--pin-commit"):
        try:
            targets = set(sys.stdin.read().splitlines()) if sys.argv[1] == "--pin-guard" else None
            verify_pin_transaction(Path(sys.argv[2]), targets)
        except (OSError, ValueError, KeyError, TypeError, RuntimeError) as error:
            print(f"ERROR: protected-stack transaction: {error}", file=sys.stderr)
            return 1
        return 0
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--snapshot", action="store_true", help="Inventory only, before update")
    parser.add_argument("--core-only", action="store_true", help="Verify core before optional app work")
    parser.add_argument("--classify-aur", action="store_true", help="Classify local foreign-package dependency closure")
    parser.add_argument("--plan-pins", action="store_true", help="Resolve upgrades around the approved desktop stack")
    parser.add_argument("--user-pins", action="store_true", help="Inventory configured package/group holds before cleanup")
    parser.add_argument("--pins-report", type=Path, help="This run's successful protected-stack transaction plan")
    parser.add_argument("--optional-apps-report", type=Path,
                        help="Legacy option; no optional native apps are OS-managed")
    parser.add_argument("--optional-warning", action="append", default=[])
    parser.add_argument("--required-error", action="append", default=[])
    parser.add_argument("--mode", choices=("full", "apps", "bootstrap"), default="full")
    parser.add_argument("--before", type=Path)
    parser.add_argument("--apps-report", type=Path, help="This run's native release outcomes")
    parser.add_argument("--capture-brave-target", action="store_true",
                        help="Record the AUR Brave target before upgrading, without installing anything")
    parser.add_argument("--brave-report", type=Path, help="Require Brave to meet this recorded AUR target")
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    inventory_actions = (args.snapshot, args.classify_aur, args.capture_brave_target, args.plan_pins, args.user_pins)
    verification_options = (
        args.before or args.apps_report or args.optional_apps_report or args.brave_report
        or args.core_only or args.optional_warning or args.required_error or args.pins_report
    )
    if sum(inventory_actions) > 1 or (
            (any(inventory_actions) or args.mode == "bootstrap") and verification_options):
        parser.error("inventory/bootstrap actions cannot be combined with installed-state verification options")
    if args.mode != "full" and (args.classify_aur or args.capture_brave_target or args.plan_pins or args.user_pins or args.pins_report) or (
            args.mode == "bootstrap" and args.snapshot):
        parser.error("this inventory action requires full mode")
    if args.pins_report and not args.before:
        parser.error("--pins-report requires this run's --before snapshot")
    if args.core_only and (args.optional_apps_report or args.brave_report or args.optional_warning):
        parser.error("core verification cannot include optional application results")
    home = Path.home()
    repo = Path(os.environ.get("SMPLOS_PATH", home / ".local/share/smplos")) / "repo"
    audit = Audit(home, repo, core_only=args.core_only)
    report = audit.report
    try:
        if args.capture_brave_target:
            audit.capture_brave_target()
        elif args.mode == "bootstrap":
            commit = audit.command("git", "-C", repo, "rev-parse", "HEAD")
            if commit is None or commit.returncode:
                audit.error("Cannot identify bootstrap source commit")
            else:
                report["source_commit"] = commit.stdout.strip()
        else:
            audit.snapshot()
        previous = json.loads(args.before.read_text()) if args.before else None
        if args.pins_report:
            audit.load_pins(args.pins_report, previous)
        if args.user_pins:
            audit.user_pin_plan()
        elif args.plan_pins:
            audit.plan_pins()
        elif args.classify_aur:
            audit.aur_policy()
        elif not args.snapshot and not args.capture_brave_target:
            audit.verify(args.mode)
            if args.brave_report:
                try:
                    audit.optional_check("Brave update target", audit.brave_result, args.brave_report)
                except (OSError, ValueError, KeyError, TypeError) as error:
                    audit.optional_error(f"Brave update target could not be verified: {error}")
            if args.apps_report:
                try:
                    audit.release_results(args.apps_report)
                except (OSError, ValueError, KeyError, TypeError) as error:
                    audit.error(f"Native release results unavailable; delivery was skipped or interrupted: {error}")
            if args.optional_apps_report:
                print("Legacy optional native report ignored: no optional native apps are OS-managed.")
        for warning in args.optional_warning:
            audit.optional_error(warning)
        for error in args.required_error:
            audit.error(error)
        if args.before:
            audit.changes(previous)
    except (OSError, RuntimeError, ValueError, KeyError, TypeError) as error:
        audit.error(f"Update verification could not finish: {error}")
    try:
        save_report(args.output, report)
    except OSError as error:
        print(f"Cannot save update verification report: {error}", file=sys.stderr)
        return 1
    if not args.snapshot and not args.classify_aur:
        audit.summary()
    for text in report["warnings"]:
        print(f"  WARNING: {text}")
    for text in report["errors"]:
        print(f"  ERROR: {text}", file=sys.stderr)
    print(f"  Verification report: {args.output}")
    if report["errors"]:
        return 1
    return 2 if report["optional_failures"] else 0


if __name__ == "__main__":
    sys.exit(main())

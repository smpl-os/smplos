#!/bin/bash
# smplOS Theme Switcher
# Sets the active theme and regenerates all configs
# Usage: theme-set <theme-name>

THEME_SCOPE=all
case "${1:-}" in
  --core) THEME_SCOPE=core; shift ;;
  --apps) THEME_SCOPE=apps; shift ;;
esac
if [[ -z ${1:-} && "$THEME_SCOPE" != apps ]]; then
  echo "Usage: theme-set [--core] <theme-name> | theme-set --apps"
  exit 1
fi

SMPLOS_PATH="${SMPLOS_PATH:-$HOME/.local/share/smplos}"
CURRENT_PATH="$HOME/.config/smplos/current"
CURRENT_THEME_PATH="$CURRENT_PATH/theme"
USER_THEMES_PATH="$HOME/.config/smplos/themes"
STOCK_THEMES_PATH="$SMPLOS_PATH/themes"

die() {
  echo "theme-set: $*" >&2
  exit 1
}

# An elevated updater must drop privileges before writing the user's configs.
if [[ $EUID -eq 0 && "$(stat -c %u "$HOME")" != 0 ]]; then
  die "Refusing to write root-owned theme files in $HOME. Run theme-set as the desktop user."
fi

resolve_theme_path() {
  local name="$1"
  if [[ -d "$USER_THEMES_PATH/$name" ]]; then
    echo "$USER_THEMES_PATH/$name"
  elif [[ -d "$STOCK_THEMES_PATH/$name" ]]; then
    echo "$STOCK_THEMES_PATH/$name"
  else
    return 1
  fi
}

toml_get() {
  local file="$1" key="$2"
  awk -v key="$key" '$0 ~ ("^" key "[[:space:]]*=") {
    n = split($0, parts, "\""); print n >= 3 ? parts[2] : $0; exit
  }' "$file"
}

hyprland_request() {
  local reply
  reply=$(timeout 3 hyprctl "$@" 2>&1) || die "Hyprland request failed ($*): $reply"
  [[ "$reply" == ok ]] || die "Hyprland request rejected ($*): $reply"
}

apply_hyprland_environment() {
  [[ -n "${WAYLAND_DISPLAY:-}" && -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || return 0
  local probe probe_status=0 version
  probe=$(timeout 3 hyprctl eval "assert(type(hl.env) == 'function')" 2>&1) || probe_status=$?
  if [[ $probe_status -eq 0 && "$probe" == ok ]]; then
    hyprland_request eval "hl.env('GTK_THEME', '')"
    return
  fi
  if [[ $probe_status -ne 0 || "$probe" != "eval is only supported with the lua config manager" ]]; then
    version=$(timeout 3 hyprctl version 2>&1) || die "Cannot query running compositor: $version"
    if [[ ! "$version" =~ ^Hyprland[[:space:]]v?0\.([0-9]+)\.([0-9]+)[[:space:]] ]] \
        || (( 10#${BASH_REMATCH[1]} > 54 )); then
      die "Unsupported/unavailable Hyprland environment API: $probe"
    fi
  fi
  hyprland_request keyword env "GTK_THEME,"
}

# Normalize theme name: strip markup, lowercase, spaces to hyphens
THEME_NAME=$(echo "${1:-}" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

# Resolve theme path (user themes take precedence)
if [[ "$THEME_SCOPE" != apps ]] && ! THEME_PATH="$(resolve_theme_path "$THEME_NAME")"; then
  echo "Theme '$THEME_NAME' does not exist"
  exit 1
fi

# Serialize the entire switch, including app reloads. Explicit unlock prevents
# long-lived child processes from keeping the lock after this script exits.
mkdir -p "$CURRENT_PATH" || die "Cannot create $CURRENT_PATH"
exec 9>"$CURRENT_PATH/.theme-set.lock" || die "Cannot open theme lock"
flock 9 || die "Cannot lock theme state"
mkdir -p "$HOME/.config/eww" || die "Cannot create EWW config directory"
exec 8>"$HOME/.config/eww/.smplos-reload.lock" || die "Cannot open EWW publication lock"
flock 8 || die "Cannot lock EWW publication"
trap 'flock -u 8; flock -u 9' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ "$THEME_SCOPE" != apps ]]; then
[[ -s "$THEME_PATH/colors.toml" ]] || die "Theme '$THEME_NAME' has no colors.toml"
NEXT_THEME_PATH=$(mktemp -d "$CURRENT_PATH/.theme-set.XXXXXX") || die "Cannot stage theme"
PREVIOUS_THEME_PATH="${NEXT_THEME_PATH}.previous"
if ! cp -r "$THEME_PATH/." "$NEXT_THEME_PATH/theme"; then
  rm -rf -- "$NEXT_THEME_PATH"
  die "Cannot copy theme '$THEME_NAME'; active theme is unchanged"
fi
printf '%s\n' "$THEME_NAME" > "$NEXT_THEME_PATH/theme.name" || die "Cannot stage theme name"

# A same-parent rename needs no write access to the old directory itself.
# Moving it inside the staging directory would fail on its protected ".." entry.
if [[ -e "$CURRENT_THEME_PATH" || -L "$CURRENT_THEME_PATH" ]]; then
  mv -T "$CURRENT_THEME_PATH" "$PREVIOUS_THEME_PATH" \
    || die "Cannot move old theme; active theme is unchanged"
fi
if ! mv -T "$NEXT_THEME_PATH/theme" "$CURRENT_THEME_PATH"; then
  if [[ -e "$PREVIOUS_THEME_PATH" || -L "$PREVIOUS_THEME_PATH" ]]; then
    mv -T "$PREVIOUS_THEME_PATH" "$CURRENT_THEME_PATH" \
      || die "Cannot restore old theme; recovery copy is $PREVIOUS_THEME_PATH"
  fi
  die "Cannot activate theme '$THEME_NAME'"
fi
mv -fT "$NEXT_THEME_PATH/theme.name" "$CURRENT_PATH/theme.name" \
  || die "Cannot record active theme name"
if [[ -e "$PREVIOUS_THEME_PATH" ]] && {
  [[ ! -O "$PREVIOUS_THEME_PATH" ]] ||
    [[ -n "$(find "$PREVIOUS_THEME_PATH" -type d ! -writable -print -quit)" ]]
}; then
  echo "theme-set: Preserved old theme at $PREVIOUS_THEME_PATH" >&2
else
  rm -rf -- "$PREVIOUS_THEME_PATH" || die "Cannot clean previous theme"
fi
rm -rf -- "$NEXT_THEME_PATH" || die "Cannot clean theme staging directory"

# Link EWW theme colors into EWW config dir
if [[ -f "$CURRENT_THEME_PATH/eww-colors.scss" ]] &&
    ! cmp -s "$CURRENT_THEME_PATH/eww-colors.scss" "$HOME/.config/eww/theme-colors.scss"; then
  mkdir -p "$HOME/.config/eww"
  cp "$CURRENT_THEME_PATH/eww-colors.scss" "$HOME/.config/eww/theme-colors.scss.tmp" \
    && mv -f "$HOME/.config/eww/theme-colors.scss.tmp" "$HOME/.config/eww/theme-colors.scss" \
    || die "Cannot deploy EWW theme"
fi

# Bake theme colors into SVG icon templates
# Templates in icons/status/ have {{accent}} and {{fg-dim}} placeholders
# We re-copy from source and replace with actual hex values each theme switch
_accent=$(grep '^accent' "$CURRENT_THEME_PATH/colors.toml" 2>/dev/null | head -1 | sed 's/.*"\(#[^"]*\)".*/\1/')
_fg=$(grep '^foreground' "$CURRENT_THEME_PATH/colors.toml" 2>/dev/null | head -1 | sed 's/.*"\(#[^"]*\)".*/\1/')
_bg=$(grep '^background' "$CURRENT_THEME_PATH/colors.toml" 2>/dev/null | head -1 | sed 's/.*"\(#[^"]*\)".*/\1/')
_fg=${_fg:-#888888}
_accent=${_accent:-#888888}
_bg=${_bg:-#1e1e2e}
if [[ "$(toml_get "$CURRENT_THEME_PATH/colors.toml" glass)" == true ]]; then
  _glass_accent=$(toml_get "$CURRENT_THEME_PATH/colors.toml" glass_accent)
  _glass_fg=$(toml_get "$CURRENT_THEME_PATH/colors.toml" glass_foreground)
  _accent=${_glass_accent:-$_accent}
  _fg=${_glass_fg:-$_fg}
fi
EWW_ICONS_TPL="$HOME/.local/share/smplos/icons/status"
EWW_ICONS_DST="$HOME/.config/eww/icons/status"
if [[ -d "$EWW_ICONS_TPL" ]]; then
  mkdir -p "$EWW_ICONS_DST"
  for svg in "$EWW_ICONS_TPL"/*.svg; do
    [[ -f "$svg" ]] || continue
    sed "s/{{accent}}/$_accent/g; s/{{fg}}/$_fg/g; s/{{bg}}/$_bg/g" "$svg" > "$EWW_ICONS_DST/$(basename "$svg")"
  done
fi

# Compositor-specific theme configs
# Always copy if the files exist -- during install (chroot) there's no
# WAYLAND_DISPLAY yet, but the configs must be in place for first boot.
if [[ -f "$CURRENT_THEME_PATH/hyprland.conf" ]]; then
  mkdir -p "$HOME/.config/hypr"
  cp "$CURRENT_THEME_PATH/hyprland.conf" "$HOME/.config/hypr/theme.conf"
fi
if [[ -f "$CURRENT_THEME_PATH/hyprlock.conf" ]]; then
  mkdir -p "$HOME/.config/hypr"
  cp "$CURRENT_THEME_PATH/hyprlock.conf" "$HOME/.config/hypr/hyprlock-theme.conf"
fi

# niri — write theme.kdl + reassemble config.kdl. niri's config file
# watcher OR a manual `niri msg action reload-config` picks up the change
# without restarting the compositor. deploy-niri-config handles both.
if [[ -f "$CURRENT_THEME_PATH/niri-theme.kdl" ]]; then
  mkdir -p "$HOME/.config/niri"
  cp "$CURRENT_THEME_PATH/niri-theme.kdl" "$HOME/.config/niri/theme.kdl"
  command -v deploy-niri-config &>/dev/null && deploy-niri-config 2>/dev/null || true
fi

# Dunst: compose dunstrc.base + theme colors into dunstrc (the path
# dunst actually reads; -config flag is not used). dunstrc.base holds
# the pristine core settings; if it doesn't exist yet (older install),
# adopt the current dunstrc as the base before composing.
if [[ -f "$CURRENT_THEME_PATH/dunstrc.theme" ]]; then
  mkdir -p "$HOME/.config/dunst"
  if [[ ! -f "$HOME/.config/dunst/dunstrc.base" ]]; then
    if [[ -f "$HOME/.config/dunst/dunstrc" ]]; then
      # Strip any previously-appended theme block before seeding the base
      # (the "auto-generated" marker is emitted by dunstrc.theme.tpl).
      sed '/^# dunst theme colors -- auto-generated/,$d' \
        "$HOME/.config/dunst/dunstrc" > "$HOME/.config/dunst/dunstrc.base"
    elif [[ -f /usr/share/smplos/configs/dunst/dunstrc ]]; then
      cp /usr/share/smplos/configs/dunst/dunstrc "$HOME/.config/dunst/dunstrc.base"
    fi
  fi
  if [[ -f "$HOME/.config/dunst/dunstrc.base" ]]; then
    cat "$HOME/.config/dunst/dunstrc.base" "$CURRENT_THEME_PATH/dunstrc.theme" \
      > "$HOME/.config/dunst/dunstrc.tmp"
    mv -f "$HOME/.config/dunst/dunstrc.tmp" "$HOME/.config/dunst/dunstrc"
  else
    cp "$CURRENT_THEME_PATH/dunstrc.theme" "$HOME/.config/dunst/dunstrc"
  fi
  # Stale path written by older theme-set versions — never read by dunst.
  rm -f "$HOME/.config/dunst/dunstrc.active"
fi

# Link rofi theme (single file used by launcher + all dialogs)
mkdir -p "$HOME/.config/rofi"
if [[ -f "$CURRENT_THEME_PATH/smplos-launcher.rasi" ]]; then
  cp "$CURRENT_THEME_PATH/smplos-launcher.rasi" "$HOME/.config/rofi/smplos-launcher.rasi"
fi

# st (suckless terminal) -- colors applied at runtime via OSC escape sequences
# No config file copy needed; theme-set-st reads colors.toml directly

# micro text editor — deploy colorscheme (reloads on next file open)
if [[ -f "$CURRENT_THEME_PATH/micro.theme" ]]; then
  mkdir -p "$HOME/.config/micro/colorschemes"
  cp "$CURRENT_THEME_PATH/micro.theme" "$HOME/.config/micro/colorschemes/smplos.micro"
fi

# Nemo file manager — deploy per-theme GTK3 CSS override
# nemo-smpl watches ~/.config/smplos/nemo-theme.css via GFileMonitor
# and reloads it live, so no nemo restart is required.
# Use atomic rename so the monitor never sees a truncated file.
if [[ -f "$CURRENT_THEME_PATH/nemo.css" ]]; then
  mkdir -p "$HOME/.config/smplos"
  cp "$CURRENT_THEME_PATH/nemo.css" "$HOME/.config/smplos/nemo-theme.css.tmp" \
    && mv -f "$HOME/.config/smplos/nemo-theme.css.tmp" "$HOME/.config/smplos/nemo-theme.css" \
    || die "Cannot deploy Nemo theme"
fi

# Link fish theme colors
if [[ -f "$CURRENT_THEME_PATH/fish.theme" ]]; then
  mkdir -p "$HOME/.config/fish"
  cp "$CURRENT_THEME_PATH/fish.theme" "$HOME/.config/fish/theme.fish"
fi

# Apply Tide prompt theme (set universal variables so Tide picks them up immediately)
if [[ -f "$CURRENT_THEME_PATH/tide.theme" ]] && command -v fish &>/dev/null; then
  fish -c "source '$CURRENT_THEME_PATH/tide.theme'; tide reload" &>/dev/null || true
fi

# Set wallpaper from theme backgrounds
theme-bg-next || die "Cannot apply theme background"

# =========================================================================
# RESTART COMPONENTS — apply new theme live
# All guarded: only runs if the app is actually present/running
# =========================================================================

# Reload recompiles SCSS without killing the bar or its listeners.
if pgrep -u "$UID" -x eww >/dev/null; then
  bar-ctl reload || die "Cannot reload EWW theme"
fi

# Hyprland (reload config to pick up new border colors -- runtime only)
if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v hyprctl &>/dev/null; then
  hyprctl reload 2>/dev/null
fi

# niri (reload config to pick up new theme.kdl -- runtime only).
# deploy-niri-config above already calls reload when NIRI_SOCKET is set,
# but call it explicitly here as a backup so the order is obvious.
if [[ -n "${NIRI_SOCKET:-}" ]] && command -v niri &>/dev/null; then
  niri msg action reload-config 2>/dev/null || true
fi

# st / st-wl -- apply colors via OSC escape sequences to all running instances
terminal_status=0
theme-set-st || terminal_status=$?

# Double Commander — regenerate colors.json from theme palette
# theme-set-dc removed — DC replaced by Nemo (GTK3, live-reloads via gtk.css)

# Dunst notification daemon
if pgrep -x dunst >/dev/null; then
  dunstctl reload 2>/dev/null
fi

# =========================================================================
# APP-SPECIFIC THEMES — optional integrations
# =========================================================================

# Standard GTK light/dark preference; palette changes never select an icon pack.
if [[ -f "$CURRENT_THEME_PATH/light.mode" ]]; then
  _gtk_mode=--light
else
  _gtk_mode=--dark
fi
_gtk_helper="$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/smplos-gtk.py"
[[ -r "$_gtk_helper" ]] || _gtk_helper="/usr/local/lib/smplos/smplos-gtk.py"
python3 "$_gtk_helper" "$_gtk_mode" || die "Cannot apply standard GTK preferences"

# Clear old session overrides. Empty GTK_THEME is equivalent to unset in GTK3/4;
# the D-Bus activation environment has no unset operation.
case "${GTK_THEME:-}" in
  ""|Adwaita|Adwaita:dark|Adwaita-dark)
    unset GTK_THEME
    apply_hyprland_environment
    if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
      systemctl --user unset-environment GTK_THEME || die "Cannot clear systemd GTK override"
      dbus-update-activation-environment GTK_THEME= || die "Cannot clear D-Bus GTK override"
      systemctl --user try-restart xdg-desktop-portal-gtk || die "Cannot refresh GTK portal"
    fi ;;
esac
fi

if [[ "$THEME_SCOPE" == core ]]; then
  if (( terminal_status != 0 )); then
    die "Theme '$THEME_NAME' applied, but terminal refresh failed; see errors above"
  fi
  echo "Core theme set to: $THEME_NAME"
  exit 0
elif [[ "$THEME_SCOPE" == apps ]]; then
  THEME_NAME=$(cat "$CURRENT_PATH/theme.name") || die "Cannot read the active theme name"
  [[ -s "$CURRENT_THEME_PATH/colors.toml" ]] || die "No active theme for app integration"
  set -eo pipefail
fi

if [[ -f "$CURRENT_THEME_PATH/foot.ini" ]]; then
  mkdir -p "$HOME/.config/foot"
  cp "$CURRENT_THEME_PATH/foot.ini" "$HOME/.config/foot/theme.ini"
fi
if [[ -f "$CURRENT_THEME_PATH/btop.theme" ]]; then
  mkdir -p "$HOME/.config/btop/themes"
  cp "$CURRENT_THEME_PATH/btop.theme" "$HOME/.config/btop/themes/current.theme"
fi
while read -r pid; do
  kill -SIGUSR1 "$pid"
done < <(pgrep -u "$UID" -x foot)
while read -r pid; do
  kill -USR2 "$pid"
done < <(pgrep -u "$UID" -x btop)

# App-theme selectors live in colors.toml so each theme can point to any preset.
# Defaults keep legacy behavior: use this theme's own app presets.
NVM_PRESET="$(toml_get "$CURRENT_THEME_PATH/colors.toml" app_theme_nvim)"
VSCODE_PRESET="$(toml_get "$CURRENT_THEME_PATH/colors.toml" app_theme_vscode)"
NVM_PRESET="${NVM_PRESET:-$THEME_NAME}"
VSCODE_PRESET="${VSCODE_PRESET:-$THEME_NAME}"

# Neovim — deploy lazy.nvim colorscheme spec from selected preset
NVM_THEME_PATH="$(resolve_theme_path "$NVM_PRESET" 2>/dev/null || true)"
if [[ -n "${NVM_THEME_PATH:-}" && -f "$NVM_THEME_PATH/neovim.lua" ]]; then
  mkdir -p "$HOME/.config/nvim/lua/plugins"
  cp "$NVM_THEME_PATH/neovim.lua" "$HOME/.config/nvim/lua/plugins/colorscheme.lua"

  # Live-reload: apply colorscheme to all running Neovim instances via server sockets
  # Neovim 0.9+ auto-creates a socket at $XDG_RUNTIME_DIR/nvim.<pid>.<n>
  _nvim_cs=$(sed -n 's/.*colorscheme[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$NVM_THEME_PATH/neovim.lua" | head -1)
  if [[ -n "$_nvim_cs" ]]; then
    _nvim_rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    for _sock in "$_nvim_rt"/nvim.*; do
      [[ -S "$_sock" ]] || continue
      nvim --server "$_sock" --remote-expr "execute('silent! colorscheme $_nvim_cs')" &>/dev/null &
    done
  fi
fi

# VS Code / Codium / Cursor — set workbench.colorTheme from selected preset
VSCODE_THEME_PATH="$(resolve_theme_path "$VSCODE_PRESET" 2>/dev/null || true)"
if [[ -n "${VSCODE_THEME_PATH:-}" && -f "$VSCODE_THEME_PATH/vscode.json" ]]; then
  # Reload a running editor window via Hyprland + wtype.
  # Only needed right after a *newly* installed theme extension: a running
  # window won't load a CLI-installed extension until it reloads. Switching
  # between already-installed themes applies live via settings.json (no reload).
  # $1 is a case-insensitive regex matched against the window class/app_id.
  _reload_editor_window() {
    local match="$1"
    command -v hyprctl &>/dev/null && command -v wtype &>/dev/null && command -v jq &>/dev/null || return 0
    # Discover the actual running window class (Wayland app_id is lowercase, e.g. "code")
    local wclass
    wclass=$(hyprctl clients -j 2>/dev/null \
      | jq -r --arg m "$match" '.[] | select((.class|ascii_downcase) | test($m)) | .class' | head -1)
    [[ -n "$wclass" ]] || return 0
    hyprctl dispatch focuswindow "class:^${wclass}$" >/dev/null 2>&1 || return 0
    sleep 0.35
    # Command Palette -> "Reload Window" -> Enter
    wtype -M ctrl -M shift -k p -m shift -m ctrl
    sleep 0.2
    wtype -- "Reload Window"
    sleep 0.2
    wtype -k Return
  }

  _set_vscode_theme() {
    local cmd="$1" settings="$2" wclass="$3"
    command -v "$cmd" &>/dev/null || return 0

    local theme_name extension vsix newly_installed=0
    theme_name=$(jq -r '.name' "$VSCODE_THEME_PATH/vscode.json")
    extension=$(jq -r '.extension // empty' "$VSCODE_THEME_PATH/vscode.json")
    vsix=$(jq -r '.vsix // empty' "$VSCODE_THEME_PATH/vscode.json")

    # Install extension: from bundled .vsix or marketplace.
    # Detect whether this run *newly* added an extension (running window needs a reload).
    if [[ -n "$vsix" && -f "$VSCODE_THEME_PATH/$vsix" ]]; then
      local _before _after
      _before=$("$cmd" --list-extensions 2>/dev/null | sort)
      "$cmd" --install-extension "$VSCODE_THEME_PATH/$vsix" --force || return 1
      _after=$("$cmd" --list-extensions 2>/dev/null | sort)
      [[ -n "$(comm -13 <(printf '%s' "$_before") <(printf '%s' "$_after"))" ]] && newly_installed=1
    elif [[ -n "$extension" ]] && ! "$cmd" --list-extensions 2>/dev/null | grep -Fxq "$extension"; then
      "$cmd" --install-extension "$extension" || return 1
      newly_installed=1
    fi

    # Update settings.json (applies live for already-loaded themes)
    mkdir -p "$(dirname "$settings")"
    [[ -f "$settings" ]] || printf '{\n}\n' > "$settings"

    if ! grep -q '"workbench.colorTheme"' "$settings"; then
      sed -i -E '0,/\{/{s/\{/{ "workbench.colorTheme": "",/}' "$settings"
    fi
    sed -i -E "s/(\"workbench.colorTheme\"[[:space:]]*:[[:space:]]*\")[^\"]*(\")/\1$theme_name\2/" "$settings"

    # A freshly installed extension isn't loaded in the running window until it
    # reloads; do it automatically so the new theme actually renders.
    [[ "$newly_installed" -eq 1 ]] && _reload_editor_window "$wclass"
    return 0
  }

  _set_vscode_theme "code"   "$HOME/.config/Code/User/settings.json"     "^code$"
  _set_vscode_theme "codium" "$HOME/.config/VSCodium/User/settings.json" "codium"
  _set_vscode_theme "cursor" "$HOME/.config/Cursor/User/settings.json"   "cursor"
fi

if command -v theme-set-openchamber &>/dev/null; then
  if ! theme-set-openchamber; then
    echo "theme-set: OpenChamber theme sync failed; other theme integrations will continue" >&2
  fi
fi

# Copilot desktop uses its own Settings UI, only with explicit opt-in.
if [[ -f "$HOME/.config/smplos/copilot-theme-sync.enabled" ]]; then
  if ! command -v theme-set-copilot &>/dev/null; then
    echo "theme-set: Copilot sync enabled, but theme-set-copilot is not installed" >&2
  elif ! theme-set-copilot; then
    echo "theme-set: Copilot theme sync failed; other theme integrations will continue" >&2
  fi
fi

# Chromium / Brave -- full theme support
# Generates a Chrome theme extension from colors.toml (no root required).
# Browser toolbar/tab colors apply on next Brave launch.
# --force-dark-mode applies immediately on next Brave start (pages go dark).

_hex_to_rgb_array() {
  # Convert #rrggbb to "r, g, b" for Chrome theme manifest JSON
  local hex="${1#\#}"
  printf "%d, %d, %d" "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
}

_toml_color() {
  toml_get "$CURRENT_THEME_PATH/colors.toml" "$1"
}

_bg=$(      _toml_color background)
_bg_light=$(  _toml_color bg_light)
_surface=$(   _toml_color surface)
_fg=$(        _toml_color foreground)
_fg_alt=$(    _toml_color fg_alt)
_accent=$(    _toml_color accent)
_muted=$(     _toml_color muted)

if [[ -n "$_bg" ]]; then
  # ── Dark/light mode ────────────────────────────────────────────────────────
  if [[ -f "$CURRENT_THEME_PATH/light.mode" ]]; then
    DARK_MODE=false
  else
    DARK_MODE=true
  fi

  # ── Chrome theme extension manifest ───────────────────────────────────────
  # Loaded via --load-extension in brave-flags.conf.
  # Toolbar and tab colors apply on next Brave launch (extensions read at startup).
  # No root required. No compiling. No Chrome Web Store.
  BRAVE_THEME_DIR="$HOME/.config/smplos/brave-theme"
  mkdir -p "$BRAVE_THEME_DIR"

  _rgb_bg=$(      _hex_to_rgb_array "$_bg")
  _rgb_bg_light=$(  _hex_to_rgb_array "${_bg_light:-$_bg}")
  _rgb_surface=$(   _hex_to_rgb_array "${_surface:-$_bg_light}")
  _rgb_fg=$(        _hex_to_rgb_array "${_fg:-#e0e0e0}")
  _rgb_fg_alt=$(    _hex_to_rgb_array "${_fg_alt:-#888888}")
  _rgb_accent=$(    _hex_to_rgb_array "${_accent:-#7aa2f7}")
  _rgb_muted=$(     _hex_to_rgb_array "${_muted:-#444444}")

  cat > "$BRAVE_THEME_DIR/manifest.json" << EOJSON
{
  "manifest_version": 2,
  "name": "smplOS ${THEME_NAME}",
  "version": "1.0",
  "theme": {
    "colors": {
      "frame":                  [${_rgb_bg}],
      "frame_inactive":         [${_rgb_bg_light}],
      "frame_incognito":        [${_rgb_bg}],
      "toolbar":                [${_rgb_surface}],
      "tab_text":               [${_rgb_fg}],
      "tab_background_text":    [${_rgb_fg_alt}],
      "bookmark_text":          [${_rgb_fg}],
      "ntp_background":         [${_rgb_bg}],
      "ntp_text":               [${_rgb_fg}],
      "ntp_link":               [${_rgb_accent}],
      "omnibox_background":     [${_rgb_bg_light}],
      "omnibox_text":           [${_rgb_fg}],
      "button_background":      [${_rgb_surface}],
      "control_background":     [${_rgb_bg_light}]
    },
    "tints": {
      "background_tab": [0.0, 0.0, 0.45],
      "buttons": [-1, -1, -1]
    }
  }
}
EOJSON

  # ── Brave/Chromium flags ───────────────────────────────────────────────────
  # brave-flags.conf is read by the Brave launcher on every start.
  _set_browser_flags() {
    local flags_file="$1"
    local ext_path="$BRAVE_THEME_DIR"
    mkdir -p "$(dirname "$flags_file")"
    touch "$flags_file"

    # Remove previously managed flags (dark mode + our extension load)
    sed -i \
      -e '/^--force-dark-mode$/d' \
      -e '/^--enable-features=.*WebUIDarkMode/d' \
      -e '/^--load-extension=.*smplos\/brave-theme/d' \
      "$flags_file"

    # Dark mode flags (controls browser chrome + forces sites dark)
    if $DARK_MODE; then
      echo "--force-dark-mode" >> "$flags_file"
      if grep -q '^--enable-features=' "$flags_file"; then
        sed -i 's/^--enable-features=\(.*\)/--enable-features=\1,WebUIDarkMode/' "$flags_file"
      else
        echo "--enable-features=WebUIDarkMode" >> "$flags_file"
      fi
    fi

    # Load our theme extension (applies toolbar/tab colors on next Brave start)
    echo "--load-extension=${ext_path}" >> "$flags_file"

    # Clean up blank lines
    sed -i '/^[[:space:]]*$/d' "$flags_file"
  }
  _set_browser_flags "$HOME/.config/brave-flags.conf"
  _set_browser_flags "$HOME/.config/chromium-flags.conf"

  # ── Managed policy (only if root — e.g. dev-apply.sh) ─────────────────────
  # BrowserThemeColor hints the native window title bar on some Linux WMs.
  if [[ $EUID -eq 0 ]]; then
    for browser in chromium brave; do
      command -v "$browser" &>/dev/null || continue
      mkdir -p "/etc/$browser/policies/managed" 2>/dev/null
      printf '{"BrowserThemeColor":"%s","BackgroundModeEnabled":false}\n' "$_bg" \
        > "/etc/$browser/policies/managed/color.json" 2>/dev/null
    done
  fi
fi

if (( ${terminal_status:-0} != 0 )); then
  die "Theme '$THEME_NAME' applied, but terminal refresh failed; see errors above"
fi
echo "Theme set to: $THEME_NAME"

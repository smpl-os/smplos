# smplOS Fish Theme Colors
# Auto-generated by theme system -- do not edit manually

# Syntax highlighting
set -g fish_color_normal ffffff
set -g fish_color_command ff8a30
set -g fish_color_keyword ffffff
set -g fish_color_quote ffffff
set -g fish_color_redirection d6d6d6
set -g fish_color_end ffffff
set -g fish_color_error ff8a30
set -g fish_color_param ffffff
set -g fish_color_comment 999999
set -g fish_color_selection --background=101010
set -g fish_color_operator d6d6d6
set -g fish_color_escape ffffff
set -g fish_color_autosuggestion 999999
set -g fish_color_search_match ff8a30 --background=080808
set -g fish_color_valid_path --underline

# Pager (tab completion menu)
set -g fish_pager_color_progress 999999
set -g fish_pager_color_prefix ff8a30 --bold --underline
set -g fish_pager_color_completion ffffff
set -g fish_pager_color_description 999999
set -g fish_pager_color_selected_background --background=080808
set -g fish_pager_color_selected_completion ffffff
set -g fish_pager_color_selected_prefix ff8a30 --bold --underline
set -g fish_pager_color_selected_description 999999

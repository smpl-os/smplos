# smplOS Fish Theme Colors
# Auto-generated by theme system -- do not edit manually

# Syntax highlighting
set -g fish_color_normal 00ff00
set -g fish_color_command 55ffaa
set -g fish_color_keyword ffbb33
set -g fish_color_quote 66ff66
set -g fish_color_redirection 77ffcc
set -g fish_color_end ffee66
set -g fish_color_error ffcc33
set -g fish_color_param 00ff00
set -g fish_color_comment 55bb55
set -g fish_color_selection --background=000000
set -g fish_color_operator 77ffcc
set -g fish_color_escape ffbb33
set -g fish_color_autosuggestion 4ddd4d
set -g fish_color_search_match 55ffaa --background=0D1A0D
set -g fish_color_valid_path --underline

# Pager (tab completion menu)
set -g fish_pager_color_progress 55bb55
set -g fish_pager_color_prefix 55ffaa --bold --underline
set -g fish_pager_color_completion 00ff00
set -g fish_pager_color_description 55bb55
set -g fish_pager_color_selected_background --background=0D1A0D
set -g fish_pager_color_selected_completion 00ff00
set -g fish_pager_color_selected_prefix 55ffaa --bold --underline
set -g fish_pager_color_selected_description 55bb55

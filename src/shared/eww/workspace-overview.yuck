;; Stable-workspace trial. The controller owns IDs, homes and monitor geometry.
(deflisten workspace-state
  :initial '{"enabled":false,"error":"","assignment":"preserve","focused_monitor":"","focused_label":"","current":[],"monitors":[],"disconnected":[],"map_width":560,"map_height":260}'
  `workspace-ctl watch`)

(defwidget workspace-chip [ws ?square]
  (box :class "workspace-chip ${square == true ? 'workspace-square' : ''} ${ws.focused ? 'is-focused' : ws.visible ? 'is-visible' : 'is-neutral'} ${ws.temporary ? 'is-temporary' : ''}"
       :orientation "v" :space-evenly false :spacing 1
       :tooltip {ws.tooltip}
    (label :class "workspace-number" :visible {square != true} :text {ws.id})
    (box :class "workspace-occupied ${ws.occupied ? 'has-windows' : ''}"
         :halign "center" :valign "end")))

;; Only the monitor label opens the overview; chips switch workspaces directly.
(defwidget workspace-trial-bar []
  (box :class "workspace-trial-bar" :orientation "h" :space-evenly false :spacing ws-spacing
    (button :class "workspace-overview-toggle"
            :onclick "popup-toggle workspace-overview"
            :timeout "3s"
            :tooltip {workspace-state.error != "" ? workspace-state.error : "Monitor layout and workspace selection"}
      (box :orientation "h" :space-evenly false :spacing 3
        (label :class "workspace-monitor-label"
               :text {workspace-state.focused_label != "" ? workspace-state.focused_label : "WS"})
        (label :class "workspace-bar-error" :text "!"
               :visible {workspace-state.error != ""} :tooltip {workspace-state.error})))
    (box :visible {ws-style == "numbers"} :orientation "h" :space-evenly false :spacing ws-spacing
      (for ws in {workspace-state.current}
        (workspace-bar-choice :ws ws :square false)))
    (box :visible {ws-style == "squares"} :orientation "v" :space-evenly false :valign "center" :spacing ws-spacing
      (box :orientation "h" :space-evenly false :halign "start" :spacing ws-spacing
        (for ws in {jq(workspace-state.current, ".[0:${ceil(arraylength(workspace-state.current) / 2)}]")}
          (workspace-bar-choice :ws ws :square true)))
      (box :visible {arraylength(workspace-state.current) > 1}
           :orientation "h" :space-evenly false :halign "start" :spacing ws-spacing
        (for ws in {jq(workspace-state.current, ".[${ceil(arraylength(workspace-state.current) / 2)}:]")}
          (workspace-bar-choice :ws ws :square true))))))

(defwidget workspace-bar-choice [ws square]
  (button :class "workspace-bar-choice"
          :timeout "3s"
          :tooltip {ws.tooltip}
          :onclick "workspace-ctl select ${ws.id}"
    (workspace-chip :ws ws :square square)))

(defwidget workspace-choice [ws]
  (button :class "workspace-choice"
          :timeout "3s"
          :onclick "eww --config \"$HOME/.config/eww\" close workspace-overview && workspace-ctl select ${ws.id}"
    (workspace-chip :ws ws)))

;; Overlay children are display-only in EWW. Interactive choices are below.
;; Parent-provided map geometry is origin-normalized and rotation-aware.
(defwidget workspace-map-monitor [number focused current x y w h]
  (box :halign "start" :valign "start"
       :style "margin-left: ${x}px; margin-top: ${y}px;"
    (box :class "workspace-map-monitor ${focused ? 'is-focused' : ''}"
         :width {floor(w)} :height {floor(h)}
         :orientation "v" :space-evenly false :valign "start"
      (box :orientation "v" :space-evenly false :valign "center" :vexpand true
        (label :text "M${number}" :truncate true)
        (label :text "WS ${current}" :truncate true)))))

(defwidget workspace-monitor-row [monitor]
  (box :class "workspace-monitor-row" :orientation "v" :space-evenly false :spacing 6
    (button :class "workspace-monitor-heading ${monitor.focused ? 'is-focused' : ''}"
            :tooltip {monitor.tooltip}
            :timeout "3s"
            :onclick "eww --config \"$HOME/.config/eww\" close workspace-overview && workspace-ctl focus-monitor ${monitor.id}"
      (box :orientation "h" :space-evenly false :spacing 8
        (label :class "workspace-monitor-label" :text {monitor.label})
        (label :text {monitor.connector} :truncate true :hexpand true :xalign 0)
        (label :class "workspace-monitor-current"
               :text "${monitor.focused ? 'Focused - ' : ''}WS ${monitor.active_workspace}")))
    (scroll :hscroll true :vscroll false :height 40
      (box :orientation "h" :space-evenly false :spacing 5
        (for ws in {monitor.workspaces}
          (workspace-choice :ws ws))))))

(defwidget workspace-overview-layout []
  (box :class "qs-panel workspace-overview-panel"
       :orientation "v" :space-evenly false :spacing 8
    (box :class "qs-header" :orientation "h" :space-evenly false
      (label :class "qs-title" :text "Workspaces" :hexpand true :halign "start")
      (label :class "workspace-legend" :visible {workspace-state.enabled}
             :text "${arraylength(workspace-state.monitors)} monitors")
      (button :class "qs-close" :tooltip "Close overview"
              :onclick "popup-toggle --close" "x"))
    (label :class "workspace-overview-error"
           :visible {workspace-state.error != ""}
           :text {workspace-state.error} :wrap true :limit-width 66 :xalign 0)
    (label :visible {!workspace-state.enabled}
           :text "Stable workspaces are disabled." :xalign 0)
    (box :visible {workspace-state.enabled}
         :orientation "v" :space-evenly false :spacing 10
      ;; EWW overlay cannot contain `for`. Generate numeric/boolean attributes
      ;; only, not connector/tooltip text. Snapshot values avoid stale reactive
      ;; literal scopes when a monitor is unplugged.
      (literal :class "workspace-monitor-map" :halign "center"
        :content {jq(workspace-state, '"(overlay (box :width \\(.map_width | floor) :height \\(.map_height | floor)) " + (.monitors | map("(workspace-map-monitor :number \\(.label | ltrimstr("M") | tonumber) :focused \\(.focused) :current \\(.active_workspace) :x \\(.map_x) :y \\(.map_y) :w \\(.map_width) :h \\(.map_height))") | join(" ")) + ")"', "r")})
      (label :class "workspace-legend"
             :text "Filled: focused   Outline: visible   Dot: occupied" :xalign 0)
      (label :class "workspace-overview-hint"
             :text "Choose a monitor or workspace below. Dashed edge: temporary home." :xalign 0)
      (label :class "workspace-overview-hint" :wrap true :limit-width 66 :xalign 0
             :text {jq(workspace-state, '.assignment // "preserve"', 'r') == "spatial-round-robin"
               ? "Auto: left to right; vertically aligned monitors run top to bottom. Workspace numbers wrap."
               : "Saved homes: monitor layout changes do not reassign workspace numbers."})
      (scroll :height 200 :hscroll false :vscroll true
        (box :orientation "v" :space-evenly false :spacing 10
          (for monitor in {workspace-state.monitors}
            (workspace-monitor-row :monitor monitor))
          (box :visible {arraylength(workspace-state.disconnected) > 0}
               :class "workspace-disconnected" :orientation "v" :space-evenly false :spacing 4
            (label :text "Disconnected homes (workspaces available above)" :xalign 0)
            (for monitor in {workspace-state.disconnected}
              (label :text "${monitor.label}: ${jq(monitor.workspace_ids, 'map(tostring) | join(\", \")', 'r')}"
                     :xalign 0 :wrap true :limit-width 64))))))))

;; Window properties need a snapshot argument (provided by popup-toggle).
;; Only a confirmed scoped handler may take exclusive keyboard focus.
(defwindow workspace-overview [overview-state]
  :monitor 0
  :namespace "eww-workspace-overview"
  :geometry (geometry :x "0px" :y "38px" :width "608px" :height "10px" :anchor "bottom center")
  :stacking "overlay"
  :focusable {jq(overview-state, '.escape_available // false') == true && get_env("HYPRLAND_INSTANCE_SIGNATURE") != "" && get_env("WAYLAND_DISPLAY") != "" && get_env("NIRI_SOCKET") == "" ? "true" : "ondemand"}
  (workspace-overview-layout))

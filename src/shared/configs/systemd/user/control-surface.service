[Unit]
Description=Macro keypad app (control-surface) for CH552 keypads
Documentation=https://github.com/smpl-os/smplos/blob/main/KEYPAD.md
# Runs only while a keypad is plugged in. The keypad's udev rule starts it
# (SYSTEMD_USER_WANTS); BindsTo= + After= on the keypad's device unit stop it
# when the keypad is unplugged. It is deliberately not enabled for any target,
# so with no keypad nothing keypad related runs. See KEYPAD.md.
BindsTo=smplos-keypad.device
After=smplos-keypad.device graphical-session.target
ConditionPathExists=/usr/bin/control-surfaced

[Service]
Type=simple
# --eww-*: the app pushes its cheatsheet into the bar's EWW (pad_sheet,
# pad-cheatsheet) itself, only while it runs; no listener process.
ExecStart=/usr/bin/control-surfaced run --quiet --eww-window pad-cheatsheet --eww-config %h/.config/eww
# The bar icon is an EWW variable, set here instead of by a watcher process.
# "-": no bar running yet is fine; keypad-bar-sync.sh sets it when the bar opens.
ExecStartPost=-/usr/bin/eww --config %h/.config/eww update keypad-present=yes
ExecStopPost=-/usr/bin/eww --config %h/.config/eww update keypad-present=no
Restart=on-failure
RestartSec=2
